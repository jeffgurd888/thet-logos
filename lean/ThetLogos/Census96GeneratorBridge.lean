open Matrix

namespace ThetLogos

/-! ## Section 1. The double commutator and its calculus -/

/-- The order-one double commutator expression `[[D, A], B]`, in the
    exact form used by `OrderOneHolds` / `OrderOneHolds3`. Tier T2. -/
def dcGen (D A B : Matrix I32 I32 ℂ) : Matrix I32 I32 ℂ :=
  (D * A - A * D) * B - B * (D * A - A * D)

/-- `dcGen` unfolds to the predicate's expression. -/
theorem dcGen_apply (D A B : Matrix I32 I32 ℂ) :
    dcGen D A B = (D * A - A * D) * B - B * (D * A - A * D) := rfl

/-- The inner commutator is a derivation in its second argument
    (pure ring identity, no commutation hypothesis). -/
theorem commutator_mul (D X Y : Matrix I32 I32 ℂ) :
    D * (X * Y) - (X * Y) * D
      = (D * X - X * D) * Y + X * (D * Y - Y * D) := by
  noncomm_ring

/-- `dcGen` is additive in the left argument. -/
theorem dcGen_add_left (D A1 A2 B : Matrix I32 I32 ℂ) :
    dcGen D (A1 + A2) B = dcGen D A1 B + dcGen D A2 B := by
  unfold dcGen
  noncomm_ring

/-- `dcGen` is additive in the right argument. -/
theorem dcGen_add_right (D A B1 B2 : Matrix I32 I32 ℂ) :
    dcGen D A (B1 + B2) = dcGen D A B1 + dcGen D A B2 := by
  unfold dcGen
  noncomm_ring

/-- `dcGen` is C-homogeneous in the left argument. -/
theorem dcGen_smul_left (c : ℂ) (D A B : Matrix I32 I32 ℂ) :
    dcGen D (c • A) B = c • dcGen D A B := by
  unfold dcGen
  rw [Matrix.mul_smul, Matrix.smul_mul, ← smul_sub, Matrix.smul_mul,
    Matrix.mul_smul, ← smul_sub]

/-- `dcGen` is C-homogeneous in the right argument. -/
theorem dcGen_smul_right (c : ℂ) (D A B : Matrix I32 I32 ℂ) :
    dcGen D A (c • B) = c • dcGen D A B := by
  unfold dcGen
  rw [Matrix.smul_mul, Matrix.mul_smul, ← smul_sub]

/-- `dcGen` vanishes when the left argument is `0`. -/
theorem dcGen_zero_left (D B : Matrix I32 I32 ℂ) : dcGen D 0 B = 0 := by
  simp [dcGen]

/-- `dcGen` vanishes when the right argument is `0`. -/
theorem dcGen_zero_right (D A : Matrix I32 I32 ℂ) : dcGen D A 0 = 0 := by
  simp [dcGen]

/-- **Leibniz expansion in the left slot.** If both factors commute
    with the opposite argument `B`, then
    `[[D, X * Y], B] = [[D, X], B] * Y + X * [[D, Y], B]`.
    This is the step that consumes the order-zero hypothesis (in the
    application, both commutations come from `smGen_order_zero`
    extended to the generated algebra). -/
theorem dcGen_mul_left (D X Y B : Matrix I32 I32 ℂ)
    (hX : X * B = B * X) (hY : Y * B = B * Y) :
    dcGen D (X * Y) B = dcGen D X B * Y + X * dcGen D Y B := by
  have key1 : ∀ P : Matrix I32 I32 ℂ,
      (P * Y) * B - B * (P * Y) = (P * B - B * P) * Y := by
    intro P
    rw [Matrix.mul_assoc P Y B, hY, ← Matrix.mul_assoc P B Y,
      ← Matrix.mul_assoc B P Y, Matrix.sub_mul]
  have key2 : ∀ Q : Matrix I32 I32 ℂ,
      (X * Q) * B - B * (X * Q) = X * (Q * B - B * Q) := by
    intro Q
    rw [Matrix.mul_sub, Matrix.mul_assoc X Q B, ← Matrix.mul_assoc B X Q,
      ← hX, ← Matrix.mul_assoc X B Q]
  have hInner := commutator_mul D X Y
  rw [dcGen_apply, hInner]
  have regroup : ((D * X - X * D) * Y + X * (D * Y - Y * D)) * B
        - B * ((D * X - X * D) * Y + X * (D * Y - Y * D))
      = ((D * X - X * D) * Y * B - B * ((D * X - X * D) * Y))
        + (X * (D * Y - Y * D) * B - B * (X * (D * Y - Y * D))) := by
    noncomm_ring
  rw [regroup, key1, key2]
  exact rfl

/-- **Leibniz expansion in the right slot** (unconditional):
    `[[D, A], Y * Z] = [[D, A], Y] * Z + Y * [[D, A], Z]`. -/
theorem dcGen_mul_right (D A Y Z : Matrix I32 I32 ℂ) :
    dcGen D A (Y * Z) = dcGen D A Y * Z + Y * dcGen D A Z := by
  unfold dcGen
  noncomm_ring

end ThetLogos

namespace ThetLogos

/-! ## Section 2. The generated algebras and the commutant extension -/

/-- The complex algebra generated by the 12 repaired generators
    `smGen` inside `M32(C)`. Tier T2. -/
abbrev smGenAlgebra : Subalgebra ℂ (Matrix I32 I32 ℂ) :=
  Algebra.adjoin ℂ (Set.range smGen)

/-- The complex algebra generated by the 12 opposite generators
    `smGenOp`. Tier T2. -/
abbrev smGenOpAlgebra : Subalgebra ℂ (Matrix I32 I32 ℂ) :=
  Algebra.adjoin ℂ (Set.range smGenOp)

/-- Every generator lies in the generated algebra. -/
theorem smGen_mem_adjoin (g : Fin 12) : smGen g ∈ smGenAlgebra :=
  Algebra.subset_adjoin (Set.mem_range_self g)

/-- Every opposite generator lies in the generated opposite algebra. -/
theorem smGenOp_mem_adjoin (g : Fin 12) : smGenOp g ∈ smGenOpAlgebra :=
  Algebra.subset_adjoin (Set.mem_range_self g)

/-- Order-zero against one generator, extended over the whole
    generated opposite algebra: a generator commutes with every
    element of `smGenOpAlgebra`. From `smGen_order_zero` by adjoin
    induction (the commutant of a fixed matrix is a subalgebra). -/
theorem commute_smGen_adjoinOp (g1 : Fin 12) (y : Matrix I32 I32 ℂ)
    (hy : y ∈ smGenOpAlgebra) : smGen g1 * y = y * smGen g1 := by
  induction hy using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨g2, rfl⟩ := hy
      exact sub_eq_zero.mp (smGen_order_zero g1 g2)
  | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.smul_mul,
        Matrix.one_mul, Matrix.mul_one]
  | add y1 y2 _ _ ih1 ih2 =>
      rw [Matrix.mul_add, Matrix.add_mul, ih1, ih2]
  | mul y1 y2 _ _ ih1 ih2 =>
      calc smGen g1 * (y1 * y2) = (smGen g1 * y1) * y2 := (Matrix.mul_assoc _ _ _).symm
        _ = (y1 * smGen g1) * y2 := by rw [ih1]
        _ = y1 * (smGen g1 * y2) := Matrix.mul_assoc _ _ _
        _ = y1 * (y2 * smGen g1) := by rw [ih2]
        _ = (y1 * y2) * smGen g1 := (Matrix.mul_assoc _ _ _).symm

/-- **Order-zero on the generated algebras**: every element of the
    algebra generated by the 12 generators commutes with every
    element of the algebra generated by the 12 opposite generators.
    The extension of the owned `smGen_order_zero` from generators to
    the generated algebras. -/
theorem commute_adjoin_adjoinOp (x y : Matrix I32 I32 ℂ)
    (hx : x ∈ smGenAlgebra) (hy : y ∈ smGenOpAlgebra) : x * y = y * x := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨g1, rfl⟩ := hx
      exact commute_smGen_adjoinOp g1 y hy
  | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.smul_mul,
        Matrix.one_mul, Matrix.mul_one]
  | add x1 x2 _ _ ih1 ih2 =>
      rw [Matrix.add_mul, Matrix.mul_add, ih1, ih2]
  | mul x1 x2 _ _ ih1 ih2 =>
      calc (x1 * x2) * y = x1 * (x2 * y) := Matrix.mul_assoc _ _ _
        _ = x1 * (y * x2) := by rw [ih2]
        _ = (x1 * y) * x2 := (Matrix.mul_assoc _ _ _).symm
        _ = (y * x1) * x2 := by rw [ih1]
        _ = y * (x1 * x2) := Matrix.mul_assoc _ _ _

/-! ## Section 3. The bridge theorem -/

/-- Stage 1 of the bridge: order-one on the generators extends over
    the generated algebra in the left slot, against a fixed opposite
    generator. The product case is `dcGen_mul_left`, fed by the
    order-zero extension `commute_adjoin_adjoinOp`. -/
theorem dcGen_adjoin_genOp (D : Matrix I32 I32 ℂ) (hD : OrderOneHolds D)
    (g2 : Fin 12) (x : Matrix I32 I32 ℂ) (hx : x ∈ smGenAlgebra) :
    dcGen D x (smGenOp g2) = 0 := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨g1, rfl⟩ := hx
      exact hD g1 g2
  | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, dcGen_apply, Matrix.mul_smul,
        Matrix.smul_mul, Matrix.mul_one, Matrix.one_mul, sub_self]
      simp
  | add x1 x2 hx1 hx2 ih1 ih2 =>
      rw [dcGen_add_left, ih1, ih2, add_zero]
  | mul x1 x2 hx1 hx2 ih1 ih2 =>
      have hX : x1 * smGenOp g2 = smGenOp g2 * x1 :=
        commute_adjoin_adjoinOp x1 (smGenOp g2) hx1 (smGenOp_mem_adjoin g2)
      have hY : x2 * smGenOp g2 = smGenOp g2 * x2 :=
        commute_adjoin_adjoinOp x2 (smGenOp g2) hx2 (smGenOp_mem_adjoin g2)
      rw [dcGen_mul_left D x1 x2 (smGenOp g2) hX hY, ih1, ih2,
        Matrix.zero_mul, Matrix.mul_zero, add_zero]

/-- Stage 2 of the bridge: extension over the generated opposite
    algebra in the right slot, via the unconditional Leibniz rule
    `dcGen_mul_right`. -/
theorem dcGen_adjoin_adjoinOp (D : Matrix I32 I32 ℂ) (hD : OrderOneHolds D)
    (x : Matrix I32 I32 ℂ) (hx : x ∈ smGenAlgebra)
    (y : Matrix I32 I32 ℂ) (hy : y ∈ smGenOpAlgebra) :
    dcGen D x y = 0 := by
  induction hy using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨g2, rfl⟩ := hy
      exact dcGen_adjoin_genOp D hD g2 x hx
  | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, dcGen_apply, Matrix.mul_smul,
        Matrix.smul_mul, Matrix.mul_one, Matrix.one_mul, sub_self]
  | add y1 y2 _ _ ih1 ih2 =>
      rw [dcGen_add_right, ih1, ih2, add_zero]
  | mul y1 y2 _ _ ih1 ih2 =>
      rw [dcGen_mul_right, ih1, ih2, Matrix.zero_mul, Matrix.mul_zero,
        add_zero]

/-- **THE BRIDGE (C96-1b headline).** Order-one on the 12 repaired
    generators (the pin's 144-pair predicate `OrderOneHolds`), together
    with the owned order-zero facts, implies order-one on the whole
    generated algebra: `[[D, X], Y] = 0` for every `X` in
    `smGenAlgebra` and every `Y` in `smGenOpAlgebra`. -/
theorem orderOne_adjoin (D : Matrix I32 I32 ℂ) (hD : OrderOneHolds D)
    (x : Matrix I32 I32 ℂ) (hx : x ∈ smGenAlgebra)
    (y : Matrix I32 I32 ℂ) (hy : y ∈ smGenOpAlgebra) :
    dcGen D x y = 0 :=
  dcGen_adjoin_adjoinOp D hD x hx y hy

/-- The bridge at 96, blockwise: if `OrderOneHolds3 D` holds, then
    every generation block of `D` satisfies order-one over the whole
    generated algebra (via C96-1's `orderOneHolds3_iff_blocks`). -/
theorem orderOneHolds3_adjoin_blocks (D : Matrix I96 I96 ℂ)
    (hD : OrderOneHolds₃ D) (g gp : Fin 3)
    (x : Matrix I32 I32 ℂ) (hx : x ∈ smGenAlgebra)
    (y : Matrix I32 I32 ℂ) (hy : y ∈ smGenOpAlgebra) :
    dcGen (genBlock D g gp) x y = 0 :=
  dcGen_adjoin_adjoinOp _ ((orderOneHolds₃_iff_blocks D).mp hD g gp) x hx y hy

end ThetLogos

namespace ThetLogos

/-! ## Section 4. The 576-pair scan family (the Python census's 24) -/

/-- The C-support projector, written as a generator polynomial:
    `-(genC * genC)` (its diagonal is the C-support indicator, by the
    landed `genC_sq_proj`). Tier T2. -/
noncomputable def projC : Matrix I32 I32 ℂ := -(genC * genC)

/-- The H-support projector, written as a generator polynomial:
    `genH 0 * genH 0` (diagonal the H-support indicator, by the landed
    `genH_sq_proj`). Tier T2. -/
noncomputable def projH : Matrix I32 I32 ℂ := genH 0 * genH 0

/-- The M-support projector, written as a generator polynomial:
    `(3/16) . sum_a (genM a * genM a)` (diagonal the M-support
    indicator, by the landed `genM_sq_sum_proj`). Tier T2. -/
noncomputable def projM : Matrix I32 I32 ℂ :=
  (3 / 16 : ℂ) • ∑ a : Fin 8, genM a * genM a

/-- **The Python census's 24 real generators**, in the Python's exact
    order (`generators_24` in `attack4_corrected.py`, commit
    `90a80e7`): C block `[projC, genC]`; H block
    `[projH, i.genH 0, i.genH 1, i.genH 2]`; M3 block
    `[projM, i.projM, genM 0..7, i.genM 0..7]`. These 24 matrices are
    a real basis of the represented `A_F`; their complex span is the
    algebra generated by the 12 `smGen` (Section 5). Tier T2. -/
noncomputable def scanGenAux : Nat → Matrix I32 I32 ℂ
  | 0 => projC
  | 1 => genC
  | 2 => projH
  | 3 => Complex.I • genH 0
  | 4 => Complex.I • genH 1
  | 5 => Complex.I • genH 2
  | 6 => projM
  | 7 => Complex.I • projM
  | 8 => genM 0
  | 9 => genM 1
  | 10 => genM 2
  | 11 => genM 3
  | 12 => genM 4
  | 13 => genM 5
  | 14 => genM 6
  | 15 => genM 7
  | 16 => Complex.I • genM 0
  | 17 => Complex.I • genM 1
  | 18 => Complex.I • genM 2
  | 19 => Complex.I • genM 3
  | 20 => Complex.I • genM 4
  | 21 => Complex.I • genM 5
  | 22 => Complex.I • genM 6
  | 23 => Complex.I • genM 7
  | _ => 0

/-- The scan family as a function on `Fin 24` (via `scanGenAux` on
    the value; Nat-indexed so that literal reduction is definitional). -/
noncomputable def scanGen (m : Fin 24) : Matrix I32 I32 ℂ := scanGenAux m.val

/-- The opposite-side scan matrix: `UJ * M^T * UJ`, the Python's
    `pi_op` - the same formula as `smGenOp`. Tier T2. -/
noncomputable def scanOp (m : Fin 24) : Matrix I32 I32 ℂ :=
  UJ * (scanGen m).transpose * UJ

/-- The opposite-representation map `M |-> UJ * M^T * UJ` as a
    C-linear map. Tier T2. -/
noncomputable def opLin : (Matrix I32 I32 ℂ) →ₗ[ℂ] (Matrix I32 I32 ℂ) where
  toFun := fun M => UJ * M.transpose * UJ
  map_add' := by
    intro M N
    simp [Matrix.transpose_add, Matrix.mul_add, Matrix.add_mul]
  map_smul' := by
    intro c M
    simp [Matrix.transpose_smul, Matrix.mul_smul, Matrix.smul_mul]

/-- `opLin` computes as `UJ * M^T * UJ`. -/
theorem opLin_apply (M : Matrix I32 I32 ℂ) :
    opLin M = UJ * M.transpose * UJ := rfl

/-- `smGenOp` is `opLin` of `smGen`. -/
theorem smGenOp_eq_opLin (g : Fin 12) : smGenOp g = opLin (smGen g) := rfl

/-- `scanOp` is `opLin` of `scanGen`. -/
theorem scanOp_eq_opLin (m : Fin 24) : scanOp m = opLin (scanGen m) := rfl

/-- **The 576-pair scan predicate** (Lean form of the Python census's
    Step-3 condition): all double commutators over the 24 scan
    generators and their opposites vanish. Tier T2. -/
def OrderOneScan (D : Matrix I32 I32 ℂ) : Prop :=
  ∀ m n : Fin 24, dcGen D (scanGen m) (scanOp n) = 0

/-! ## Section 5. The scan family inside the generated algebra -/

/-- `genC` lies in the generated algebra (it is `smGen 0`). -/
theorem genC_mem_adjoin : genC ∈ smGenAlgebra := smGen_mem_adjoin 0

/-- Every `genH k` lies in the generated algebra. -/
theorem genH_mem_adjoin (k : Fin 3) : genH k ∈ smGenAlgebra := by
  obtain ⟨v, hv⟩ := k
  interval_cases v <;> first
    | exact smGen_mem_adjoin 1
    | exact smGen_mem_adjoin 2
    | exact smGen_mem_adjoin 3

/-- Every `genM a` lies in the generated algebra. -/
theorem genM_mem_adjoin (a : Fin 8) : genM a ∈ smGenAlgebra := by
  obtain ⟨v, hv⟩ := a
  interval_cases v <;> first
    | exact smGen_mem_adjoin 4
    | exact smGen_mem_adjoin 5
    | exact smGen_mem_adjoin 6
    | exact smGen_mem_adjoin 7
    | exact smGen_mem_adjoin 8
    | exact smGen_mem_adjoin 9
    | exact smGen_mem_adjoin 10
    | exact smGen_mem_adjoin 11

/-- The C-support projector (a generator polynomial) lies in the
    generated algebra. -/
theorem projC_mem_adjoin : projC ∈ smGenAlgebra :=
  neg_mem (mul_mem genC_mem_adjoin genC_mem_adjoin)

/-- The H-support projector (a generator polynomial) lies in the
    generated algebra. -/
theorem projH_mem_adjoin : projH ∈ smGenAlgebra :=
  mul_mem (genH_mem_adjoin 0) (genH_mem_adjoin 0)

/-- The M-support projector (a generator polynomial) lies in the
    generated algebra. -/
theorem projM_mem_adjoin : projM ∈ smGenAlgebra :=
  smGenAlgebra.smul_mem
    (sum_mem fun a _ => mul_mem (genM_mem_adjoin a) (genM_mem_adjoin a)) _

/-- **Every scan matrix lies in the algebra generated by the 12.**
    The projectors are generator polynomials; the remaining scan
    matrices are generators or complex scalar multiples of them. -/
theorem scanGen_mem_adjoin (m : Fin 24) : scanGen m ∈ smGenAlgebra := by
  obtain ⟨v, hv⟩ := m
  interval_cases v
  · exact projC_mem_adjoin
  · exact genC_mem_adjoin
  · exact projH_mem_adjoin
  · exact smGenAlgebra.smul_mem (genH_mem_adjoin 0) _
  · exact smGenAlgebra.smul_mem (genH_mem_adjoin 1) _
  · exact smGenAlgebra.smul_mem (genH_mem_adjoin 2) _
  · exact projM_mem_adjoin
  · exact smGenAlgebra.smul_mem projM_mem_adjoin _
  · exact genM_mem_adjoin 0
  · exact genM_mem_adjoin 1
  · exact genM_mem_adjoin 2
  · exact genM_mem_adjoin 3
  · exact genM_mem_adjoin 4
  · exact genM_mem_adjoin 5
  · exact genM_mem_adjoin 6
  · exact genM_mem_adjoin 7
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 0) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 1) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 2) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 3) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 4) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 5) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 6) _
  · exact smGenAlgebra.smul_mem (genM_mem_adjoin 7) _

/-- `opLin` is an anti-homomorphism for the product:
    `opLin (X * Y) = opLin Y * opLin X` (transpose reverses order;
    the middle `UJ * UJ` collapses by `UJ_mul_self`). -/
theorem opLin_mul (X Y : Matrix I32 I32 ℂ) :
    opLin (X * Y) = opLin Y * opLin X := by
  rw [opLin_apply, opLin_apply, opLin_apply, Matrix.transpose_mul]
  calc UJ * (Y.transpose * X.transpose) * UJ
      = UJ * Y.transpose * X.transpose * UJ := by
        rw [← Matrix.mul_assoc]
    _ = UJ * Y.transpose * (UJ * UJ) * X.transpose * UJ := by
        rw [UJ_mul_self, Matrix.mul_one]
    _ = (UJ * Y.transpose * UJ) * (UJ * X.transpose * UJ) := by
        simp only [Matrix.mul_assoc]

/-- `opLin` carries the generated algebra into the generated
    opposite algebra. -/
theorem opLin_mem_adjoinOp (X : Matrix I32 I32 ℂ) (hX : X ∈ smGenAlgebra) :
    opLin X ∈ smGenOpAlgebra := by
  induction hX using Algebra.adjoin_induction with
  | mem X hX =>
      obtain ⟨g, rfl⟩ := hX
      exact smGenOp_mem_adjoin g
  | algebraMap r =>
      have h2 : opLin (1 : Matrix I32 I32 ℂ) = 1 := by
        rw [opLin_apply, Matrix.transpose_one, Matrix.mul_one, UJ_mul_self]
      have e : opLin (algebraMap ℂ (Matrix I32 I32 ℂ) r)
          = r • (1 : Matrix I32 I32 ℂ) := by
        rw [Algebra.algebraMap_eq_smul_one, map_smul, h2]
      rw [e]
      exact smGenOpAlgebra.smul_mem (one_mem _) r
  | add X Y _ _ ih1 ih2 =>
      rw [map_add]
      exact add_mem ih1 ih2
  | mul X Y _ _ ih1 ih2 =>
      rw [opLin_mul]
      exact mul_mem ih2 ih1

/-- Every opposite scan matrix lies in the generated opposite
    algebra. -/
theorem scanOp_mem_adjoinOp (n : Fin 24) : scanOp n ∈ smGenOpAlgebra := by
  rw [scanOp_eq_opLin]
  exact opLin_mem_adjoinOp _ (scanGen_mem_adjoin n)

end ThetLogos

namespace ThetLogos

/-! ## Section 6. The generators inside the complex span of the scan -/

/-- `genC` is a scan matrix (`scanGen 1`), hence in their complex span. -/
theorem genC_mem_span_scan :
    genC ∈ Submodule.span ℂ (Set.range scanGen) :=
  Submodule.subset_span ⟨1, rfl⟩

/-- Every `genM a` is a scan matrix, hence in their complex span. -/
theorem genM_mem_span_scan (a : Fin 8) :
    genM a ∈ Submodule.span ℂ (Set.range scanGen) := by
  obtain ⟨v, hv⟩ := a
  interval_cases v
  · exact Submodule.subset_span ⟨8, rfl⟩
  · exact Submodule.subset_span ⟨9, rfl⟩
  · exact Submodule.subset_span ⟨10, rfl⟩
  · exact Submodule.subset_span ⟨11, rfl⟩
  · exact Submodule.subset_span ⟨12, rfl⟩
  · exact Submodule.subset_span ⟨13, rfl⟩
  · exact Submodule.subset_span ⟨14, rfl⟩
  · exact Submodule.subset_span ⟨15, rfl⟩

/-- Every `genH k` is a complex scalar multiple of a scan matrix:
    `genH k = (-i) . scanGen (3 + k)` (the scan carries `i . genH k`). -/
theorem genH_eq_negI_smul_scanGen (k : Fin 3) :
    ∃ m : Fin 24, genH k = (-Complex.I) • scanGen m := by
  obtain ⟨v, hv⟩ := k
  interval_cases v
  · refine ⟨3, ?_⟩
    show genH 0 = (-Complex.I) • (Complex.I • genH 0)
    rw [smul_smul, neg_mul, Complex.I_mul_I, neg_neg, one_smul]
  · refine ⟨4, ?_⟩
    show genH 1 = (-Complex.I) • (Complex.I • genH 1)
    rw [smul_smul, neg_mul, Complex.I_mul_I, neg_neg, one_smul]
  · refine ⟨5, ?_⟩
    show genH 2 = (-Complex.I) • (Complex.I • genH 2)
    rw [smul_smul, neg_mul, Complex.I_mul_I, neg_neg, one_smul]

/-- Every `genH k` lies in the complex span of the scan family. -/
theorem genH_mem_span_scan (k : Fin 3) :
    genH k ∈ Submodule.span ℂ (Set.range scanGen) := by
  obtain ⟨m, hm⟩ := genH_eq_negI_smul_scanGen k
  rw [hm]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨m, rfl⟩)

/-- Every generator `smGen g` lies in the complex span of the scan
    family. -/
theorem smGen_mem_span_scan (g : Fin 12) :
    smGen g ∈ Submodule.span ℂ (Set.range scanGen) := by
  obtain ⟨v, hv⟩ := g
  interval_cases v
  · exact genC_mem_span_scan
  · exact genH_mem_span_scan 0
  · exact genH_mem_span_scan 1
  · exact genH_mem_span_scan 2
  · exact genM_mem_span_scan 0
  · exact genM_mem_span_scan 1
  · exact genM_mem_span_scan 2
  · exact genM_mem_span_scan 3
  · exact genM_mem_span_scan 4
  · exact genM_mem_span_scan 5
  · exact genM_mem_span_scan 6
  · exact genM_mem_span_scan 7

/-- Every opposite generator lies in the complex span of the
    opposite scan family (`opLin` is linear, so it carries spans to
    spans). -/
theorem smGenOp_mem_span_scanOp (g : Fin 12) :
    smGenOp g ∈ Submodule.span ℂ (Set.range scanOp) := by
  have key : ∀ X : Matrix I32 I32 ℂ,
      X ∈ Submodule.span ℂ (Set.range scanGen) →
      opLin X ∈ Submodule.span ℂ (Set.range scanOp) := by
    intro X hX
    induction hX using Submodule.span_induction with
    | mem X hX =>
        obtain ⟨m, rfl⟩ := hX
        rw [← scanOp_eq_opLin]
        exact Submodule.subset_span ⟨m, rfl⟩
    | zero =>
        rw [map_zero]
        exact Submodule.zero_mem _
    | add X Y _ _ ih1 ih2 =>
        rw [map_add]
        exact add_mem ih1 ih2
    | smul c X _ ih =>
        rw [map_smul]
        exact Submodule.smul_mem _ _ ih
  rw [smGenOp_eq_opLin]
  exact key _ (smGen_mem_span_scan g)

/-- Vanishing of `dcGen D` on a pair of generating sets extends to
    their complex spans, by C-bilinearity in each argument. -/
theorem dcGen_eq_zero_of_span (D : Matrix I32 I32 ℂ)
    (S T : Set (Matrix I32 I32 ℂ))
    (h : ∀ A ∈ S, ∀ B ∈ T, dcGen D A B = 0)
    (A : Matrix I32 I32 ℂ) (hA : A ∈ Submodule.span ℂ S)
    (B : Matrix I32 I32 ℂ) (hB : B ∈ Submodule.span ℂ T) :
    dcGen D A B = 0 := by
  induction hB using Submodule.span_induction with
  | mem B hB =>
      induction hA using Submodule.span_induction with
      | mem A hA => exact h A hA B hB
      | zero => exact dcGen_zero_left D B
      | add A1 A2 _ _ ih1 ih2 => rw [dcGen_add_left, ih1, ih2, add_zero]
      | smul c A _ ih => rw [dcGen_smul_left, ih, smul_zero]
  | zero => exact dcGen_zero_right D A
  | add B1 B2 _ _ ih1 ih2 => rw [dcGen_add_right, ih1, ih2, add_zero]
  | smul c B _ ih => rw [dcGen_smul_right, ih, smul_zero]

/-! ## Section 7. The reconciliation: SAME STATEMENT -/

/-- **RECONCILIATION (C96-1b headline): the two censuses are the same
    statement.** The pin's 144-pair predicate `OrderOneHolds` and the
    Python census's 576-pair scan predicate `OrderOneScan` are
    equivalent conditions on `D`. Forward: the bridge
    (`orderOne_adjoin`) applied to the scan matrices, which lie in the
    generated algebras. Backward: C-bilinearity of the double
    commutator, since every generator is in the complex span of the
    scan family (and every opposite generator in the span of the
    opposite scan family). -/
theorem orderOneHolds_iff_orderOneScan (D : Matrix I32 I32 ℂ) :
    OrderOneHolds D ↔ OrderOneScan D := by
  constructor
  · intro h m n
    exact orderOne_adjoin D h _ (scanGen_mem_adjoin m) _ (scanOp_mem_adjoinOp n)
  · intro h g1 g2
    exact dcGen_eq_zero_of_span D (Set.range scanGen) (Set.range scanOp)
      (fun A hA B hB => by
        obtain ⟨m, rfl⟩ := hA
        obtain ⟨n, rfl⟩ := hB
        exact h m n)
      _ (smGen_mem_span_scan g1) _ (smGenOp_mem_span_scanOp g2)

/-- `genC` lies in the algebra generated by the scan family. -/
theorem genC_mem_adjoin_scanGen :
    genC ∈ Algebra.adjoin ℂ (Set.range scanGen) :=
  Algebra.subset_adjoin ⟨1, rfl⟩

/-- Every `genH k` lies in the algebra generated by the scan family
    (a complex scalar multiple of a scan matrix). -/
theorem genH_mem_adjoin_scanGen (k : Fin 3) :
    genH k ∈ Algebra.adjoin ℂ (Set.range scanGen) := by
  obtain ⟨m, hm⟩ := genH_eq_negI_smul_scanGen k
  rw [hm]
  exact (Algebra.adjoin ℂ (Set.range scanGen)).smul_mem
    (Algebra.subset_adjoin ⟨m, rfl⟩) _

/-- Every `genM a` lies in the algebra generated by the scan family. -/
theorem genM_mem_adjoin_scanGen (a : Fin 8) :
    genM a ∈ Algebra.adjoin ℂ (Set.range scanGen) := by
  obtain ⟨v, hv⟩ := a
  interval_cases v
  · exact Algebra.subset_adjoin ⟨8, rfl⟩
  · exact Algebra.subset_adjoin ⟨9, rfl⟩
  · exact Algebra.subset_adjoin ⟨10, rfl⟩
  · exact Algebra.subset_adjoin ⟨11, rfl⟩
  · exact Algebra.subset_adjoin ⟨12, rfl⟩
  · exact Algebra.subset_adjoin ⟨13, rfl⟩
  · exact Algebra.subset_adjoin ⟨14, rfl⟩
  · exact Algebra.subset_adjoin ⟨15, rfl⟩

/-- Every generator lies in the algebra generated by the scan family. -/
theorem smGen_mem_adjoin_scanGen (g : Fin 12) :
    smGen g ∈ Algebra.adjoin ℂ (Set.range scanGen) := by
  obtain ⟨v, hv⟩ := g
  interval_cases v
  · exact genC_mem_adjoin_scanGen
  · exact genH_mem_adjoin_scanGen 0
  · exact genH_mem_adjoin_scanGen 1
  · exact genH_mem_adjoin_scanGen 2
  · exact genM_mem_adjoin_scanGen 0
  · exact genM_mem_adjoin_scanGen 1
  · exact genM_mem_adjoin_scanGen 2
  · exact genM_mem_adjoin_scanGen 3
  · exact genM_mem_adjoin_scanGen 4
  · exact genM_mem_adjoin_scanGen 5
  · exact genM_mem_adjoin_scanGen 6
  · exact genM_mem_adjoin_scanGen 7

/-- **The two families generate the same complex algebra**: the
    algebra generated by the census's 24 scan matrices equals the
    algebra generated by the pin's 12 generators. This is the
    algebra-level content of the SAME STATEMENT reconciliation. -/
theorem adjoin_scanGen_eq_adjoin_smGen :
    Algebra.adjoin ℂ (Set.range scanGen) = smGenAlgebra :=
  le_antisymm
    (Algebra.adjoin_le_iff.mpr fun X hX => by
      obtain ⟨m, rfl⟩ := hX
      exact scanGen_mem_adjoin m)
    (Algebra.adjoin_le_iff.mpr fun X hX => by
      obtain ⟨g, rfl⟩ := hX
      exact smGen_mem_adjoin_scanGen g)

/-- **The named real-form seam.** As REAL spans the two families
    differ: `genH 0` does not lie in the real span of the 24 scan
    matrices - the scan's H block spans the quaternion real form
    `span_R {projH, i.genH k}` inside `M2(C)`, while the generated
    complex algebra also contains `genH k` itself and `i.projH`.
    (Numerical confirmation at scoping: the real-span least-squares
    residual of `genH 0` against the 24 is nonzero, while the complex
    spans coincide, both of complex dimension 14.) The order-one
    condition is C-bilinear, so this real-form difference is
    invisible to it; no real-span identification is claimed anywhere
    in this module. The seam is PROVED below
    (`realFormSeam_proved`), by a real-linear functional that
    vanishes on all 24 scan matrices but not on `genH 0`. -/
def RealFormSeam : Prop :=
  genH 0 ∉ Submodule.span ℝ (Set.range scanGen)

/-- The separating functional for the real-form seam:
    `X |-> Re (X 0 1) + Re (X 1 0)`, a real-linear function of the
    two off-diagonal entries of the first H doublet. It vanishes on
    every scan matrix (the H-sector scan entries at `(0,1)` and
    `(1,0)` are `i . pauli` entries, whose real parts cancel between
    the two positions) and takes the value `2` on `genH 0`. -/
noncomputable def realFormFunctional (X : Matrix I32 I32 ℂ) : ℝ :=
  (X ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
    + (X ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re

/-- The functional is additive. -/
theorem realFormFunctional_add (X Y : Matrix I32 I32 ℂ) :
    realFormFunctional (X + Y) = realFormFunctional X + realFormFunctional Y := by
  simp only [realFormFunctional, Matrix.add_apply, Complex.add_re]
  ring

/-- The functional is real-homogeneous. -/
theorem realFormFunctional_smul_real (c : ℝ) (X : Matrix I32 I32 ℂ) :
    realFormFunctional (c • X) = c * realFormFunctional X := by
  have e : ∀ z : ℂ, (c • z).re = c * z.re := fun z => by simp
  simp only [realFormFunctional, Matrix.smul_apply, e]
  ring

/-- The functional vanishes at `0`. -/
theorem realFormFunctional_zero : realFormFunctional 0 = 0 := by
  simp [realFormFunctional]

/-- The functional takes the value `2` on `genH 0`. -/
theorem realFormFunctional_genH_zero : realFormFunctional (genH 0) = 2 := by
  simp only [realFormFunctional, genH_entry_01, genH_entry_10]
  norm_num [pauli]

/-- The functional vanishes on every scan matrix. The C, M and
    projector entries at `(0, 1)` and `(1, 0)` are zero (disjoint
    supports / off-diagonal vanishing); the `i . genH k` entries have
    cancelling real parts. -/
theorem realFormFunctional_scanGen_eq_zero (m : Fin 24) :
    realFormFunctional (scanGen m) = 0 := by
  obtain ⟨v, hv⟩ := m
  interval_cases v
  · show ((-(genC * genC)) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((-(genC * genC)) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    rw [genC_sq_proj_offdiag (by norm_num), genC_sq_proj_offdiag (by norm_num)]
    simp
  · show (genC ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genC ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    rw [genC_apply_ne (by norm_num), genC_apply_ne (by norm_num)]
    simp
  · show ((genH 0 * genH 0) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((genH 0 * genH 0) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    rw [genH_sq_offdiag 0 (by norm_num), genH_sq_offdiag 0 (by norm_num)]
    simp
  · show ((Complex.I • genH 0) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genH 0) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    rw [Matrix.smul_apply, Matrix.smul_apply, genH_entry_01, genH_entry_10]
    norm_num [pauli, smul_eq_mul]
  · show ((Complex.I • genH 1) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genH 1) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    rw [Matrix.smul_apply, Matrix.smul_apply, genH_entry_01, genH_entry_10]
    norm_num [pauli, smul_eq_mul]
  · show ((Complex.I • genH 2) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genH 2) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    rw [Matrix.smul_apply, Matrix.smul_apply, genH_entry_01, genH_entry_10]
    norm_num [pauli, smul_eq_mul]
  · show ((projM) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((projM) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    unfold projM
    rw [Matrix.smul_apply, genM_sq_sum_offdiag (by norm_num),
      Matrix.smul_apply, genM_sq_sum_offdiag (by norm_num)]
    simp
  · show ((Complex.I • projM) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • projM) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    unfold projM
    rw [Matrix.smul_apply, Matrix.smul_apply, genM_sq_sum_offdiag (by norm_num),
      Matrix.smul_apply, Matrix.smul_apply, genM_sq_sum_offdiag (by norm_num)]
    simp
  · show (genM 0 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 0 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 1 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 1 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 2 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 2 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 3 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 3 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 4 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 4 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 5 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 5 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 6 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 6 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show (genM 7 ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + (genM 7 ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 0) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 0) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 1) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 1) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 2) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 2) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 3) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 3) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 4) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 4) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 5) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 5) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 6) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 6) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]
  · show ((Complex.I • genM 7) ⟨0, by norm_num⟩ ⟨1, by norm_num⟩).re
        + ((Complex.I • genM 7) ⟨1, by norm_num⟩ ⟨0, by norm_num⟩).re = 0
    simp [genM, tripletOf]

/-- **The real-form seam, proved.** `genH 0` is not in the real span
    of the 24 scan matrices: the separating functional
    `realFormFunctional` vanishes on the whole real span but equals
    `2` on `genH 0`. Hence the real spans of the two families differ,
    even though their complex spans (and generated complex algebras)
    coincide - the reconciliation is a complex-algebra statement,
    exactly as the C-bilinear order-one condition requires. -/
theorem realFormSeam_proved : RealFormSeam := by
  show genH 0 ∉ Submodule.span ℝ (Set.range scanGen)
  intro h
  have key : ∀ X : Matrix I32 I32 ℂ,
      X ∈ Submodule.span ℝ (Set.range scanGen) →
      realFormFunctional X = 0 := by
    intro X hX
    induction hX using Submodule.span_induction with
    | mem X hX =>
        obtain ⟨m, rfl⟩ := hX
        exact realFormFunctional_scanGen_eq_zero m
    | zero => exact realFormFunctional_zero
    | add X Y _ _ ih1 ih2 =>
        rw [realFormFunctional_add, ih1, ih2, add_zero]
    | smul c X _ ih =>
        rw [realFormFunctional_smul_real, ih, mul_zero]
  have h2 := key _ h
  rw [realFormFunctional_genH_zero] at h2
  norm_num at h2

end ThetLogos
