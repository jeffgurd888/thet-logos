namespace ThetLogos

open TensorProduct

/-! ## §1. The factor function algebras and the composite algebra

The factor algebra actions: pointwise multiplication. On a complex
factor this is `mulC`; on the R⁴ factor it is the landed `diagOpR`.
The composite algebra is the subalgebra generated by the pure
factorwise actions. -/

/-- **Pointwise multiplication on a realified complex factor**: the
function algebra `Fin n → ℂ` acting on the factor `Fin n → ℂ` by
`(mulC f x) k = f k * x k`, as an ℝ-linear map. This is the factor
algebra action of the finite function algebra. -/
def mulC {n : ℕ} (f : Fin n → ℂ) : (Fin n → ℂ) →ₗ[ℝ] (Fin n → ℂ) where
  toFun := fun x k => f k * x k
  map_add' := fun x y => by
    funext k
    simp [mul_add]
  map_smul' := fun r x => by
    funext k
    show f k * ((r : ℂ) * x k) = (r : ℂ) * (f k * x k)
    ring

/-- Pointwise formula for `mulC`. -/
theorem mulC_apply {n : ℕ} (f : Fin n → ℂ) (x : Fin n → ℂ) (k : Fin n) :
    mulC f x k = f k * x k :=
  rfl

/-- Multiplication by the constant `1` function is the identity. -/
theorem mulC_one {n : ℕ} : mulC (1 : Fin n → ℂ) = 1 := by
  apply LinearMap.ext
  intro x
  funext k
  simp [mulC_apply]

/-- The action is multiplicative: `mulC (f * g) = mulC f * mulC g`
(operator multiplication is composition). -/
theorem mulC_mul {n : ℕ} (f g : Fin n → ℂ) :
    mulC (f * g) = mulC f * mulC g := by
  apply LinearMap.ext
  intro x
  funext k
  show (f * g) k * x k = f k * (g k * x k)
  rw [Pi.mul_apply, mul_assoc]

/-- The action is additive: `mulC (f + g) = mulC f + mulC g`. -/
theorem mulC_add {n : ℕ} (f g : Fin n → ℂ) :
    mulC (f + g) = mulC f + mulC g := by
  apply LinearMap.ext
  intro x
  funext k
  show (f + g) k * x k = f k * x k + g k * x k
  rw [Pi.add_apply, add_mul]

/-- The factor function algebra is commutative under the action. -/
theorem mulC_comm {n : ℕ} (f g : Fin n → ℂ) :
    mulC f * mulC g = mulC g * mulC f := by
  rw [← mulC_mul, ← mulC_mul, mul_comm f g]

/-- `mulC` commutes with the complex structure (it is ℂ-linear in
shadow): multiplication by a function commutes with multiplication
by `i`. -/
theorem mulC_comm_complexStructure {n : ℕ} (f : Fin n → ℂ) (x : Fin n → ℂ) :
    mulC f (complexStructure n x) = complexStructure n (mulC f x) := by
  funext k
  show f k * (Complex.I * x k) = Complex.I * (f k * x k)
  ring

/-- The R⁴ factor action is multiplicative: `diagOpR` of a product
of real functions is the product of the actions. -/
theorem diagOpR_mul (h h' : Fin 4 → ℝ) :
    diagOpR (h * h') = diagOpR h * diagOpR h' := by
  apply LinearMap.ext
  intro x
  funext k
  show (h * h') k * x k = h k * (h' k * x k)
  rw [Pi.mul_apply, mul_assoc]

/-- The R⁴ action of the constant `1` function is the identity. -/
theorem diagOpR_one : diagOpR (1 : Fin 4 → ℝ) = 1 := by
  apply LinearMap.ext
  intro x
  funext k
  show (1 : Fin 4 → ℝ) k * x k = x k
  rw [Pi.one_apply, one_mul]

/-- **A pure factorwise algebra action**: the tensor product of the
three factor function-algebra actions. -/
noncomputable def pureAlgOp (f : Fin 7 → ℂ) (g : Fin 4 → ℂ) (h : Fin 4 → ℝ) :
    Module.End ℝ q7c4r4Composite :=
  opTensorQ (mulC f) (mulC g) (diagOpR h)

/-- The pure action of the unit functions is the identity. -/
theorem pureAlgOp_one : pureAlgOp 1 1 1 = 1 := by
  unfold pureAlgOp
  rw [mulC_one, mulC_one, diagOpR_one]
  exact opTensor3_one

/-- The pure actions are multiplicative in the three functions. -/
theorem pureAlgOp_mul (f f' : Fin 7 → ℂ) (g g' : Fin 4 → ℂ)
    (h h' : Fin 4 → ℝ) :
    pureAlgOp (f * f') (g * g') (h * h')
      = pureAlgOp f g h * pureAlgOp f' g' h' := by
  unfold pureAlgOp
  rw [mulC_mul, mulC_mul, diagOpR_mul, opTensorQ_mul]

/-- **The composite algebra** (registered here; a labeled choice):
the ℝ-subalgebra of the composite endomorphism algebra generated
by the pure factorwise actions of the three factor function
algebras. This registration is apparatus, not a result. -/
noncomputable def AlgComp : Subalgebra ℝ (Module.End ℝ q7c4r4Composite) :=
  Algebra.adjoin ℝ {T | ∃ f g h, T = pureAlgOp f g h}

/-- Every pure factorwise action lies in the composite algebra. -/
theorem pureAlgOp_mem (f : Fin 7 → ℂ) (g : Fin 4 → ℂ) (h : Fin 4 → ℝ) :
    pureAlgOp f g h ∈ AlgComp :=
  Algebra.subset_adjoin ⟨f, g, h, rfl⟩

/-! ## §2. Self-adjointness on the composite and the one-form space

Self-adjointness is in form sense for the registered composite
pairing `compositePair` (the corpus's seat throughout this line).
The one-form space is the span of the single-term generators
`a [D, b]`, intersected with the self-adjoint operators — i.e.
exactly the self-adjoint operators of the form `Σᵢ aᵢ [D, bᵢ]`. -/

/-- **Self-adjointness on the composite**, in form sense for the
registered composite pairing. -/
def CompSelfAdjoint (T : Module.End ℝ q7c4r4Composite) : Prop :=
  ∀ s t, compositePair (T s) t = compositePair s (T t)

/-- The zero operator is composite-self-adjoint. -/
theorem compSelfAdjoint_zero : CompSelfAdjoint (0 : Module.End ℝ q7c4r4Composite) := by
  intro s t
  simp

/-- Composite-self-adjoint operators are closed under addition. -/
theorem CompSelfAdjoint.add {S T : Module.End ℝ q7c4r4Composite}
    (hS : CompSelfAdjoint S) (hT : CompSelfAdjoint T) :
    CompSelfAdjoint (S + T) := by
  intro s t
  simp only [LinearMap.add_apply, map_add]
  rw [hS s t, hT s t]

/-- Composite-self-adjoint operators are closed under real scaling. -/
theorem CompSelfAdjoint.smul {T : Module.End ℝ q7c4r4Composite}
    (hT : CompSelfAdjoint T) (r : ℝ) :
    CompSelfAdjoint (r • T) := by
  intro s t
  simp only [LinearMap.smul_apply, map_smul]
  rw [hT s t]

/-- **The self-adjoint operators form a submodule** of the
composite endomorphisms. -/
def selfAdjComp : Submodule ℝ (Module.End ℝ q7c4r4Composite) where
  carrier := {T | CompSelfAdjoint T}
  add_mem' := fun hS hT => CompSelfAdjoint.add hS hT
  zero_mem' := compSelfAdjoint_zero
  smul_mem' := fun r _ hT => CompSelfAdjoint.smul hT r

/-- A tensor product of form-self-adjoint factor operators is
composite-self-adjoint (the Assembly's Headline-2 argument, at the
level of a single tensor summand). -/
theorem opTensorQ_selfAdjoint {X : Module.End ℝ (Fin 7 → ℂ)}
    {Y : Module.End ℝ (Fin 4 → ℂ)} {Z : Module.End ℝ Minkowski}
    (hX : RealSelfAdjoint X) (hY : RealSelfAdjoint Y)
    (hZ : MinkSelfAdjoint Z) :
    CompSelfAdjoint (opTensorQ X Y Z) := by
  intro s t
  induction s using TensorProduct.inductionOn with
  | tmul s₇₄ z =>
    induction s₇₄ using TensorProduct.inductionOn with
    | tmul x y =>
      induction t using TensorProduct.inductionOn with
      | tmul t₇₄ w =>
        induction t₇₄ using TensorProduct.inductionOn with
        | tmul u v =>
          rw [opTensorQ_tmul, opTensorQ_tmul, compositePair_tmul,
            compositePair_tmul, hX x u, hY y v, hZ z w]
        | add a b ha hb =>
          simp only [TensorProduct.add_tmul, map_add, ha, hb]
      | add a b ha hb =>
        simp only [map_add, ha, hb]
    | add a b ha hb =>
      simp only [TensorProduct.add_tmul, map_add, LinearMap.add_apply, ha, hb]
  | add a b ha hb =>
    simp only [map_add, LinearMap.add_apply, ha, hb]

/-- The instantiated Dirac is composite-self-adjoint (Q7CR-1b's
Headline 2, restated in this brick's predicate). -/
theorem diracInst_selfAdjoint : CompSelfAdjoint diracInst :=
  diracQ7C4R4_selfAdjoint factorQ7 factorC4 factorR

/-- **The commutator operator** `[D, T]`, built pointwise:
subtraction of endomorphisms *into the composite* is not an
instance in this Mathlib pin (the Q7CR-3 quirk), while subtraction
of composite vectors is — so the commutator is the linear map
`v ↦ D (T v) - T (D v)`. -/
noncomputable def commOp (D T : Module.End ℝ q7c4r4Composite) :
    Module.End ℝ q7c4r4Composite where
  toFun := fun v => D (T v) - T (D v)
  map_add' := fun x y => by
    simp only [map_add]
    abel
  map_smul' := fun r x => by
    simp [map_smul, smul_sub]

/-- Pointwise formula for the commutator operator. -/
theorem commOp_apply (D T : Module.End ℝ q7c4r4Composite)
    (v : q7c4r4Composite) :
    commOp D T v = D (T v) - T (D v) :=
  rfl

/-- The commutator with zero on the right is zero. -/
theorem commOp_zero_right (D : Module.End ℝ q7c4r4Composite) :
    commOp D 0 = 0 := by
  apply LinearMap.ext
  intro v
  simp [commOp_apply]

/-- The commutator is additive in the right argument. -/
theorem commOp_add_right (D T₁ T₂ : Module.End ℝ q7c4r4Composite) :
    commOp D (T₁ + T₂) = commOp D T₁ + commOp D T₂ := by
  apply LinearMap.ext
  intro v
  simp only [commOp_apply, LinearMap.add_apply, map_add]
  abel

/-- The commutator is additive in the left argument. -/
theorem commOp_add_left (D₁ D₂ T : Module.End ℝ q7c4r4Composite) :
    commOp (D₁ + D₂) T = commOp D₁ T + commOp D₂ T := by
  apply LinearMap.ext
  intro v
  simp only [commOp_apply, LinearMap.add_apply, map_add]
  abel

/-- The commutator scales in the right argument. -/
theorem commOp_smul_right (D T : Module.End ℝ q7c4r4Composite) (r : ℝ) :
    commOp D (r • T) = r • commOp D T := by
  apply LinearMap.ext
  intro v
  simp [commOp_apply, map_smul, smul_sub]

/-- **A single-term one-form generator**: `a * [D, b]` for algebra
elements `a, b` — one summand of a one-form. -/
def IsOneFormGen (D : Module.End ℝ q7c4r4Composite)
    (A : Module.End ℝ q7c4r4Composite) : Prop :=
  ∃ a b : Module.End ℝ q7c4r4Composite,
    a ∈ AlgComp ∧ b ∈ AlgComp ∧ A = a * commOp D b

/-- **A one-form for `D`**: a finite sum of single-term generators
`Σᵢ aᵢ [D, bᵢ]` over the composite algebra. -/
def IsOneForm (D : Module.End ℝ q7c4r4Composite)
    (A : Module.End ℝ q7c4r4Composite) : Prop :=
  ∃ (k : ℕ) (a b : Fin k → Module.End ℝ q7c4r4Composite),
    (∀ i, a i ∈ AlgComp) ∧ (∀ i, b i ∈ AlgComp)
      ∧ A = ∑ i, a i * commOp D (b i)

/-- A single-term generator is a one-form (the sum over `Fin 1`). -/
theorem IsOneFormGen.isOneForm {D A : Module.End ℝ q7c4r4Composite}
    (h : IsOneFormGen D A) : IsOneForm D A := by
  obtain ⟨a, b, ha, hb, rfl⟩ := h
  exact ⟨1, fun _ => a, fun _ => b, fun _ => ha, fun _ => hb, by
    simp⟩

/-- Zero is a one-form (the empty sum). -/
theorem isOneForm_zero (D : Module.End ℝ q7c4r4Composite) :
    IsOneForm D 0 :=
  ⟨0, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0, fun i => i.elim0, by
    simp⟩

/-- **The one-form space of `D`** (the pack's `OneFormComp`): the
real submodule of self-adjoint operators of the form
`Σᵢ aᵢ [D, bᵢ]` over the composite algebra — the span of the
single-term generators, intersected with the self-adjoint
operators. -/
noncomputable def OneFormComp (D : Module.End ℝ q7c4r4Composite) :
    Submodule ℝ (Module.End ℝ q7c4r4Composite) :=
  Submodule.span ℝ {A | IsOneFormGen D A} ⊓ selfAdjComp

/-- A self-adjoint single-term generator lies in the one-form
space. -/
theorem IsOneFormGen.mem_oneFormComp {D A : Module.End ℝ q7c4r4Composite}
    (h : IsOneFormGen D A) (hA : CompSelfAdjoint A) :
    A ∈ OneFormComp D :=
  Submodule.mem_inf.mpr
    ⟨Submodule.subset_span h, hA⟩

/-- Every member of the one-form space is a one-form: it lies in
the span of the single-term generators. (The converse inclusion
needs the self-adjointness clause, as stated on `OneFormComp`.) -/
theorem mem_oneFormComp_isOneForm {D A : Module.End ℝ q7c4r4Composite}
    (h : A ∈ OneFormComp D) : A ∈ Submodule.span ℝ {A | IsOneFormGen D A} :=
  (Submodule.mem_inf.mp h).1

/-! ## §3. Pure gauge (infinitesimal form) and the fluctuation

The unitary group object of `AlgComp` is not landed (named in the
header), so pure-gauge directions are the infinitesimal ones:
commutators `[D, ξ]` with `ξ` in the algebra. -/

/-- **The infinitesimal pure-gauge subspace** for `D`: the
commutators `[D, ξ]` with `ξ` ranging over the composite algebra,
as a submodule of the endomorphisms. -/
def PureGaugeInf (D : Module.End ℝ q7c4r4Composite) :
    Submodule ℝ (Module.End ℝ q7c4r4Composite) where
  carrier := {A | ∃ ξ : Module.End ℝ q7c4r4Composite,
    ξ ∈ AlgComp ∧ A = commOp D ξ}
  add_mem' := by
    rintro A₁ A₂ ⟨ξ₁, hξ₁, rfl⟩ ⟨ξ₂, hξ₂, rfl⟩
    exact ⟨ξ₁ + ξ₂, add_mem hξ₁ hξ₂, (commOp_add_right D ξ₁ ξ₂).symm⟩
  zero_mem' := ⟨0, Subalgebra.zero_mem _, (commOp_zero_right D).symm⟩
  smul_mem' := by
    rintro r A ⟨ξ, hξ, rfl⟩
    exact ⟨r • ξ, Subalgebra.smul_mem _ hξ r, (commOp_smul_right D ξ r).symm⟩

/-- Membership in the infinitesimal pure-gauge subspace, unfolded. -/
theorem mem_pureGaugeInf {D A : Module.End ℝ q7c4r4Composite} :
    A ∈ PureGaugeInf D
      ↔ ∃ ξ : Module.End ℝ q7c4r4Composite,
        ξ ∈ AlgComp ∧ A = commOp D ξ :=
  Iff.rfl

/-- **The fluctuated Dirac** (registered form): `D + A`. The
`J A J⁻¹` term of the full Connes fluctuation is **omitted — the
named J seam**: no real structure on the composite is a landed
object, and none is fabricated here. -/
noncomputable def fluctuated (D A : Module.End ℝ q7c4r4Composite) :
    Module.End ℝ q7c4r4Composite :=
  D + A

/-- Fluctuating by zero is the identity operation. -/
theorem fluctuated_zero (D : Module.End ℝ q7c4r4Composite) :
    fluctuated D 0 = D :=
  add_zero D

/-- A fluctuated self-adjoint Dirac by a self-adjoint one-form is
self-adjoint. -/
theorem CompSelfAdjoint.fluctuated {D A : Module.End ℝ q7c4r4Composite}
    (hD : CompSelfAdjoint D) (hA : CompSelfAdjoint A) :
    CompSelfAdjoint (fluctuated D A) :=
  CompSelfAdjoint.add hD hA

/-! ## §4. The trace separator

The separating invariant is built from the ordinary
finite-dimensional trace (`LinearMap.trace`). It factorizes over
the tensor product, and the linear functional
`T ↦ Tr (D * T)` vanishes on every commutator `[D, ξ]` — for every
endomorphism `ξ`, not only algebra elements — by cyclicity of the
trace. -/

/-- **The trace on the composite** (ordinary finite-dimensional
trace of an endomorphism). -/
noncomputable def traceComp (T : Module.End ℝ q7c4r4Composite) : ℝ :=
  LinearMap.trace ℝ q7c4r4Composite T

/-- The trace factorizes over the triple tensor: the trace of
`opTensorQ X Y Z` is the product of the three factor traces. -/
theorem traceComp_opTensorQ (X : Module.End ℝ (Fin 7 → ℂ))
    (Y : Module.End ℝ (Fin 4 → ℂ)) (Z : Module.End ℝ Minkowski) :
    traceComp (opTensorQ X Y Z)
      = LinearMap.trace ℝ _ X * LinearMap.trace ℝ _ Y
        * LinearMap.trace ℝ _ Z := by
  unfold traceComp opTensorQ opTensor3
  rw [LinearMap.trace_tensorProduct', LinearMap.trace_tensorProduct']

/-- The trace on a complex factor, as the sum of diagonal entries
in the real site basis `basisC`. -/
theorem traceC_eq_sum {n : ℕ} (X : Module.End ℝ (Fin n → ℂ)) :
    LinearMap.trace ℝ _ X
      = ∑ a, (basisC n).repr (X (basisC n a)) a := by
  rw [LinearMap.trace_eq_matrix_trace ℝ (basisC n)]
  unfold Matrix.trace Matrix.diag
  simp [LinearMap.toMatrix_apply]

/-- The trace on the R⁴ factor, as the sum of diagonal entries in
the site basis. -/
theorem traceR_eq_sum (X : Module.End ℝ Minkowski) :
    LinearMap.trace ℝ _ X = ∑ m, (X (Pi.single m 1)) m := by
  rw [LinearMap.trace_eq_matrix_trace ℝ (Pi.basisFun ℝ (Fin 4))]
  unfold Matrix.trace Matrix.diag
  simp

/-- The real site basis coordinates are the real and imaginary
parts at the site. -/
theorem basisC_repr {n : ℕ} (v : Fin n → ℂ) (a : Fin n × Fin 2) :
    (basisC n).repr v a = if a.2 = 0 then (v a.1).re else (v a.1).im := by
  unfold basisC
  rw [Module.Basis.map_repr]
  simp [Pi.basisFun_repr, realBasisEquiv]

/-- The `b = 0` real site basis vector is the site vector. -/
theorem basisC_zero {n : ℕ} (k : Fin n) :
    basisC n (k, 0) = Pi.single k 1 := by
  funext j
  rw [basisC_apply]
  by_cases hj : j = k
  · subst hj; simp
  · simp [hj]

/-- The `b = 1` real site basis vector is `i` times the site
vector. -/
theorem basisC_one {n : ℕ} (k : Fin n) :
    basisC n (k, 1) = complexStructure n (Pi.single k 1) := by
  funext j
  rw [basisC_apply, complexStructure_apply]
  by_cases hj : j = k
  · subst hj; simp
  · simp [hj]

/-- **The trace of a ℂ-linear factor operator**: if `X` commutes
with the complex structure, its real trace is twice the real part
of its complex diagonal sum over sites. -/
theorem traceC_eq {n : ℕ} (X : Module.End ℝ (Fin n → ℂ))
    (hX : ∀ x, X (complexStructure n x) = complexStructure n (X x)) :
    LinearMap.trace ℝ _ X
      = 2 * ∑ k, ((X (Pi.single k 1)) k).re := by
  have hterm : ∀ k : Fin n,
      (basisC n).repr (X (basisC n (k, 0))) (k, 0)
        + (basisC n).repr (X (basisC n (k, 1))) (k, 1)
        = 2 * ((X (Pi.single k 1)) k).re := by
    intro k
    have h0 : (basisC n).repr (X (basisC n (k, 0))) (k, 0)
        = ((X (Pi.single k 1)) k).re := by
      rw [basisC_zero, basisC_repr]
      simp
    have h1 : (basisC n).repr (X (basisC n (k, 1))) (k, 1)
        = ((X (Pi.single k 1)) k).re := by
      rw [basisC_one, hX, basisC_repr]
      simp [complexStructure_apply, Complex.mul_im]
    rw [h0, h1, two_mul]
  calc LinearMap.trace ℝ _ X
      = ∑ a, (basisC n).repr (X (basisC n a)) a := traceC_eq_sum X
    _ = ∑ k, ((basisC n).repr (X (basisC n (k, 0))) (k, 0)
        + (basisC n).repr (X (basisC n (k, 1))) (k, 1)) := by
        rw [Fintype.sum_prod_type]
        apply Finset.sum_congr rfl
        intro k _
        rw [Fin.sum_univ_two]
    _ = ∑ k, 2 * ((X (Pi.single k 1)) k).re := by
        apply Finset.sum_congr rfl
        intro k _
        exact hterm k
    _ = 2 * ∑ k, ((X (Pi.single k 1)) k).re := by
        rw [Finset.mul_sum]

/-- ℂ-linearity in shadow, for products: operators commuting with
the complex structure are closed under operator multiplication. -/
theorem commutesWithJ_mul {n : ℕ} {X Y : Module.End ℝ (Fin n → ℂ)}
    (hX : ∀ x, X (complexStructure n x) = complexStructure n (X x))
    (hY : ∀ x, Y (complexStructure n x) = complexStructure n (Y x)) :
    ∀ x, (X * Y) (complexStructure n x)
      = complexStructure n ((X * Y) x) := by
  intro x
  simp only [Module.End.mul_apply, hY, hX]

/-- `diagOpC` commutes with the complex structure. -/
theorem diagOpC_commutesWithJ {n : ℕ} (d : Fin n → ℝ) :
    ∀ x, diagOpC d (complexStructure n x)
      = complexStructure n (diagOpC d x) := by
  intro x
  funext k
  show (d k : ℂ) * (Complex.I * x k) = Complex.I * ((d k : ℂ) * x k)
  ring

/-- `permOpC` commutes with the complex structure. -/
theorem permOpC_commutesWithJ {n : ℕ} (p : Fin n → Fin n) :
    ∀ x, permOpC p (complexStructure n x)
      = complexStructure n (permOpC p x) := by
  intro x
  funext k
  rw [permOpC_apply, complexStructure_apply, complexStructure_apply,
    permOpC_apply]

/-- The trace of the identity on the Q⁷ factor is its real
dimension, `14`. -/
theorem traceC_one_seven :
    LinearMap.trace ℝ (Fin 7 → ℂ) 1 = 14 := by
  rw [traceC_eq_sum]
  simp [Finset.sum_const, Finset.card_univ]

/-- The Q⁷ package's grading, as a permutation operator. -/
theorem factorQ7_gamma : factorQ7.γ = permOpC p₇ :=
  rfl

/-- The C⁴ package's grading, as a permutation operator. -/
theorem factorC4_gamma : factorC4.γ = permOpC p₄ :=
  rfl

/-- **Factor trace (a):** `Tr (D₇ γ₇) = 0` at the seat — the only
fixed site of `p₇` is `6`, where the diagonal entry `a₇ 6 = 0`. -/
theorem traceC_factorQ7_D_mul_gamma :
    LinearMap.trace ℝ _ (factorQ7.D * factorQ7.γ) = 0 := by
  rw [traceC_eq _ (commutesWithJ_mul
    (by rw [factorQ7_D]; exact diagOpC_commutesWithJ a₇)
    (by rw [factorQ7_gamma]; exact permOpC_commutesWithJ p₇))]
  rw [Fin.sum_univ_seven]
  simp [Module.End.mul_apply, factorQ7_D, factorQ7_gamma, diagOpC_apply,
    permOpC_apply, p₇, a₇]

/-- **Factor trace (R1):** `Tr (D_R) = 0` at the seat:
`0 + 2 - 2 + 0`. -/
theorem traceR_factorR_D :
    LinearMap.trace ℝ _ factorR.D = 0 := by
  rw [traceR_eq_sum, Fin.sum_univ_four]
  simp [factorR_D, diagOpR_apply, r_R]

/-- **Factor trace (R2):** `Tr (D_R * D_R) = 8` at the seat:
`0² + 2² + (-2)² + 0²`. -/
theorem traceR_factorR_D_mul_D :
    LinearMap.trace ℝ _ (factorR.D * factorR.D) = 8 := by
  rw [traceR_eq_sum, Fin.sum_univ_four]
  simp [Module.End.mul_apply, factorR_D, diagOpR_apply, r_R]
  norm_num

/-- **The separator vanishes on commutators.** For every
endomorphism `ξ` of the composite (in particular every algebra
element), `Tr (D * [D, ξ]) = 0`: the trace of `D * [D, ξ]` is the
difference of two traces related by cyclicity. -/
theorem traceComp_diracInst_commOp (ξ : Module.End ℝ q7c4r4Composite) :
    traceComp (diracInst * commOp diracInst ξ) = 0 := by
  have hsum : diracInst * commOp diracInst ξ + (diracInst * ξ) * diracInst
      = (diracInst * diracInst) * ξ := by
    apply LinearMap.ext
    intro v
    simp only [LinearMap.add_apply, Module.End.mul_apply, commOp_apply,
      map_sub]
    rw [sub_add_cancel]
  have h1 : traceComp (diracInst * commOp diracInst ξ)
      + traceComp ((diracInst * ξ) * diracInst)
      = traceComp ((diracInst * diracInst) * ξ) := by
    have h := congrArg (LinearMap.trace ℝ q7c4r4Composite) hsum
    simpa only [traceComp, map_add] using h
  have h2 : traceComp ((diracInst * ξ) * diracInst)
      = traceComp ((diracInst * diracInst) * ξ) := by
    unfold traceComp
    rw [LinearMap.trace_mul_comm, mul_assoc]
  linarith

/-! ## §5. The witness at the seat (Half B, construction)

The witness is a single-term one-form `a [D, b]` at the
instantiated seat, supported on the C⁴ factor: `b` multiplies by
`β₄` on C⁴, `a` multiplies by `α₄` on C⁴, both tensored with the
identity algebra elements on Q⁷ and R⁴. The commutator `[D, b]`
survives only through the third summand of `D` (the first two
commute with `b`: `D₇` and `D₄` are diagonal, and multiplication
commutes with them), so the witness is
`γ₇ ⊗ S₄ ⊗ D_R` with `S₄ = α₄ [γ₄, β₄]` on the C⁴ factor. Direct
computation gives `S₄ = mulC w₄ * γ₄` for the real function
`w₄ = (-1, 0, 0, -1)`, which is `p₄`-invariant — hence `S₄` is
self-adjoint. -/

/-- **The witness's left algebra function on C⁴ (CHOSEN):**
`α₄ = (i, i, -i, -i)`. -/
def alpha4 : Fin 4 → ℂ := ![Complex.I, Complex.I, -Complex.I, -Complex.I]

/-- **The witness's right algebra function on C⁴ (CHOSEN):**
`β₄ = (0, 0, 0, i)` — supported at the single site `3`, so its
commutator with the reversal grading is supported on the pair
`{0, 3}`. -/
def beta4 : Fin 4 → ℂ := ![0, 0, 0, Complex.I]

/-- **The witness's effective real function on C⁴:**
`w₄ = (-1, 0, 0, -1) = α₄ · (β₄ ∘ p₄ - β₄)`, real-valued and
`p₄`-invariant. -/
def w4 : Fin 4 → ℂ := ![(-1 : ℂ), 0, 0, -1]

/-- A multiplication-times-permutation operator with
`w (p k) = star (w k)` is self-adjoint for the factor pairing. -/
theorem mulC_permOpC_selfAdjoint {n : ℕ} (w : Fin n → ℂ)
    (p : Fin n → Fin n) (hinv : ∀ k, p (p k) = k)
    (hw : ∀ k, w (p k) = star (w k)) :
    RealSelfAdjoint (mulC w * permOpC p) := by
  intro x y
  show (cplxPair n ((mulC w * permOpC p) x) y).re
    = (cplxPair n x ((mulC w * permOpC p) y)).re
  apply congrArg Complex.re
  have hsum : (∑ k, x (p k) * w k * star (y k))
      = ∑ k, x k * star (w k) * star (y (p k)) := by
    have hbij : Function.Bijective p :=
      Function.Involutive.bijective (fun k => hinv k)
    have h := hbij.sum_comp (fun j => x j * star (w j) * star (y (p j)))
    simp only [hw, star_star, hinv] at h
    exact h
  calc (∑ k, ((mulC w * permOpC p) x) k * star (y k))
      = ∑ k, x (p k) * w k * star (y k) := by
        apply Finset.sum_congr rfl
        intro k _
        show w k * x (p k) * star (y k) = x (p k) * w k * star (y k)
        ring
    _ = ∑ k, x k * star (w k) * star (y (p k)) := hsum
    _ = ∑ k, x k * star (((mulC w * permOpC p) y) k) := by
        apply Finset.sum_congr rfl
        intro k _
        show x k * star (w k) * star (y (p k))
          = x k * star (w k * y (p k))
        rw [star_mul]
        ring

/-- Permuting past a multiplication composes the function. -/
theorem permOpC_mul_mulC {n : ℕ} (p : Fin n → Fin n) (w : Fin n → ℂ) :
    permOpC p * mulC w = mulC (w ∘ p) * permOpC p := by
  apply LinearMap.ext
  intro x
  funext k
  simp [Module.End.mul_apply, permOpC_apply, mulC_apply]

/-- The instantiated C⁴ diagonal commutes with pointwise
multiplication (both are pointwise). -/
theorem factorC4_D_mulC_comm (f : Fin 4 → ℂ) (y : Fin 4 → ℂ) :
    factorC4.D (mulC f y) = mulC f (factorC4.D y) := by
  funext k
  rw [factorC4_D, diagOpC_apply, mulC_apply, mulC_apply, diagOpC_apply]
  ring

/-- **The witness's C⁴ operator**: `S₄ = α₄ [γ₄, β₄]`, the
multiplied commutator on the C⁴ factor (subtraction of factor
endomorphisms is an instance — the factor codomain is a function
space). -/
noncomputable def S4 : Module.End ℝ (Fin 4 → ℂ) :=
  mulC alpha4 * (factorC4.γ * mulC beta4 - mulC beta4 * factorC4.γ)

/-- **The witness computation on C⁴:** `S₄ = mulC w₄ * γ₄` —
the multiplied commutator collapses to multiplication by the real
function `w₄ = (-1, 0, 0, -1)` composed with the grading. -/
theorem S4_eq : S4 = mulC w4 * factorC4.γ := by
  apply LinearMap.ext
  intro x
  funext k
  fin_cases k <;>
    simp [S4, alpha4, beta4, w4, Module.End.mul_apply, LinearMap.sub_apply,
      mulC_apply, factorC4_gamma, permOpC_apply, p₄, Complex.ext_iff,
      Complex.mul_re, Complex.mul_im]

/-- `w₄` is invariant under the reversal composed with conjugation:
`w₄ (p₄ k) = star (w₄ k)` — it is real and `p₄`-invariant. -/
theorem w4_p4_star (k : Fin 4) : w4 (p₄ k) = star (w4 k) := by
  fin_cases k <;> simp [w4, p₄]

/-- `S₄` is self-adjoint for the registered C⁴ pairing. -/
theorem S4_selfAdjoint : RealSelfAdjoint S4 := by
  rw [S4_eq, factorC4_gamma]
  exact mulC_permOpC_selfAdjoint w4 p₄ p₄_inv w4_p4_star

/-- `w₄ ∘ p₄ = w₄`. -/
theorem w4_comp_p4 : w4 ∘ p₄ = w4 := by
  funext k
  fin_cases k <;> simp [w4, p₄]

/-- Conjugating the witness's C⁴ operator by the grading returns
the multiplication: `γ₄ * S₄ = mulC w₄`. -/
theorem gammaC4_mul_S4 : factorC4.γ * S4 = mulC w4 := by
  calc factorC4.γ * S4
      = (factorC4.γ * mulC w4) * factorC4.γ := by
        rw [S4_eq, mul_assoc]
    _ = (mulC (w4 ∘ p₄) * factorC4.γ) * factorC4.γ := by
        rw [factorC4_gamma, permOpC_mul_mulC]
    _ = mulC w4 := by
        rw [w4_comp_p4, mul_assoc, FactorOp.gamma_mul_self, mul_one]

/-- **Factor trace (C1):** `Tr (mulC w₄) = -4` at the seat:
twice the real diagonal sum `(-1) + 0 + 0 + (-1) = -2`. -/
theorem traceC_mulC_w4 :
    LinearMap.trace ℝ _ (mulC w4) = -4 := by
  rw [traceC_eq _ (mulC_comm_complexStructure w4), Fin.sum_univ_four]
  simp [mulC_apply, w4]
  norm_num

/-- **Factor trace (C2):** `Tr (γ₄ * S₄) = -4` at the seat. -/
theorem traceC_gammaC4_mul_S4 :
    LinearMap.trace ℝ _ (factorC4.γ * S4) = -4 := by
  rw [gammaC4_mul_S4]
  exact traceC_mulC_w4

/-- **The witness one-form at the seat**: `γ₇ ⊗ S₄ ⊗ D_R`, the
tensor form of the single-term one-form `a [D, b]` with
`a = pureAlgOp 1 α₄ 1` and `b = pureAlgOp 1 β₄ 1` (the
factorization is `witnessA_factorization` below). -/
noncomputable def witnessA : Module.End ℝ q7c4r4Composite :=
  opTensorQ factorQ7.γ S4 factorR.D

/-- The witness is self-adjoint for the registered composite
pairing (a tensor of self-adjoint factor operators). -/
theorem witnessA_selfAdjoint : CompSelfAdjoint witnessA :=
  opTensorQ_selfAdjoint factorQ7.γ_selfadj S4_selfAdjoint
    factorR.D_selfadj

/-- The witness's algebra elements, in tensor form. -/
theorem pureAlgOp_alpha4 :
    pureAlgOp 1 alpha4 1 = opTensorQ 1 (mulC alpha4) 1 := by
  unfold pureAlgOp
  rw [mulC_one, diagOpR_one]

/-- The witness's algebra elements, in tensor form. -/
theorem pureAlgOp_beta4 :
    pureAlgOp 1 beta4 1 = opTensorQ 1 (mulC beta4) 1 := by
  unfold pureAlgOp
  rw [mulC_one, diagOpR_one]

/-- The instantiated Dirac, unfolded to the assembly. -/
theorem diracInst_eq :
    diracInst = diracQ7C4R4 factorQ7 factorC4 factorR :=
  rfl

/-- **The witness factorization.** The witness *is* the single-term
one-form `a [D, b]` at the seat, with `a, b` pure factorwise
algebra elements: the first two summands of `D` commute with `b`
(diagonal against multiplication), and the third contributes
exactly `γ₇ ⊗ (α₄ [γ₄, β₄]) ⊗ D_R`. Proved on pure tensors. -/
theorem witnessA_factorization :
    witnessA = pureAlgOp 1 alpha4 1
      * commOp diracInst (pureAlgOp 1 beta4 1) := by
  apply LinearMap.ext
  intro v
  induction v using TensorProduct.inductionOn with
  | tmul v₇₄ z =>
    induction v₇₄ using TensorProduct.inductionOn with
    | tmul x y =>
      have hbv : pureAlgOp 1 beta4 1 ((x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z)
          = (x ⊗ₜ[ℝ] mulC beta4 y) ⊗ₜ[ℝ] z := by
        rw [pureAlgOp_beta4, opTensorQ_tmul]
        simp
      have hDv : diracInst ((x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z)
          = ((factorQ7.D x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z)
            + ((factorQ7.γ x ⊗ₜ[ℝ] factorC4.D y) ⊗ₜ[ℝ] z)
            + ((factorQ7.γ x ⊗ₜ[ℝ] factorC4.γ y) ⊗ₜ[ℝ] factorR.D z) := by
        rw [diracInst_eq]
        exact diracQ7C4R4_tmul factorQ7 factorC4 factorR x y z
      have hDbv : diracInst (pureAlgOp 1 beta4 1 ((x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z))
          = ((factorQ7.D x ⊗ₜ[ℝ] mulC beta4 y) ⊗ₜ[ℝ] z)
            + ((factorQ7.γ x ⊗ₜ[ℝ] factorC4.D (mulC beta4 y)) ⊗ₜ[ℝ] z)
            + ((factorQ7.γ x ⊗ₜ[ℝ] factorC4.γ (mulC beta4 y))
                ⊗ₜ[ℝ] factorR.D z) := by
        rw [hbv, diracInst_eq]
        exact diracQ7C4R4_tmul factorQ7 factorC4 factorR x (mulC beta4 y) z
      have hbDv : pureAlgOp 1 beta4 1 (diracInst ((x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z))
          = ((factorQ7.D x ⊗ₜ[ℝ] mulC beta4 y) ⊗ₜ[ℝ] z)
            + ((factorQ7.γ x ⊗ₜ[ℝ] mulC beta4 (factorC4.D y)) ⊗ₜ[ℝ] z)
            + ((factorQ7.γ x ⊗ₜ[ℝ] mulC beta4 (factorC4.γ y))
                ⊗ₜ[ℝ] factorR.D z) := by
        rw [hDv, map_add, map_add, pureAlgOp_beta4, opTensorQ_tmul,
          opTensorQ_tmul, opTensorQ_tmul]
        simp
      have hcomm : commOp diracInst (pureAlgOp 1 beta4 1)
            ((x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z)
          = ((factorQ7.γ x ⊗ₜ[ℝ]
              (factorC4.γ (mulC beta4 y) - mulC beta4 (factorC4.γ y)))
              ⊗ₜ[ℝ] factorR.D z) := by
        rw [commOp_apply, hDbv, hbDv, factorC4_D_mulC_comm,
          TensorProduct.tmul_sub, TensorProduct.sub_tmul]
        abel
      rw [Module.End.mul_apply, hcomm, pureAlgOp_alpha4, opTensorQ_tmul]
      show witnessA ((x ⊗ₜ[ℝ] y) ⊗ₜ[ℝ] z)
        = (factorQ7.γ x ⊗ₜ[ℝ]
            mulC alpha4 (factorC4.γ (mulC beta4 y)
              - mulC beta4 (factorC4.γ y))) ⊗ₜ[ℝ] factorR.D z
      unfold witnessA
      rw [opTensorQ_tmul]
      simp [S4, Module.End.mul_apply, LinearMap.sub_apply]
    | add a b ha hb =>
      simp only [TensorProduct.add_tmul, map_add, ha, hb]
  | add a b ha hb =>
    simp only [map_add, ha, hb]

/-- The witness is a single-term one-form generator at the seat. -/
theorem witnessA_isOneFormGen : IsOneFormGen diracInst witnessA :=
  ⟨pureAlgOp 1 alpha4 1, pureAlgOp 1 beta4 1, pureAlgOp_mem 1 alpha4 1,
    pureAlgOp_mem 1 beta4 1, witnessA_factorization⟩

/-- The witness is a one-form at the seat. -/
theorem witnessA_isOneForm : IsOneForm diracInst witnessA :=
  witnessA_isOneFormGen.isOneForm

/-- The witness lies in the one-form space at the seat. -/
theorem witnessA_mem_oneFormComp : witnessA ∈ OneFormComp diracInst :=
  witnessA_isOneFormGen.mem_oneFormComp witnessA_selfAdjoint

/-! ## §6. The seat decision

The separator `T ↦ Tr (diracInst * T)` evaluated at the witness:
the three summands of `diracInst * witnessA` contribute
`Tr(D₇γ₇) · (·) · (·) = 0` (the Q⁷ diagonal trace against the
grading vanishes), `(·) · (·) · Tr(D_R) = 0` (the R⁴ diagonal is
traceless), and `Tr(1) · Tr(γ₄S₄) · Tr(D_R²) = 14 · (-4) · 8
= -448`. Since the separator vanishes on every commutator
`[D, ξ]` (§4), the witness is not an infinitesimal pure-gauge
direction. -/

/-- The composite trace is additive. -/
theorem traceComp_add (S T : Module.End ℝ q7c4r4Composite) :
    traceComp (S + T) = traceComp S + traceComp T := by
  unfold traceComp
  exact map_add _ _ _

/-- The composite trace of zero is zero. -/
theorem traceComp_zero : traceComp (0 : Module.End ℝ q7c4r4Composite) = 0 := by
  unfold traceComp
  exact map_zero _

/-- The first summand contributes `0`: `Tr (D₇ γ₇) = 0`. -/
theorem traceComp_summand_one :
    traceComp (opTensorQ factorQ7.D 1 1 * witnessA) = 0 := by
  unfold witnessA
  rw [← opTensorQ_mul, traceComp_opTensorQ, traceC_factorQ7_D_mul_gamma,
    zero_mul, zero_mul]

/-- The second summand contributes `0`: `Tr (D_R) = 0`. -/
theorem traceComp_summand_two :
    traceComp (opTensorQ factorQ7.γ factorC4.D 1 * witnessA) = 0 := by
  unfold witnessA
  rw [← opTensorQ_mul, traceComp_opTensorQ, one_mul, traceR_factorR_D,
    mul_zero]

/-- The third summand contributes `14 · (-4) · 8 = -448`. -/
theorem traceComp_summand_three :
    traceComp (opTensorQ factorQ7.γ factorC4.γ factorR.D * witnessA)
      = -448 := by
  unfold witnessA
  rw [← opTensorQ_mul, traceComp_opTensorQ, FactorOp.gamma_mul_self,
    traceC_one_seven, traceC_gammaC4_mul_S4, traceR_factorR_D_mul_D]
  norm_num

/-- **The separator at the witness:** `Tr (diracInst * witnessA)
= -448 ≠ 0`. -/
theorem traceComp_diracInst_mul_witnessA :
    traceComp (diracInst * witnessA) = -448 := by
  have hsum : diracInst * witnessA
      = opTensorQ factorQ7.D 1 1 * witnessA
        + opTensorQ factorQ7.γ factorC4.D 1 * witnessA
        + opTensorQ factorQ7.γ factorC4.γ factorR.D * witnessA := by
    rw [diracInst_eq]
    unfold diracQ7C4R4
    rw [add_mul, add_mul]
  rw [hsum, traceComp_add, traceComp_add, traceComp_summand_one,
    traceComp_summand_two, traceComp_summand_three]
  norm_num

/-- **The witness is not an infinitesimal pure-gauge direction:**
the separator vanishes on every commutator `[diracInst, ξ]`
(`traceComp_diracInst_commOp`) but takes the value `-448` at the
witness. -/
theorem witnessA_not_pureGauge : witnessA ∉ PureGaugeInf diracInst := by
  intro h
  obtain ⟨ξ, -, hξ⟩ := mem_pureGaugeInf.mp h
  have htr := traceComp_diracInst_mul_witnessA
  rw [hξ, traceComp_diracInst_commOp] at htr
  norm_num at htr

/-- The witness is nonzero (its separator value is nonzero). -/
theorem witnessA_ne_zero : witnessA ≠ 0 := by
  intro h
  have htr := traceComp_diracInst_mul_witnessA
  rw [h, mul_zero, traceComp_zero] at htr
  norm_num at htr

/-- The one-form space at the seat is not contained in the
infinitesimal pure-gauge subspace. -/
theorem oneFormComp_not_subset_pureGauge :
    ¬ OneFormComp diracInst ≤ PureGaugeInf diracInst :=
  fun hle => witnessA_not_pureGauge (hle witnessA_mem_oneFormComp)

/-- The one-form space at the seat is nonzero. -/
theorem oneFormComp_ne_bot : OneFormComp diracInst ≠ ⊥ := by
  intro h
  have hmem : witnessA ∈ (⊥ : Submodule ℝ (Module.End ℝ q7c4r4Composite)) := by
    rw [← h]
    exact witnessA_mem_oneFormComp
  rw [Submodule.mem_bot] at hmem
  exact witnessA_ne_zero hmem

/-- The fluctuated Dirac at the witness is self-adjoint for the
registered composite pairing. -/
theorem fluctuated_witnessA_selfAdjoint :
    CompSelfAdjoint (fluctuated diracInst witnessA) :=
  CompSelfAdjoint.fluctuated diracInst_selfAdjoint witnessA_selfAdjoint

/-- The fluctuation at the witness actually moves the Dirac. -/
theorem fluctuated_witnessA_ne : fluctuated diracInst witnessA ≠ diracInst := by
  intro h
  unfold fluctuated at h
  apply witnessA_ne_zero
  apply LinearMap.ext
  intro v
  have hv : (diracInst + witnessA) v = diracInst v :=
    congrArg (fun T => T v) h
  have hv2 : witnessA v = (diracInst + witnessA) v - diracInst v := by
    rw [LinearMap.add_apply]
    abel
  rw [hv2, hv, sub_self, LinearMap.zero_apply]

/-- **THE SEAT DECISION (Q7CR-2's instantiated seat, verbatim).**
The witness `witnessA = γ₇ ⊗ S₄ ⊗ D_R` is a self-adjoint member
