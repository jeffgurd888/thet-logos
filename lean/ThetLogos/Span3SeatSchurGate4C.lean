namespace ThetLogos

open MeasureTheory Finset
open scoped Matrix ENNReal NNReal

section Span3SeatSchurGate4C

variable {G : Type*} [Group G] [MeasurableSpace G] [MeasurableInv G]
  [TopologicalSpace G] [IsTopologicalGroup G] [BorelSpace G]
  [SecondCountableTopology G] {d : ℕ}
  (μG : Measure G) [IsProbabilityMeasure μG]
  [Measure.IsMulLeftInvariant μG] [Measure.IsMulRightInvariant μG]
  [Measure.IsInvInvariant μG]
  (ρ : G →* ↥(Matrix.unitaryGroup (Fin d) ℂ)) {N : ℕ} [NeZero N]

/-- **GATE-4C, the conditional limit passage, frozen as
a Prop; asserted nowhere in this module.** At every
even `N` with `4 ≤ N`, every `β`, at `0 < d`: GIVEN
(1) finite Gram-shaped expansion data for
`pullBotKernel` — finite types `ι n`, coefficients
`c n i ≥ 0`, layer functions `φ n i`, factors pulled
back along `tauBot hN` — whose difference kernel is
`MemLp 2` on the product probability space with
`eLpNorm` tending to `0` (item 1's clauses, the data
named explicitly); (2) the per-stage dressed factor
integrands integrable in both forms (`hIntStage`);
(3) the target pairing integrands integrable in both
forms (`hIntLim`); (4) the dressed factor pairings
nonnegative in both forms (item 6's antecedent,
verbatim) — THEN `SeatSchurTarget μG ρ hN β` holds in
its exact registered form. The hypotheses and their
reasons are on this module's face. This is NOT
GATE-0's item 6: item 6 stands unproved as frozen
(K-GATE-4C-2). -/
def seatSchurTarget_of_approxProductStep_gate4c : Prop :=
  ∀ (hN : Even N) (hN4 : 4 ≤ N) (β : ℝ) (hd : 0 < d)
    (ι : ℕ → Type) (_ : ∀ n, Fintype (ι n))
    (c : ∀ n, ι n → ℝ)
    (φ : ∀ n, ι n → (LayerLink N → G) → ℂ),
    (∀ n i, 0 ≤ c n i) →
    (∀ n, MemLp
      (fun p : (↥(posLinks (N := N)) → G)
          × (↥(posLinks (N := N)) → G) =>
        pullBotKernel μG ρ hN β p.1 p.2
          - ∑ i, (c n i : ℂ)
              * ((φ n i) (tauBot hN p.1)
                * (starRingEnd ℂ) ((φ n i) (tauBot hN p.2))))
      2 ((Measure.pi fun _ : ↥(posLinks (N := N)) => μG).prod
        (Measure.pi fun _ : ↥(posLinks (N := N)) => μG))) →
    Filter.Tendsto
      (fun n => (eLpNorm
        (fun p : (↥(posLinks (N := N)) → G)
            × (↥(posLinks (N := N)) → G) =>
          pullBotKernel μG ρ hN β p.1 p.2
            - ∑ i, (c n i : ℂ)
                * ((φ n i) (tauBot hN p.1)
                  * (starRingEnd ℂ) ((φ n i) (tauBot hN p.2))))
        2 ((Measure.pi fun _ : ↥(posLinks (N := N)) => μG).prod
          (Measure.pi fun _ : ↥(posLinks (N := N)) => μG))).toReal)
      Filter.atTop (nhds 0) →
    (∀ (f : (↥(posLinks (N := N)) → G) → ℂ),
      AEStronglyMeasurable f
        (Measure.pi fun _ : ↥(posLinks (N := N)) => μG) →
      (∃ C : ℝ, ∀ z, ‖f z‖ ≤ C) →
      ∀ n i, Integrable
        (fun r : (↥(posLinks (N := N)) → G)
            × (↥(posLinks (N := N)) → G) =>
          ((posGaugeAvg μG f) r.1 * (φ n i) (tauBot hN r.1))
            * (pullTopKernel μG ρ hN β r.1 r.2
              * (starRingEnd ℂ) ((mirrorGaugeAvg μG f) r.2
                * (φ n i) (tauBot hN r.2))))
        ((Measure.pi fun _ : ↥(posLinks (N := N)) => μG).prod
          (Measure.pi fun _ : ↥(posLinks (N := N)) => μG))
      ∧ Integrable
        (fun r : (↥(posLinks (N := N)) → G)
            × (↥(posLinks (N := N)) → G) =>
          (((Real.exp (-(halfActionP ρ β r.1)) : ℂ)
              * (posGaugeAvg μG f) r.1)
              * (φ n i) (tauBot hN r.1))
            * (pullTopKernel μG ρ hN β r.1 r.2
              * (starRingEnd ℂ)
                (((Real.exp (-(halfActionP ρ β r.2)) : ℂ)
                    * (mirrorGaugeAvg μG f) r.2)
                  * (φ n i) (tauBot hN r.2))))
        ((Measure.pi fun _ : ↥(posLinks (N := N)) => μG).prod
          (Measure.pi fun _ : ↥(posLinks (N := N)) => μG))) →
    (∀ (f : (↥(posLinks (N := N)) → G) → ℂ),
      AEStronglyMeasurable f
        (Measure.pi fun _ : ↥(posLinks (N := N)) => μG) →
      (∃ C : ℝ, ∀ z, ‖f z‖ ≤ C) →
      Integrable
        (fun r : (↥(posLinks (N := N)) → G)
            × (↥(posLinks (N := N)) → G) =>
          (posGaugeAvg μG f) r.1
            * (planeCrossingMarginal μG ρ hN β r.1 r.2
              * (starRingEnd ℂ) ((mirrorGaugeAvg μG f) r.2)))
        ((Measure.pi fun _ : ↥(posLinks (N := N)) => μG).prod
          (Measure.pi fun _ : ↥(posLinks (N := N)) => μG))
      ∧ Integrable
        (fun r : (↥(posLinks (N := N)) → G)
            × (↥(posLinks (N := N)) → G) =>
          ((Real.exp (-(halfActionP ρ β r.1)) : ℂ)
              * (posGaugeAvg μG f) r.1)
            * (planeCrossingMarginal μG ρ hN β r.1 r.2
              * (starRingEnd ℂ)
                ((Real.exp (-(halfActionP ρ β r.2)) : ℂ)
                  * (mirrorGaugeAvg μG f) r.2)))
        ((Measure.pi fun _ : ↥(posLinks (N := N)) => μG).prod
          (Measure.pi fun _ : ↥(posLinks (N := N)) => μG))) →
    (∀ (f : (↥(posLinks (N := N)) → G) → ℂ)
      (φ' : (LayerLink N → G) → ℂ),
      AEStronglyMeasurable f
        (Measure.pi fun _ : ↥(posLinks (N := N)) => μG) →
      (∃ C : ℝ, ∀ z, ‖f z‖ ≤ C) →
      0 ≤ (seatPairing μG (pullTopKernel μG ρ hN β)
        (fun z => (posGaugeAvg μG f) z * φ' (tauBot hN z))
        (fun z => (mirrorGaugeAvg μG f) z
          * φ' (tauBot hN z))).re
      ∧ 0 ≤ (seatPairing μG (pullTopKernel μG ρ hN β)
        (fun z => (Real.exp (-(halfActionP ρ β z)) : ℂ)
          * (posGaugeAvg μG f) z * φ' (tauBot hN z))
        (fun z => (Real.exp (-(halfActionP ρ β z)) : ℂ)
          * (mirrorGaugeAvg μG f) z
          * φ' (tauBot hN z))).re) →
    SeatSchurTarget μG ρ hN β

end Span3SeatSchurGate4C

end ThetLogos
