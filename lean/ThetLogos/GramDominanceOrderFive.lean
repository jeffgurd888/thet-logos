open MeasureTheory Finset

namespace ThetLogos

section GramDominanceOrderFive

variable {G : Type*} [Group G] [MeasurableSpace G] [MeasurableInv G]
  [TopologicalSpace G] [IsTopologicalGroup G] [BorelSpace G]
  [SecondCountableTopology G] {d : ℕ}
  (ρ : G →* ↥(Matrix.unitaryGroup (Fin d) ℂ)) {N : ℕ} [NeZero N]
  (μG : Measure G) [IsProbabilityMeasure μG]
  [μG.IsMulLeftInvariant] [μG.IsMulRightInvariant] [μG.IsInvInvariant]

/-! ## The evaluation of the excess diagonal -/

/-- **The evaluation, general form (GD-1, item 1).**
The order-5 excess's diagonal, composed through
B5-2's dictionary and GD-2's landed doubled-quad
expansion: `2^{-5}` times the sum over primitive
quads `C` and doubled columns `P in C` of the real
part of GD-2's opposite-copies plus same-side
sub-sums, minus the fully-split baseline
`4 * |primitiveQuads| * mu_2 * e_1^3`. No site
integral is evaluated: the sub-sums are
`doubledCharMoment` sums, uncontracted at the
doubled column's sites. -/
theorem kappa5chanExcess_diag_eval
    (hρcont : Continuous fun g : G => repMatrix ρ g)
    (u : LayerLink N → G) :
    kappa5chanExcess ρ μG u u
      = ((2 : ℝ)⁻¹) ^ 5
          * (∑ C ∈ primitiveQuads, ∑ P ∈ C,
              (doubledOppSum ρ μG C P u
                + doubledSameSum ρ μG C P u).re)
        - 4 * ((primitiveQuads (N := N)).card : ℝ)
          * realMoment ρ μG 2 * (e1 ρ μG) ^ 3 := by
  have hterm : ∀ C ∈ primitiveQuads (N := N), ∀ P ∈ C,
      doubledQuadReMoment ρ μG C P u u
        = ((2 : ℝ)⁻¹) ^ 5
            * (doubledOppSum ρ μG C P u
              + doubledSameSum ρ μG C P u).re := by
    intro C hC P hP
    have hcard : C.card = 4 := by
      rw [primitiveQuads, Finset.mem_filter] at hC
      exact hC.2.1
    have h := doubledQuadReMoment_eq_opp_add_same ρ μG hρcont C P hP u
    rw [hcard] at h
    exact h
  calc kappa5chanExcess ρ μG u u
      = kappa5chan2111 ρ μG u u
        - 4 * ((primitiveQuads (N := N)).card : ℝ)
          * realMoment ρ μG 2 * (e1 ρ μG) ^ 3 :=
        kappa5chanExcess_eq ρ μG u u
    _ = (∑ C ∈ primitiveQuads, ∑ P ∈ C,
            doubledQuadReMoment ρ μG C P u u)
          - 4 * ((primitiveQuads (N := N)).card : ℝ)
            * realMoment ρ μG 2 * (e1 ρ μG) ^ 3 := rfl
    _ = ((2 : ℝ)⁻¹) ^ 5
          * (∑ C ∈ primitiveQuads, ∑ P ∈ C,
              (doubledOppSum ρ μG C P u
                + doubledSameSum ρ μG C P u).re)
        - 4 * ((primitiveQuads (N := N)).card : ℝ)
          * realMoment ρ μG 2 * (e1 ρ μG) ^ 3 := by
        congr 1
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun C hC => ?_
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun P hP => hterm C hC P hP

/-- **The evaluation at irreducible rho (GD-1,
item 1, memo scope).** The baseline vanishes
(`e1 = 0` at irreducible rho, `2 <= d`), so the
excess diagonal is exactly `2^{-5}` times the real
part of GD-2's two copy-side sub-sums, summed over
primitive quads and their doubled columns. This is
the evaluated form whose cone membership is the
brick's remaining question. -/
theorem kappa5chanExcess_diag_eval_irreducible
    (hρcont : Continuous fun g : G => repMatrix ρ g)
    (hρirr : RepIrreducible ρ) (hd : 2 ≤ d)
    (u : LayerLink N → G) :
    kappa5chanExcess ρ μG u u
      = ((2 : ℝ)⁻¹) ^ 5
          * (∑ C ∈ primitiveQuads, ∑ P ∈ C,
              (doubledOppSum ρ μG C P u
                + doubledSameSum ρ μG C P u).re) := by
  have he1 : e1 ρ μG = 0 := e1_eq_zero_of_irreducible ρ μG hρirr hd hρcont
  rw [kappa5chanExcess_diag_eval ρ μG hρcont u, he1]
  norm_num

/-! ## The cone algebra -/

/-- **GD-0's cone is closed under diagonal
agreement.** `ExcessInGramCone` reads only the
diagonal of its form, so a form agreeing with a
cone member on the diagonal is itself a member,
with the same coefficients. -/
theorem excessInGramCone_congr_diag
    {E E' : (LayerLink N → G) → (LayerLink N → G) → ℝ}
    (hdiag : ∀ u : LayerLink N → G, E u u = E' u u)
    (h : ExcessInGramCone ρ μG E') :
    ExcessInGramCone ρ μG E := by
  obtain ⟨a, hnn, hsup, hid⟩ := h
  exact ⟨a, hnn, hsup, fun u => by rw [hdiag u]; exact hid u⟩

/-- **GD-0's cone is closed under addition** of
forms, coefficientwise. -/
theorem excessInGramCone_add
    {E F : (LayerLink N → G) → (LayerLink N → G) → ℝ}
    (hE : ExcessInGramCone ρ μG E) (hF : ExcessInGramCone ρ μG F) :
    ExcessInGramCone ρ μG (fun u u' => E u u' + F u u') := by
  obtain ⟨a, hnn_a, hsup_a, hid_a⟩ := hE
  obtain ⟨b, hnn_b, hsup_b, hid_b⟩ := hF
  refine ⟨fun i => a i + b i, fun i => add_nonneg (hnn_a i) (hnn_b i),
    fun i hi => by
      show a i + b i = 0
      rw [hsup_a i hi, hsup_b i hi, add_zero], fun u => ?_⟩
  show E u u + F u u
    = ∑ i, ((a i + b i : ℚ) : ℝ) * gramSquare ρ μG i.1 i.2.1 i.2.2 u
  rw [hid_a u, hid_b u, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Rat.cast_add, add_mul]

/-- **GD-0's cone is closed under finite sums** of
forms over any index finset, coefficientwise: the
total coefficient at a presentation is the sum of
the summands' coefficients there. -/
theorem excessInGramCone_sum {ι : Type*} (s : Finset ι)
    (E : ι → (LayerLink N → G) → (LayerLink N → G) → ℝ)
    (h : ∀ i, ExcessInGramCone ρ μG (E i)) :
    ExcessInGramCone ρ μG (fun u u' => ∑ i ∈ s, E i u u') := by
  classical
  choose a hnn hsup hid using h
  refine ⟨fun j => ∑ i ∈ s, a i j,
    fun j => Finset.sum_nonneg fun i _ => hnn i j,
    fun j hj => Finset.sum_eq_zero fun i _ => hsup i j hj, fun u => ?_⟩
  show (∑ i ∈ s, E i u u)
    = ∑ j, ((∑ i ∈ s, a i j : ℚ) : ℝ) * gramSquare ρ μG j.1 j.2.1 j.2.2 u
  calc (∑ i ∈ s, E i u u)
      = ∑ i ∈ s, ∑ j, ((a i j : ℚ) : ℝ)
          * gramSquare ρ μG j.1 j.2.1 j.2.2 u :=
        Finset.sum_congr rfl fun i _ => hid i u
    _ = ∑ j, ∑ i ∈ s, ((a i j : ℚ) : ℝ)
          * gramSquare ρ μG j.1 j.2.1 j.2.2 u := Finset.sum_comm
    _ = ∑ j, ((∑ i ∈ s, a i j : ℚ) : ℝ)
          * gramSquare ρ μG j.1 j.2.1 j.2.2 u := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Rat.cast_sum, Finset.sum_mul]

/-- **Every cone member is diagonally
nonnegative**: the squares `gramSquare` are
nonnegative (a nonnegative scalar times a squared
norm) and the coefficients are nonnegative. -/
theorem excessInGramCone_diag_nonneg
    {E : (LayerLink N → G) → (LayerLink N → G) → ℝ}
    (h : ExcessInGramCone ρ μG E) (u : LayerLink N → G) :
    0 ≤ E u u := by
  obtain ⟨a, hnn, _hsup, hid⟩ := h
  rw [hid u]
  refine Finset.sum_nonneg fun i _ => ?_
  refine mul_nonneg (Rat.cast_nonneg.mpr (hnn i)) ?_
  unfold gramSquare
  exact mul_nonneg (pow_nonneg (inv_nonneg.mpr (Nat.cast_nonneg d)) _)
    (sq_nonneg _)

/-- **The recorded necessary condition.** If
`GDGlobal5` held, the order-5 excess diagonal
would be nonnegative at every observable - the
K-K5-shaped shadow of GD-global at order 5.
Recorded as a consequence of the registered
Prop, not as a decision about it: this brick
exhibits no negative value and proves no
nonnegativity. -/
theorem gdGlobal5_excess_diag_nonneg (h : GDGlobal5 (N := N) ρ μG)
    (u : LayerLink N → G) :
    0 ≤ kappa5chanExcess ρ μG u u :=
  excessInGramCone_diag_nonneg ρ μG h u

/-! ## The reduction to one doubled moment -/

/-- **The zero form lies in GD-0's cone**
(all coefficients zero). -/
theorem excessInGramCone_zero :
    ExcessInGramCone (N := N) ρ μG (fun _ _ => (0 : ℝ)) :=
  ⟨fun _ => 0, fun _ => le_refl 0, fun _ _ => rfl, fun u => by
    simp⟩

/-- **Finite-sum closure, membership form**:
it suffices that the summands indexed by the
finset itself lie in the cone. Proved by
extending the family by the zero form off the
finset and applying `excessInGramCone_sum`. -/
theorem excessInGramCone_sum_of_mem {ι : Type*} (s : Finset ι)
    (E : ι → (LayerLink N → G) → (LayerLink N → G) → ℝ)
    (h : ∀ i ∈ s, ExcessInGramCone ρ μG (E i)) :
    ExcessInGramCone ρ μG (fun u u' => ∑ i ∈ s, E i u u') := by
  classical
  have hE' : ∀ i, ExcessInGramCone ρ μG
      (fun u u' => if i ∈ s then E i u u' else 0) := by
    intro i
    by_cases hi : i ∈ s
    · refine excessInGramCone_congr_diag ρ μG
        (E' := E i) (fun u => ?_) (h i hi)
      show (if i ∈ s then E i u u else (0 : ℝ)) = E i u u
      rw [if_pos hi]
    · refine excessInGramCone_congr_diag ρ μG
        (E' := fun _ _ => (0 : ℝ)) (fun u => ?_)
        (excessInGramCone_zero ρ μG)
      show (if i ∈ s then E i u u else (0 : ℝ)) = 0
      rw [if_neg hi]
  have hsum := excessInGramCone_sum ρ μG s
    (fun i => fun u u' => if i ∈ s then E i u u' else 0) hE'
  refine excessInGramCone_congr_diag ρ μG
    (E' := fun u u' => ∑ i ∈ s, (if i ∈ s then E i u u' else 0)) ?_ hsum
  intro u
  exact Finset.sum_congr rfl fun i hi => (if_pos hi).symm

/-- **Cone membership of one doubled moment**:
the per-(C, P) content of the order-5 cone
question, in GD-0's vocabulary. This Prop is the
named dependence of the brick's PARTIAL: deciding
it at general rho is the reassembly through
TW-1's site evaluations, whose contracted form
carries the invariant basis's Gram/CG data (see
the header, strands (i)-(iii)). Registered here
as a name for that question; asserted nowhere. -/
def DoubledMomentInCone5 (C : Finset (LayerColumn N))
    (P : LayerColumn N) : Prop :=
  ExcessInGramCone ρ μG
    (fun u u' => doubledQuadReMoment ρ μG C P u u')

/-- **The reduction (GD-1, item 3).** At
irreducible rho (`2 <= d`, continuous `repMatrix`,
so the baseline
`mu_2 * e_1^3` vanishes summand by summand), if
every doubled moment of every primitive quad
lies in GD-0's cone, then `GDGlobal5` holds:
the excess is the finite sum of the doubled
moments, and the cone is closed under finite
sums and diagonal agreement. The converse is
not claimed (a sum in the cone does not split
into its summands). So the order-5 cone
question is exactly `DoubledMomentInCone5` at
the primitive quads - the per-representation
question the header names. -/
theorem gdGlobal5_of_doubled_in_cone
    (hρcont : Continuous fun g : G => repMatrix ρ g)
    (hρirr : RepIrreducible ρ) (hd : 2 ≤ d)
    (h : ∀ C ∈ primitiveQuads (N := N), ∀ P ∈ C,
      DoubledMomentInCone5 ρ μG C P) :
    GDGlobal5 (N := N) ρ μG := by
  have he1 : e1 ρ μG = 0 := e1_eq_zero_of_irreducible ρ μG hρirr hd hρcont
  have hcone : ExcessInGramCone ρ μG
      (fun u u' => ∑ C ∈ primitiveQuads, ∑ P ∈ C,
        doubledQuadReMoment ρ μG C P u u') :=
    excessInGramCone_sum_of_mem ρ μG primitiveQuads
      (fun C => fun u u' => ∑ P ∈ C, doubledQuadReMoment ρ μG C P u u')
      (fun C hC => excessInGramCone_sum_of_mem ρ μG C
        (fun P => fun u u' => doubledQuadReMoment ρ μG C P u u')
        (fun P hP => h C hC P hP))
  show ExcessInGramCone ρ μG (kappa5chanExcess ρ μG)
  refine excessInGramCone_congr_diag ρ μG
    (E' := fun u u' => ∑ C ∈ primitiveQuads, ∑ P ∈ C,
      doubledQuadReMoment ρ μG C P u u') (fun u => ?_) hcone
  show kappa5chanExcess ρ μG u u
    = ∑ C ∈ primitiveQuads, ∑ P ∈ C, doubledQuadReMoment ρ μG C P u u
  refine Finset.sum_congr rfl fun C _ => Finset.sum_congr rfl fun P _ => ?_
  rw [he1]
  norm_num

