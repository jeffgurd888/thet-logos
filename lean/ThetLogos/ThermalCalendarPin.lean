import Mathlib

namespace ThetLogos

/-- The pinned Schoolcraft design table: monthly mean
temperatures in °C, months `0…11` = Jan…Dec, as exact
rationals (scope sheet §2). -/
def monthTempC : Fin 12 → ℚ :=
  ![-5.7, -4.3, 1.1, 7.8, 13.9, 19.2, 21.4, 20.3, 16.1,
    9.7, 3.1, -2.8]

/-- The table in kelvin: `monthTempC + 273.15`. -/
def monthTempK (m : Fin 12) : ℚ := monthTempC m + 273.15

/-- The year's total kelvin weight: the sum of the twelve
monthly kelvin temperatures. -/
def totalK : ℚ := ∑ m, monthTempK m

/-- The year's mean kelvin temperature. -/
def meanK : ℚ := totalK / 12

/-- The thermal weight of month `m`: its share of the
year's mean temperature. The Θ-step across month `m` is
`thermalWeight m / 12` (see `thetaStep`). -/
def thermalWeight (m : Fin 12) : ℚ := monthTempK m / meanK

/-- The Θ-step across month `m`: the fraction of the
year's accumulated thermal phase elapsed during that
month. -/
def thetaStep (m : Fin 12) : ℚ := thermalWeight m / 12

/-- The Θ-step across month `m`, computed from the table
directly (the definitional unfolding of `thetaStep`). -/
def stepOf (m : Fin 12) : ℚ :=
  if h : m.1 < 12 then
    (![-5.7, -4.3, 1.1, 7.8, 13.9, 19.2, 21.4, 20.3, 16.1,
      9.7, 3.1, -2.8] ⟨m.1, h⟩ + 273.15) / totalK
  else 0

/-- The accumulated thermal phase after `n` months:
`Θ(n) = Σ_{m<n} thetaStep m`. `cumTheta 0 = 0` and
`cumTheta 12 = 1` (proved below). -/
def cumTheta : ℕ → ℚ
  | 0 => 0
  | n + 1 => cumTheta n + thetaStep ⟨n % 12, Nat.mod_lt _ (by norm_num)⟩

/-- The module boundaries: the thirteen modules divide
the year at accumulated phase `Θ = k/13`, `k = 0…13`.
Definition only. -/
def moduleBoundary (k : Fin 14) : ℚ := k.1 / 13

/-! ## Brick 2 — positivity -/

/-- The pinned table sums to `99.8` °C over the year
(mechanical evaluation of the twelve design values). -/
theorem sum_monthTempC : ∑ m, monthTempC m = 99.8 := by
  norm_num [monthTempC, Fin.sum_univ_castSucc]

/-- The year's total kelvin weight is `3377.6`
(`= 12 × 273.15 + 99.8`). -/
theorem totalK_eq : totalK = 3377.6 := by
  unfold totalK monthTempK
  rw [Finset.sum_add_distrib, sum_monthTempC]
  norm_num [Finset.sum_const, Finset.card_univ, Fintype.card_fin]

/-- Every monthly kelvin temperature is positive (the
coldest pinned month, January at −5.7 °C, is 267.45 K). -/
theorem monthTempK_pos (m : Fin 12) : 0 < monthTempK m := by
  fin_cases m <;> norm_num [monthTempK, monthTempC]

/-- The year's mean kelvin temperature is positive. -/
theorem meanK_pos : 0 < meanK := by
  rw [meanK, totalK_eq]
  norm_num

/-- **(a)** Every thermal weight is positive. -/
theorem thermalWeight_pos (m : Fin 12) : 0 < thermalWeight m :=
  div_pos (monthTempK_pos m) meanK_pos

/-! ## Brick 3 — the steps and monotonicity -/

/-- Every Θ-step is positive. -/
theorem thetaStep_pos (m : Fin 12) : 0 < thetaStep m :=
  div_pos (thermalWeight_pos m) (by norm_num)

/-- The direct step function agrees with `thetaStep`:
`stepOf m = thetaStep m` (both are
`(table + 273.15) / totalK`). -/
theorem stepOf_pos (m : Fin 12) : stepOf m = thetaStep m := by
  have hK : monthTempK m = monthTempC m + 273.15 := rfl
  have hmean : meanK = totalK / 12 := rfl
  unfold stepOf
  rw [dif_pos m.2]
  show (monthTempC m + 273.15) / totalK = thetaStep m
  unfold thetaStep thermalWeight
  rw [hK, hmean]
  field_simp

/-- The accumulation unfolds one step at a time:
`Θ(n+1) = Θ(n) + step(n mod 12)`. -/
theorem cumTheta_succ (n : ℕ) :
    cumTheta (n + 1)
      = cumTheta n + thetaStep ⟨n % 12, Nat.mod_lt _ (by norm_num)⟩ :=
  rfl

/-- Each of the twelve steps strictly increases the
accumulated phase. -/
theorem cumTheta_strict_step (n : ℕ) (hn : n < 12) :
    cumTheta n < cumTheta (n + 1) := by
  rw [cumTheta_succ]
  have h := thetaStep_pos ⟨n % 12, Nat.mod_lt _ (by norm_num)⟩
  linarith

/-- **(c) Winter-slow, in finite Θ form:** the January
Θ-step is strictly smaller than the July Θ-step — in the
thermal register the year crawls in January (267.45 K of
weight) and runs in July (294.55 K). This is a theorem
about Θ shares of the pinned table, never about the arc
register (where perihelion does the opposite). -/
theorem winter_slow_step :
    thetaStep ⟨0, by norm_num⟩ < thetaStep ⟨6, by norm_num⟩ := by
  have hmean : (0:ℚ) < meanK := meanK_pos
  have hjan : monthTempK ⟨0, by norm_num⟩ = 267.45 := by
    norm_num [monthTempK, monthTempC]
  have hjul : monthTempK ⟨6, by norm_num⟩ = 294.55 := by
    norm_num [monthTempK, monthTempC]
  unfold thetaStep thermalWeight
  rw [hjan, hjul]
  exact div_lt_div_of_pos_right
    (div_lt_div_of_pos_right (by norm_num) hmean) (by norm_num)

/-! ## Brick 4 — normalization -/

/-- After twelve months the accumulated phase is the sum
of all twelve steps. -/
theorem cumTheta_twelve :
    cumTheta 12 = ∑ m : Fin 12, thetaStep m := by
  have key : ∀ (n : ℕ) (hn : n < 12),
      cumTheta (n + 1) = cumTheta n + thetaStep ⟨n, hn⟩ := by
    intro n hn
    rw [cumTheta_succ]
    have hfin : (⟨n % 12, Nat.mod_lt _ (by norm_num)⟩ : Fin 12)
        = ⟨n, hn⟩ := Fin.ext (Nat.mod_eq_of_lt hn)
    rw [hfin]
  have e11 : cumTheta 12 = cumTheta 11 + thetaStep ⟨11, by norm_num⟩ :=
    key 11 (by norm_num)
  have e10 : cumTheta 11 = cumTheta 10 + thetaStep ⟨10, by norm_num⟩ :=
    key 10 (by norm_num)
  have e9 : cumTheta 10 = cumTheta 9 + thetaStep ⟨9, by norm_num⟩ :=
    key 9 (by norm_num)
  have e8 : cumTheta 9 = cumTheta 8 + thetaStep ⟨8, by norm_num⟩ :=
    key 8 (by norm_num)
  have e7 : cumTheta 8 = cumTheta 7 + thetaStep ⟨7, by norm_num⟩ :=
    key 7 (by norm_num)
  have e6 : cumTheta 7 = cumTheta 6 + thetaStep ⟨6, by norm_num⟩ :=
    key 6 (by norm_num)
  have e5 : cumTheta 6 = cumTheta 5 + thetaStep ⟨5, by norm_num⟩ :=
    key 5 (by norm_num)
  have e4 : cumTheta 5 = cumTheta 4 + thetaStep ⟨4, by norm_num⟩ :=
    key 4 (by norm_num)
  have e3 : cumTheta 4 = cumTheta 3 + thetaStep ⟨3, by norm_num⟩ :=
    key 3 (by norm_num)
  have e2 : cumTheta 3 = cumTheta 2 + thetaStep ⟨2, by norm_num⟩ :=
    key 2 (by norm_num)
  have e1 : cumTheta 2 = cumTheta 1 + thetaStep ⟨1, by norm_num⟩ :=
    key 1 (by norm_num)
  have e0 : cumTheta 1 = cumTheta 0 + thetaStep ⟨0, by norm_num⟩ :=
    key 0 (by norm_num)
  have h0 : cumTheta 0 = 0 := rfl
  rw [e11, e10, e9, e8, e7, e6, e5, e4, e3, e2, e1, e0, h0]
  have hbridge : ∀ m : Fin 12, thetaStep m
      = (fun i => thetaStep ⟨i % 12, Nat.mod_lt _ (by norm_num)⟩) m.1 := by
    intro m
    have hfin : (⟨m.1 % 12, Nat.mod_lt _ (by norm_num)⟩ : Fin 12) = m :=
      Fin.ext (Nat.mod_eq_of_lt m.2)
    show thetaStep m = thetaStep ⟨m.1 % 12, Nat.mod_lt _ (by norm_num)⟩
    rw [hfin]
  have hsum : (∑ m : Fin 12, thetaStep m)
      = ∑ i ∈ Finset.range 12,
        thetaStep ⟨i % 12, Nat.mod_lt _ (by norm_num)⟩ := by
    rw [← Fin.sum_univ_eq_sum_range]
    exact Finset.sum_congr rfl (fun m _ => hbridge m)
  rw [hsum]
  simp only [Finset.sum_range_succ, Nat.reduceMod]
  ring

/-- The twelve Θ-steps sum to exactly 1. -/
theorem sum_thetaStep : ∑ m : Fin 12, thetaStep m = 1 := by
  have hsum : (∑ m : Fin 12, thermalWeight m) * meanK = totalK := by
    have h2 : (∑ m : Fin 12, thermalWeight m)
        = (∑ m : Fin 12, monthTempK m) / meanK := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro m _
      rfl
    rw [h2]
    have htot : (∑ m : Fin 12, monthTempK m) = totalK := rfl
    rw [htot]
    exact div_mul_cancel₀ totalK (ne_of_gt meanK_pos)
  have hmean_ne : meanK ≠ 0 := ne_of_gt meanK_pos
  have hw : ∑ m : Fin 12, thermalWeight m = 12 := by
    have htot2 : totalK = 12 * meanK := by
      show totalK = 12 * (totalK / 12)
      field_simp
    rw [htot2] at hsum
    have := (mul_left_cancel₀ hmean_ne
      (show meanK * (∑ m : Fin 12, thermalWeight m)
        = meanK * 12 by rw [mul_comm meanK _, mul_comm meanK 12]; exact hsum))
    exact this
  have hstep : ∀ m : Fin 12, thetaStep m = thermalWeight m / 12 := fun m => rfl
  rw [Finset.sum_congr rfl (fun m _ => hstep m), ← Finset.sum_div, hw]
  norm_num

/-- **(d) Normalization: `Θ(12) = 1`** — the accumulated
thermal phase closes the year exactly. -/
theorem cumTheta_end : cumTheta 12 = 1 := by
  rw [cumTheta_twelve, sum_thetaStep]

/-! ## §7 — names and week numbers (Zero's directive,
2026-11-12 14:33 EST, names corrected 14:36 EST;
seats re-anchored to April by Zero's ruling
2026-11-14 10:14 EST) -/

/-- The thirteen month names of the calendar: the
ORIGINAL thirteen of the 13-month calendar, ring-ordered
from April — a name's index in this list IS its seat:
April 0, May 1, June 2, Sol 3 (between June and July,
as in the original), July 4, August 5, September 6,
October 7, November 8, December 9, January 10,
February 11, March 12. Original names, not proposals.
(Re-anchored to the April seats by Zero's ruling
2026-11-14; before that ruling the list was
ring-ordered from the equinox.) -/
def monthNames : List String :=
  ["April", "May", "June", "Sol", "July", "August",
    "September", "October", "November", "December", "January",
    "February", "March"]

/-- Thirteen names for the thirteen modules. -/
theorem monthNames_length : monthNames.length = 13 := rfl

/-- The total thermal week count at thermal phase `θ`:
the year holds `52 = 13 × 4` thermal weeks, so the count
is `⌊52·θ⌋`. The count's origin is the dial's zero
(θ = 0 at the March equinox). -/
def weekCount (θ : ℚ) : ℕ := ⌊52 * θ⌋₊

/-- The week address of thermal phase `θ`:
`(seat, week)` with seat in `0…12` (Zero's seats,
counted from April: April 0 … March 12) and week in
`1…4` — addresses `0.1` through `12.4`, with the
equinox origin `θ = 0` at `12.1`. The seat is the
equinox module shifted by the April anchor: with the
equinox module counted `0…12` from March as
`weekCount θ / 4`, `seat = (weekCount θ / 4 + 12) % 13`
— equivalently `seat = (module + 11) % 13` for the old
1-based equinox module. -/
def weekAddress (θ : ℚ) : ℕ × ℕ :=
  ((weekCount θ / 4 + 12) % 13, weekCount θ % 4 + 1)

/-- At the origin (`θ = 0`, the March equinox) the
address is `12.1` — March, seat 12, week 1: the seat
ring counts from April, so the solar origin falls in
the ring's last seat. -/
theorem weekAddress_zero : weekAddress 0 = (12, 1) := by
  simp [weekAddress, weekCount]

/-- The week count decomposes by modules: four whole
thermal weeks per module elapsed, plus the quarter of
the current module's Θ-span already counted. This is
the formal content of "each module holds exactly 4
thermal weeks, its Θ-span in quarters." -/
theorem weekCount_eq (θ : ℚ) (hθ : 0 ≤ θ) :
    weekCount θ
      = 4 * ⌊13 * θ⌋₊ + ⌊4 * (13 * θ - ⌊13 * θ⌋₊)⌋₊ := by
  have h52 : (0:ℚ) ≤ 52 * θ := by positivity
  have hn1 : (⌊13 * θ⌋₊ : ℚ) ≤ 13 * θ :=
    Nat.floor_le (by positivity)
  have hn2 : 13 * θ < (⌊13 * θ⌋₊ : ℚ) + 1 :=
    Nat.lt_floor_add_one _
  have hr1 : (⌊4 * (13 * θ - ⌊13 * θ⌋₊)⌋₊ : ℚ)
      ≤ 4 * (13 * θ - ⌊13 * θ⌋₊) :=
    Nat.floor_le (by linarith)
  have hr2 : 4 * (13 * θ - ⌊13 * θ⌋₊)
      < (⌊4 * (13 * θ - ⌊13 * θ⌋₊)⌋₊ : ℚ) + 1 :=
    Nat.lt_floor_add_one _
  unfold weekCount
  rw [Nat.floor_eq_iff h52]
  constructor <;> push_cast <;> linarith

/-- The week count is monotone in Θ: thermal time never
addresses backwards. -/
theorem weekCount_mono : Monotone weekCount := by
  intro a b hab
  unfold weekCount
  apply Nat.floor_mono
  apply mul_le_mul_of_nonneg_left hab
  norm_num

/-- Below `Θ = 1` every address is in range: seat at
most `12`, week at most `4`. (The seat bound holds at
every `θ`, since a seat is a residue mod 13.) -/
theorem weekAddress_bounded (θ : ℚ) (h0 : 0 ≤ θ) (h1 : θ < 1) :
    (weekAddress θ).1 ≤ 12 ∧ (weekAddress θ).2 ≤ 4 := by
  have hw : weekCount θ ≤ 51 := by
    have h52 : (52:ℚ) * θ < 52 := by
      calc (52:ℚ) * θ < 52 * 1 :=
            mul_lt_mul_of_pos_left h1 (by norm_num)
        _ = 52 := mul_one _
    have hlt : ⌊52 * θ⌋₊ < 52 := (Nat.floor_lt (by positivity :
      (0:ℚ) ≤ 52 * θ)).mpr h52
    show ⌊52 * θ⌋₊ ≤ 51
    omega
  have haddr : weekAddress θ
      = ((weekCount θ / 4 + 12) % 13, weekCount θ % 4 + 1) := rfl
  rw [haddr]
  constructor
  · show (weekCount θ / 4 + 12) % 13 ≤ 12
    omega
  · show weekCount θ % 4 + 1 ≤ 4
    omega

/-- **`11.4` is the last address below `Θ = 1`**: at
`θ = 51/52` — the first day of the final thermal week —
the address is exactly `(11, 4)`: February, seat 11,
week 4. -/
theorem weekAddress_last : weekAddress (51 / 52 : ℚ) = (11, 4) := by
  have hw : weekCount (51 / 52 : ℚ) = 51 := by
    unfold weekCount
    rw [show (52:ℚ) * (51 / 52) = 51 by norm_num,
      Nat.floor_ofNat]
  have haddr : weekAddress (51 / 52 : ℚ)
      = ((weekCount (51 / 52 : ℚ) / 4 + 12) % 13,
        weekCount (51 / 52 : ℚ) % 4 + 1) := rfl
  rw [haddr, hw]

/-! ## §8 — the day level: the civil year, the residual,
and the counted map (day-level brick, Zero's
commission 2026-11-15)

The civil year as a bare enumeration: `Fin 365`,
index 0 seated at the seam — index 0 is April 1,
indices 1–364 are April 2 … March 31 in civil order.
The enumeration is DEFINITIONAL (Zero's static rule,
2026-11-14): once set, a day's seating does not move
with thermal variation. The day level is CIVIL, not
thermal: no Θ address is claimed for individual days.

Two residuals stand outside the count, by Zero's
rulings: April 1 itself — Zero.zero, the Boundary
Day, index 0 below — and February 29 (leap rule,
2026-11-14), which takes no counted label and is NOT
part of this enumeration: there is no `Fin 366` here;
the leap day stands under Zero Day's cover, outside
the enumeration exactly as it stands outside the
count. -/

/-- The Boundary Day: index 0 of the civil year —
**April 1, Zero.zero**, the Clean Residual Day. It is
a civil day of the enumeration and it is NOT counted:
the counted year opens the day after it (index 1,
April 2, counted 0). Named and carded here as the
residual of the count. -/
def boundaryDay : Fin 365 := ⟨0, by norm_num⟩

/-- The counted map on the complement of the
residual: a civil day other than the Boundary Day,
at index `i ≥ 1`, carries counted label `i − 1` —
the counted year opens at counted 0 (April 2) and
closes at counted 363 (March 31). -/
def countedOf (d : Fin 365) (h : d ≠ boundaryDay) : Fin 364 :=
  ⟨d.1 - 1, by
    have h0 : d.1 ≠ 0 := fun hd => h (Fin.ext hd)
    have hlt : d.1 < 365 := d.2
    omega⟩

/-- The counted map reads off the index: its value is
`d.1 - 1`. (Definitional unfolding, the workhorse of
the day-level API.) -/
theorem countedOf_val (d : Fin 365) (h : d ≠ boundaryDay) :
    (countedOf d h).1 = d.1 - 1 := rfl

/-- **Seam value, opening:** the day after the seam —
index 1, April 2 — carries counted 0: the counted
year opens there. -/
theorem countedOf_first :
    countedOf ⟨1, by norm_num⟩ (by decide) = ⟨0, by norm_num⟩ :=
  Fin.ext rfl

/-- **Seam value, closing:** the last civil day —
index 364, March 31 — carries counted 363: the
counted year closes there. -/
theorem countedOf_last :
    countedOf ⟨364, by norm_num⟩ (by decide) = ⟨363, by norm_num⟩ :=
  Fin.ext rfl

/-! ## §9 — the day-level API: the counted map on the
complement (day-level Brick 2, Zero's relaunch
2026-11-18)

The elementary API of §8's enumeration: on the
complement of the Boundary Day, `countedOf` is
injective and surjective onto `Fin 364`, it preserves
the enumeration order, and the complement carries
exactly 364 days. This is civil enumeration API only —
the assembly a bijection theorem would use, stated
here as API. No Θ claim is made for individual days;
the day level stays civil, not thermal, exactly as
carded at §8. -/

/-- The counted map is injective on the complement of
the Boundary Day: two counted civil days carrying the
same counted label are the same day. -/
theorem countedOf_injective {d e : Fin 365} (hd : d ≠ boundaryDay)
    (he : e ≠ boundaryDay) (h : countedOf d hd = countedOf e he) :
    d = e := by
  have hval : d.1 - 1 = e.1 - 1 := by
    have hcon := congrArg Fin.val h
    rwa [countedOf_val, countedOf_val] at hcon
  have hd0 : d.1 ≠ 0 := fun h0 => hd (Fin.ext h0)
  have he0 : e.1 ≠ 0 := fun h0 => he (Fin.ext h0)
  exact Fin.ext (by omega)

/-- The counted map is surjective onto the counted
year: every counted label 0–363 is carried by a
counted civil day — label `c` by the civil day at
index `c + 1`. -/
theorem countedOf_surjective (c : Fin 364) :
    ∃ d : Fin 365, ∃ h : d ≠ boundaryDay, countedOf d h = c := by
  have hc : c.1 < 364 := c.2
  refine ⟨⟨c.1 + 1, by omega⟩, ?_, ?_⟩
  · intro hcon
    have hv : c.1 + 1 = 0 := congrArg Fin.val hcon
    omega
  · apply Fin.ext
    rw [countedOf_val]
    exact Nat.add_sub_cancel c.1 1

/-- The counted map preserves the enumeration order:
a counted civil day seated no later than another
carries a counted label no larger. -/
theorem countedOf_mono {d e : Fin 365} (hd : d ≠ boundaryDay)
    (he : e ≠ boundaryDay) (h : d.1 ≤ e.1) :
    (countedOf d hd).1 ≤ (countedOf e he).1 := by
  rw [countedOf_val, countedOf_val]
  omega

/-- The counted map strictly preserves the enumeration
order on the complement: a counted civil day seated
strictly before another carries a strictly smaller
counted label. -/
theorem countedOf_strict_mono {d e : Fin 365} (hd : d ≠ boundaryDay)
    (he : e ≠ boundaryDay) (h : d.1 < e.1) :
    (countedOf d hd).1 < (countedOf e he).1 := by
  have hd0 : d.1 ≠ 0 := fun h0 => hd (Fin.ext h0)
  rw [countedOf_val, countedOf_val]
  omega

/-- The complement of the Boundary Day in the civil
year carries exactly 364 days — the counted year,
13 × 4 × 7. -/
theorem card_complement_boundaryDay :
    (Finset.univ \ {boundaryDay} : Finset (Fin 365)).card = 364 := by
  rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin,
    Finset.card_singleton]

end ThetLogos
