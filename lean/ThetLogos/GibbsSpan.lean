-- ============================================================================
-- §1. The diagonal Gibbs weights for general energies, and the modular
-- Hamiltonian of the diagonal Gibbs state (Target 1)
-- ============================================================================

section DiagonalK

variable {N : ℕ}

/-- **Gibbs weights for general energies** (Tier T2 — definition): for a
    diagonal Hamiltonian with real energy levels `E`, inverse
    temperature `β`, and partition log `logZ`, the Gibbs weights
    `w_j = exp(−(β • E_j + logZ))` — the exponential of minus the
    modular eigenvalue at energy `E_j`. The corpus's
    `gibbsDiagWeights` is the case `E_j = λ_j²` (the Dirac operator's
    `D²`), see `gibbsDiagWeights_eq_weightsE` below. -/
noncomputable def gibbsWeightsE (β : ℝ) (E : Fin N → ℝ) (logZ : ℝ) :
    Fin N → ℝ :=
  fun j => Real.exp (-(β * E j + logZ))

/-- Gibbs weights are faithful (Tier T1 — proved): every weight is
    strictly positive, so the diagonal Gibbs state always carries an
    honest modular Hamiltonian by the `−log` formula. -/
theorem gibbsWeightsE_pos (β : ℝ) (E : Fin N → ℝ) (logZ : ℝ) (j : Fin N) :
    0 < gibbsWeightsE β E logZ j :=
  Real.exp_pos _

/-- The log of a Gibbs weight is minus the modular eigenvalue
    (Tier T1 — proved): `log w_j = −(β • E_j + logZ)`. -/
theorem gibbsWeightsE_log (β : ℝ) (E : Fin N → ℝ) (logZ : ℝ) (j : Fin N) :
    Real.log (gibbsWeightsE β E logZ j) = -(β * E j + logZ) := by
  simp [gibbsWeightsE, Real.log_exp]

/-- The corpus's Gibbs weights are the `E = λ²` case (Tier T1 —
    proved): `gibbsDiagWeights β lam logZ = gibbsWeightsE β (λ²) logZ`,
    by unfolding `modularEigenvalue`. -/
theorem gibbsDiagWeights_eq_weightsE (β : ℝ) (lam : Fin N → ℝ) (logZ : ℝ) :
    gibbsDiagWeights β lam logZ = gibbsWeightsE β (fun j => lam j ^ 2) logZ := by
  funext j
  simp [gibbsDiagWeights, gibbsWeightsE, modularEigenvalue]

/-- **TARGET 1 — the modular Hamiltonian of the diagonal Gibbs state**
    (Tier T1 — proved): in the corpus's diagonal construction
    (`diagModularK`, i.e. `K = −ln ρ` computed in the eigenbasis), the
    modular Hamiltonian of the Gibbs state with energies `E` at
    inverse temperature `β` is exactly

        `K = β • H + (logZ) • 1`,

    where `H = diagonal E`. This is the pad's `K = β(H − F)` in the
    additive form the construction actually gives: the scalar term
    `(logZ) • 1` — the free-energy term — is on the face of the
    statement, carried explicitly, not dropped. -/
theorem diagModularK_gibbsWeightsE (β : ℝ) (E : Fin N → ℝ) (logZ : ℝ) :
    diagModularK (gibbsWeightsE β E logZ)
      = (β : ℂ) • Matrix.diagonal (fun j => (E j : ℂ)) + (logZ : ℂ) • 1 := by
  ext i j
  by_cases h : i = j
  · subst h
    simp only [diagModularK, Matrix.diagonal_apply_eq, Matrix.add_apply,
      Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul]
    rw [gibbsWeightsE_log]
    push_cast
    ring
  · simp [diagModularK, Matrix.diagonal_apply, h, Ne.symm h]

/-- Target 1, entry form (Tier T1 — proved): the `j`-th diagonal entry
    of the Gibbs modular Hamiltonian is `β • E_j + logZ`. -/
theorem gibbsK_apply_diag (β : ℝ) (E : Fin N → ℝ) (logZ : ℝ) (j : Fin N) :
    diagModularK (gibbsWeightsE β E logZ) j j
      = ((β * E j + logZ : ℝ) : ℂ) := by
  simp [diagModularK, Matrix.diagonal_apply_eq, gibbsWeightsE_log]

end DiagonalK

-- ============================================================================
-- §2. The flow identity in the eigenbasis picture (Target 2, diagonal form)
-- ============================================================================

section DiagonalFlow

variable {N : ℕ}

/-- **TARGET 2, eigenbasis form** (Tier T1 — proved): the modular flow
    of the diagonal Gibbs state at thermal time `s` IS the laboratory
    (Hamiltonian) flow of the energies `E` at physical time `β • s`,

        `diagFlow (Gibbs weights) s = hamiltonianFlow E (β * s)`,

    as maps on all observables. The general-energy form of the corpus's
    `diagFlow_gibbs_eq_hamiltonianFlow` (which is the case `E = λ²`).
    The `logZ` phases cancel in the product of the two phase factors —
    the scalar term is invisible to the flow, and the cancellation is
    the proof, here in the open. Gibbs states only: the fence of the
    header applies. -/
theorem diagFlow_gibbsWeightsE (β : ℝ) (E : Fin N → ℝ) (logZ : ℝ)
    (s : ℝ) (a : Matrix (Fin N) (Fin N) ℂ) :
    diagFlow (gibbsWeightsE β E logZ) s a
      = hamiltonianFlow E (β * s) a := by
  ext i j
  rw [diagFlow_apply, hamiltonianFlow_apply]
  have hprod : cpowI (gibbsWeightsE β E logZ i) s
        * cpowI (gibbsWeightsE β E logZ j) (-s)
      = Complex.exp (-(Complex.I * (((β * s : ℝ)) : ℂ) * ((E i : ℂ))))
        * Complex.exp (Complex.I * (((β * s : ℝ)) : ℂ) * ((E j : ℂ))) := by
    unfold cpowI
    rw [gibbsWeightsE_log, gibbsWeightsE_log,
      ← Complex.exp_add, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [show cpowI (gibbsWeightsE β E logZ i) s * a i j
        * cpowI (gibbsWeightsE β E logZ j) (-s)
      = (cpowI (gibbsWeightsE β E logZ i) s
        * cpowI (gibbsWeightsE β E logZ j) (-s)) * a i j from by ring,
    hprod]
  ring

/-- The Gibbs clock does not depend on the partition-function
    convention, general energies (Tier T1 — proved): shifting `logZ`
    rescales all weights by one positive constant, and rescaling
    weights does not change the flow (`diagFlow_scale_weights`). -/
theorem diagFlow_gibbsWeightsE_logZ_independent (β : ℝ) (E : Fin N → ℝ)
    (logZ logZ' : ℝ) (s : ℝ) (a : Matrix (Fin N) (Fin N) ℂ) :
    diagFlow (gibbsWeightsE β E logZ') s a
      = diagFlow (gibbsWeightsE β E logZ) s a := by
  have hscale : (fun j => Real.exp (logZ - logZ') * gibbsWeightsE β E logZ j)
      = gibbsWeightsE β E logZ' := by
    funext j
    simp only [gibbsWeightsE]
    rw [← Real.exp_add]
    congr 1
    ring
  rw [← hscale]
  exact diagFlow_scale_weights _ (Real.exp_pos _)
    (fun j => gibbsWeightsE_pos β E logZ j) s a

end DiagonalFlow

-- ============================================================================
-- §3. The Gibbs clock, packaged; the two Gibbs constructions agree
-- ============================================================================

section GibbsClockPackage

variable {N : ℕ}

/-- The partition sum of the diagonal Hamiltonian `E` at inverse
    temperature `β`, as it appears inside the normalizing `logZ`. -/
theorem gibbsSum_pos [NeZero N] (β : ℝ) (E : Fin N → ℝ) :
    0 < ∑ j, Real.exp (-(β * E j)) := by
  apply Finset.sum_pos (fun j _ => Real.exp_pos _)
  exact Finset.univ_nonempty_iff.mpr ⟨⟨0, NeZero.pos N⟩⟩

/-- **The Gibbs clock of a diagonal Hamiltonian** (Tier T2 — definition):
    the `ThermalClock` whose weights are the Gibbs weights of `E` at
    inverse temperature `β`, with `logZ` chosen as the log of the
    partition sum — the choice that makes the weights a state
    (faithful by `gibbsWeightsE_pos`, normalized by the computation in
    the `normalized` field). This is the span's named exhibit object:
    the Gibbs special case of the Schrödinger row, packaged as one of
    the corpus's own clocks. -/
noncomputable def gibbsClockOf [NeZero N] (β : ℝ) (E : Fin N → ℝ) :
    ThermalClock N where
  weights := gibbsWeightsE β E (Real.log (∑ j, Real.exp (-(β * E j))))
  faithful := fun j => gibbsWeightsE_pos _ _ _ j
  normalized := by
    have hS : 0 < ∑ j, Real.exp (-(β * E j)) := gibbsSum_pos β E
    have hterm : ∀ j : Fin N,
        gibbsWeightsE β E (Real.log (∑ j, Real.exp (-(β * E j)))) j
          = Real.exp (-(β * E j)) * (∑ j, Real.exp (-(β * E j)))⁻¹ := by
      intro j
      simp only [gibbsWeightsE]
      have hexp : Real.exp (-(Real.log (∑ j, Real.exp (-(β * E j)))))
          = (∑ j, Real.exp (-(β * E j)))⁻¹ := by
        rw [Real.exp_neg, Real.exp_log hS]
      rw [show -(β * E j + Real.log (∑ j, Real.exp (-(β * E j))))
          = -(β * E j) + -(Real.log (∑ j, Real.exp (-(β * E j)))) by ring,
        Real.exp_add, hexp]
    rw [Finset.sum_congr rfl (fun j _ => hterm j), ← Finset.sum_mul,
      mul_inv_cancel₀ (ne_of_gt hS)]

/-- The Gibbs clock's state is the diagonal Gibbs state
    (Tier T1 — proved): `(gibbsClockOf β E).state = diag(weights)`. -/
theorem gibbsClockOf_state [NeZero N] (β : ℝ) (E : Fin N → ℝ) :
    (gibbsClockOf β E).state
      = diagState (gibbsWeightsE β E
          (Real.log (∑ j, Real.exp (-(β * E j))))) :=
  rfl

/-- **The Gibbs clock's modular Hamiltonian** (Tier T1 — proved):
    `K = β • diagonal E + (log (partition sum)) • 1` — Target 1 read
    off the packaged clock, the free-energy scalar on the face. -/
theorem gibbsClockOf_K [NeZero N] (β : ℝ) (E : Fin N → ℝ) :
    (gibbsClockOf β E).K
      = (β : ℂ) • Matrix.diagonal (fun j => (E j : ℂ))
        + ((Real.log (∑ j, Real.exp (-(β * E j))) : ℝ) : ℂ) • 1 :=
  diagModularK_gibbsWeightsE β E _

/-- **The Gibbs clock's flow is laboratory time evolution at rate β**
    (Tier T1 — proved): `(gibbsClockOf β E).flow s
    = hamiltonianFlow E (β * s)` — the span's headline in the
    eigenbasis picture, for the packaged clock. -/
theorem gibbsClockOf_flow [NeZero N] (β : ℝ) (E : Fin N → ℝ) (s : ℝ)
    (a : Matrix (Fin N) (Fin N) ℂ) :
    (gibbsClockOf β E).flow s a = hamiltonianFlow E (β * s) a :=
  diagFlow_gibbsWeightsE β E _ s a

/-- The partition function of a diagonal Hamiltonian, in the matrix
    (KMSBridge) construction (Tier T1 — proved):
    `gibbsZ (diagonal E) β` is the cast of the real partition sum
    `∑ j, exp(−β • E_j)`. -/
theorem gibbsZ_diagonal (β : ℝ) (E : Fin N → ℝ) :
    gibbsZ (Matrix.diagonal (fun j => (E j : ℂ))) β
      = ((∑ j, Real.exp (-(β * E j)) : ℝ) : ℂ) := by
  have hsmul : (-(β : ℂ)) • Matrix.diagonal (fun j => (E j : ℂ))
      = Matrix.diagonal (fun j => (-(β : ℂ)) * (E j : ℂ)) := by
    ext i j
    by_cases h : i = j
    · subst h
      simp [Matrix.diagonal_apply_eq, Matrix.smul_apply, smul_eq_mul]
    · simp [Matrix.diagonal_apply, h, Matrix.smul_apply, smul_eq_mul]
  have hkey : ∀ j : Fin N,
      NormedSpace.exp ((-(β : ℂ)) * (E j : ℂ))
        = ((Real.exp (-(β * E j)) : ℝ) : ℂ) := by
    intro j
    have harg : (-(β : ℂ)) * (E j : ℂ) = ((-(β * E j) : ℝ) : ℂ) := by
      push_cast
      ring
    rw [harg, Complex.ofReal_exp]
    exact congrFun Complex.exp_eq_exp_ℂ.symm _
  unfold gibbsZ gibbsWeight
  rw [hsmul, Matrix.exp_diagonal]
  have hfun : NormedSpace.exp (fun j => (-(β : ℂ)) * (E j : ℂ))
      = (fun j => ((Real.exp (-(β * E j)) : ℝ) : ℂ)) := by
    funext j
    rw [Pi.coe_exp]
    exact hkey j
  rw [hfun, Matrix.trace_diagonal]
  exact (RCLike.ofReal_sum Finset.univ _).symm

/-- **The two Gibbs constructions agree** (Tier T1 — proved): for a
    diagonal Hamiltonian, the matrix Gibbs state of `KMSBridge`
    (`gibbsState (diagonal E) β = e^{−βH}/Z`) IS the diagonal Gibbs
    state of the eigenbasis construction — the state of
    `gibbsClockOf β E`. The span's two ends are the same state. -/
theorem gibbsState_diagonal [NeZero N] (β : ℝ) (E : Fin N → ℝ) :
    gibbsState (Matrix.diagonal (fun j => (E j : ℂ))) β
      = diagState (gibbsWeightsE β E
          (Real.log (∑ j, Real.exp (-(β * E j))))) := by
  have hS : 0 < ∑ j, Real.exp (-(β * E j)) := gibbsSum_pos β E
  have hsmul : (-(β : ℂ)) • Matrix.diagonal (fun j => (E j : ℂ))
      = Matrix.diagonal (fun j => (-(β : ℂ)) * (E j : ℂ)) := by
    ext i j
    by_cases h : i = j
    · subst h
      simp [Matrix.diagonal_apply_eq, Matrix.smul_apply, smul_eq_mul]
    · simp [Matrix.diagonal_apply, h, Matrix.smul_apply, smul_eq_mul]
  have hkey : ∀ j : Fin N,
      NormedSpace.exp ((-(β : ℂ)) * (E j : ℂ))
        = ((Real.exp (-(β * E j)) : ℝ) : ℂ) := by
    intro j
    have harg : (-(β : ℂ)) * (E j : ℂ) = ((-(β * E j) : ℝ) : ℂ) := by
      push_cast
      ring
    rw [harg, Complex.ofReal_exp]
    exact congrFun Complex.exp_eq_exp_ℂ.symm _
  have hfun : NormedSpace.exp (fun j => (-(β : ℂ)) * (E j : ℂ))
      = (fun j => ((Real.exp (-(β * E j)) : ℝ) : ℂ)) := by
    funext j
    rw [Pi.coe_exp]
    exact hkey j
  have hw : gibbsWeight (Matrix.diagonal (fun j => (E j : ℂ))) β
      = Matrix.diagonal (fun j => ((Real.exp (-(β * E j)) : ℝ) : ℂ)) := by
    unfold gibbsWeight
    rw [hsmul, Matrix.exp_diagonal, hfun]
  have hinv : (((∑ j, Real.exp (-(β * E j)) : ℝ) : ℂ))⁻¹
      = (((∑ j, Real.exp (-(β * E j)))⁻¹ : ℝ) : ℂ) := by
    exact_mod_cast (Complex.ofReal_inv _).symm
  have hentry : ∀ i : Fin N,
      (∑ j, Real.exp (-(β * E j)))⁻¹ * Real.exp (-(β * E i))
        = Real.exp (-(β * E i + Real.log (∑ j, Real.exp (-(β * E j))))) := by
    intro i
    have hexp : Real.exp (-(Real.log (∑ j, Real.exp (-(β * E j)))))
        = (∑ j, Real.exp (-(β * E j)))⁻¹ := by
      rw [Real.exp_neg, Real.exp_log hS]
    rw [show -(β * E i + Real.log (∑ j, Real.exp (-(β * E j))))
        = -(Real.log (∑ j, Real.exp (-(β * E j)))) + -(β * E i) by ring,
      Real.exp_add, hexp]
  unfold gibbsState
  rw [hw, gibbsZ_diagonal]
  ext i j
  by_cases h : i = j
  · subst h
    simp only [Matrix.smul_apply, Matrix.diagonal_apply_eq, smul_eq_mul,
      diagState, gibbsWeightsE]
    rw [hinv, ← Complex.ofReal_mul, hentry]
  · simp [Matrix.smul_apply, Matrix.diagonal_apply, h, diagState,
      gibbsWeightsE]

end GibbsClockPackage

-- ============================================================================
-- §4. The matrix picture: the built unitary evolution (Target 2, matrix form)
-- ============================================================================

section MatrixFlow

variable {N : ℕ} {H : Matrix (Fin N) (Fin N) ℂ}

/-- **The built Schrödinger unitary** (Tier T2 — definition):
    `U_H(t) = exp(−itH)` — the finite-level unitary time-evolution
    operator generated by `H`, in the corpus's units (`ħ = 1`; `ħ`
    itself has no seat and appears nowhere). -/
noncomputable def evolutionUnitary (H : Matrix (Fin N) (Fin N) ℂ) (t : ℝ) :
    Matrix (Fin N) (Fin N) ℂ :=
  NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H)

/-- **The built Heisenberg evolution** (Tier T2 — definition): the
    evolution of an observable under `H` at time `t`, in the
    Heisenberg form `A ↦ U(t)ᴴ A U(t)` with the built unitary. -/
noncomputable def heisenbergFlow (H : Matrix (Fin N) (Fin N) ℂ) (t : ℝ)
    (A : Matrix (Fin N) (Fin N) ℂ) : Matrix (Fin N) (Fin N) ℂ :=
  (evolutionUnitary H t)ᴴ * A * evolutionUnitary H t

/-- **The built Schrödinger evolution of a state** (Tier T2 —
    definition): `ρ ↦ U(t) ρ U(t)ᴴ` with the built unitary — the
    Schrödinger-picture companion of `heisenbergFlow`. -/
noncomputable def densityFlow (H : Matrix (Fin N) (Fin N) ℂ) (t : ℝ)
    (ρ : Matrix (Fin N) (Fin N) ℂ) : Matrix (Fin N) (Fin N) ℂ :=
  evolutionUnitary H t * ρ * (evolutionUnitary H t)ᴴ

/-- The adjoint of the built unitary (Tier T1 — proved): for
    Hermitian `H`, `U(t)ᴴ = exp(+itH)` — the evolution generated in
    the opposite time direction. -/
theorem evolutionUnitary_conjTranspose (hH : H.IsHermitian) (t : ℝ) :
    (evolutionUnitary H t)ᴴ
      = NormedSpace.exp ((Complex.I * (t : ℂ)) • H) := by
  have hstarH : star H = H := by
    rw [Matrix.star_eq_conjTranspose]
    exact hH.eq
  have hstarC : star (-(Complex.I * (t : ℂ))) = Complex.I * (t : ℂ) := by
    have eI : star (Complex.I : ℂ) = -Complex.I := Complex.conj_I
    have et : star ((t : ℂ)) = (t : ℂ) := by simp
    rw [star_neg, star_mul, eI, et]
    ring
  unfold evolutionUnitary
  rw [← Matrix.star_eq_conjTranspose, star_exp]
  congr 1
  rw [star_smul, hstarC, hstarH]

/-- The built evolution is unitary (Tier T1 — proved): for Hermitian
    `H`, `U(t)ᴴ U(t) = 1` and `U(t) U(t)ᴴ = 1`. -/
theorem evolutionUnitary_isUnitary (hH : H.IsHermitian) (t : ℝ) :
    (evolutionUnitary H t)ᴴ * evolutionUnitary H t = 1 ∧
      evolutionUnitary H t * (evolutionUnitary H t)ᴴ = 1 := by
  rw [evolutionUnitary_conjTranspose hH]
  unfold evolutionUnitary
  constructor
  · exact exp_smul_mul_exp_neg_smul H (Complex.I * (t : ℂ))
  · have h := exp_smul_mul_exp_neg_smul H (-(Complex.I * (t : ℂ)))
    rwa [neg_neg] at h

/-- The corpus's matrix modular flow IS the built Heisenberg
    evolution (Tier T1 — proved): for Hermitian `H`,
    `modularFlow H t A = U(t)ᴴ A U(t)` — an equality of the corpus's
    own flow (`modularFlow`, ThermalClock §3) with the explicitly
    built evolution, as matrices. -/
theorem modularFlow_eq_heisenbergFlow (hH : H.IsHermitian) (t : ℝ)
    (A : Matrix (Fin N) (Fin N) ℂ) :
    modularFlow H t A = heisenbergFlow H t A := by
  unfold heisenbergFlow
  rw [evolutionUnitary_conjTranspose hH]
  rfl

/-- **TARGET 2, matrix form — the span's headline** (Tier T1 —
    proved): for a Hermitian Hamiltonian `H`, the modular flow of the
    Gibbs state — generated by the FULL modular Hamiltonian
    `β • H + (logZ) • 1`, scalar term carried explicitly — at thermal
    time `s` is the built unitary time evolution generated by `H` at
    physical time `β • s`:

        `modularFlow (β • H + logZ • 1) s A = heisenbergFlow H (β • s) A`.

    Physical time = β × thermal time, in the matrix picture, for the
    Gibbs special case only — the general Schrödinger equation
    remains NO SEAT (header fence). The scalar term is discharged by
    the corpus's scalar-shift lemma, inside
    `gibbs_conversion_full_generator`; it is not dropped silently. -/
theorem gibbs_modularFlow_eq_heisenbergFlow (hH : H.IsHermitian)
    (β : ℝ) (logZ : ℂ) (s : ℝ) (A : Matrix (Fin N) (Fin N) ℂ) :
    modularFlow ((β : ℂ) • H + logZ • 1) s A
      = heisenbergFlow H (β * s) A := by
  rw [gibbs_conversion_full_generator, modularFlow_eq_heisenbergFlow hH]

/-- **The Gibbs state is stationary under its own evolution**
    (Tier T1 — proved), Schrödinger picture: the built density flow
    of the Gibbs state of `H` under the evolution generated by `H`
    itself is the identity — equilibrium does not evolve. The
    companion of `gibbsWeight_stationary` (KMSBridge), in the built
    `densityFlow` form. -/
theorem gibbsState_densityFlow_stationary (hH : H.IsHermitian) (β t : ℝ) :
    densityFlow H t (gibbsState H β) = gibbsState H β := by
  have hcomm : Commute ((-(β : ℂ)) • H)
      ((-(Complex.I * (t : ℂ))) • H) :=
    ((Commute.refl H).smul_left _).smul_right _
  have hswap : NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H)
        * NormedSpace.exp ((-(β : ℂ)) • H)
      = NormedSpace.exp ((-(β : ℂ)) • H)
        * NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H) := by
    rw [← Matrix.exp_add_of_commute _ _ hcomm,
      ← Matrix.exp_add_of_commute _ _ hcomm.symm, add_comm]
  have hunit : NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H)
        * NormedSpace.exp ((Complex.I * (t : ℂ)) • H) = 1 := by
    have h := exp_smul_mul_exp_neg_smul H (-(Complex.I * (t : ℂ)))
    rwa [neg_neg] at h
  unfold densityFlow gibbsState gibbsWeight
  rw [evolutionUnitary_conjTranspose hH]
  unfold evolutionUnitary
  calc NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H)
          * ((gibbsZ H β)⁻¹ • NormedSpace.exp ((-(β : ℂ)) • H))
          * NormedSpace.exp ((Complex.I * (t : ℂ)) • H)
      = (gibbsZ H β)⁻¹ • (NormedSpace.exp ((-(β : ℂ)) • H)
          * (NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H)
            * NormedSpace.exp ((Complex.I * (t : ℂ)) • H))) := by
        rw [Algebra.mul_smul_comm, hswap, smul_mul_assoc, Matrix.mul_assoc]
    _ = (gibbsZ H β)⁻¹ • NormedSpace.exp ((-(β : ℂ)) • H) := by
        rw [hunit, mul_one]

end MatrixFlow

-- ============================================================================
-- §5. General Hermitian H: the transport and the orientation dictionary
-- (Target 3)
-- ============================================================================

section HermitianTransport

variable {N : ℕ} [NeZero N] {H : Matrix (Fin N) (Fin N) ℂ}

/-- **The orientation dictionary** (Tier T1 — proved): for Hermitian
    `H`, the corpus's matrix modular flow is the transported
    eigenbasis flow (`genFlow`, HermitianReduction) at the NEGATED
    time:

        `modularFlow H t A = genFlow hH (−t) A`.

    The sign is the `K = −ln ρ` sign, recorded exactly: `modularFlow`
    conjugates by `exp(+itH)`; the eigenbasis flows (`phaseFlow`,
    `hamiltonianFlow`, `diagFlow`) conjugate by the inverse phase.
    Neither convention is wrong; their dictionary is this theorem. -/
theorem modularFlow_eq_genFlow_neg (hH : H.IsHermitian) (t : ℝ)
    (A : Matrix (Fin N) (Fin N) ℂ) :
    modularFlow H t A = genFlow hH (-t) A := by
  set U : Matrix (Fin N) (Fin N) ℂ := (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ) with hUdef
  have hstarU : star U * U = 1 := Unitary.coe_star_mul_self _
  have hUstar : U * star U = 1 := Unitary.coe_mul_star_self _
  -- The two exponentials of ±itH, in conjugated diagonal form.
  have hexp : ∀ z : ℂ, NormedSpace.exp (z • H)
      = U * Matrix.diagonal (fun j => NormedSpace.exp (z * ((hH.eigenvalues j : ℂ))))
        * star U := by
    intro z
    have hsmul : z • H
        = U * (z • Matrix.diagonal (fun j => ((hH.eigenvalues j : ℂ)))) * star U := by
      conv_lhs => rw [hermitian_spectral_form hH]
      rw [mul_smul_comm, smul_mul_assoc]
    have hdiag : z • Matrix.diagonal (fun j => ((hH.eigenvalues j : ℂ)))
        = Matrix.diagonal (fun j => z * ((hH.eigenvalues j : ℂ))) := by
      ext i j
      by_cases h : i = j
      · subst h
        simp [Matrix.diagonal_apply_eq, Matrix.smul_apply, smul_eq_mul]
      · simp [Matrix.diagonal_apply, h, Matrix.smul_apply, smul_eq_mul]
    have hfun : NormedSpace.exp (fun j => z * ((hH.eigenvalues j : ℂ)))
        = (fun j => NormedSpace.exp (z * ((hH.eigenvalues j : ℂ)))) := by
      funext j
      rw [Pi.coe_exp]
    rw [hsmul, exp_conj_star _ _ hstarU hUstar, hdiag, Matrix.exp_diagonal, hfun]
  -- The diagonal phase factors of `phaseFlow` at `−t`.
  have hdpos : Matrix.diagonal
        (fun j => NormedSpace.exp ((Complex.I * (t : ℂ)) * ((hH.eigenvalues j : ℂ))))
      = Matrix.diagonal
        (fun j => Complex.exp (-(Complex.I * (((-t : ℝ)) : ℂ)
          * ((hH.eigenvalues j : ℂ))))) := by
    congr 1
    funext j
    have harg : (Complex.I * (t : ℂ)) * ((hH.eigenvalues j : ℂ))
        = -(Complex.I * (((-t : ℝ)) : ℂ) * ((hH.eigenvalues j : ℂ))) := by
      push_cast
      ring
    rw [harg]
    exact congrFun Complex.exp_eq_exp_ℂ.symm _
  have hdneg : Matrix.diagonal
        (fun j => NormedSpace.exp ((-(Complex.I * (t : ℂ))) * ((hH.eigenvalues j : ℂ))))
      = Matrix.diagonal
        (fun j => Complex.exp (Complex.I * (((-t : ℝ)) : ℂ)
          * ((hH.eigenvalues j : ℂ)))) := by
    congr 1
    funext j
    have harg : (-(Complex.I * (t : ℂ))) * ((hH.eigenvalues j : ℂ))
        = Complex.I * (((-t : ℝ)) : ℂ) * ((hH.eigenvalues j : ℂ)) := by
      push_cast
      ring
    rw [harg]
    exact congrFun Complex.exp_eq_exp_ℂ.symm _
  unfold modularFlow genFlow phaseFlow
  rw [hexp (Complex.I * (t : ℂ)), hexp (-(Complex.I * (t : ℂ))), hdpos, hdneg]
  simp only [Matrix.mul_assoc]
  rw [hUdef]

/-- **The Gibbs flow in the eigenbasis** (Tier T1 — proved): pulling
    the modular flow of the full Gibbs generator back into the
    eigenbasis of a Hermitian `H` gives the laboratory flow of the
    eigenvalues — the eigenbasis picture of the span's headline, for
    general Hermitian `H` (Target 3). The time appears as `−(β • s)`:
    `hamiltonianFlow` carries the eigenbasis orientation (see the
    orientation dictionary, `modularFlow_eq_genFlow_neg`); the
    matching `+β • s` statement in the `diagFlow` picture is
    `gibbs_two_pictures` below. -/
theorem gibbs_flow_eigenbasis (hH : H.IsHermitian) (β : ℝ) (logZ : ℂ)
    (s : ℝ) (A : Matrix (Fin N) (Fin N) ℂ) :
    star (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ)
        * modularFlow ((β : ℂ) • H + logZ • 1) s A
        * (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ)
      = hamiltonianFlow hH.eigenvalues (-(β * s))
          (star (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ) * A
            * (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ)) := by
  rw [gibbs_conversion_full_generator, modularFlow_eq_genFlow_neg hH,
    genFlow_eigenbasis, phaseFlow_eq_hamiltonianFlow]

/-- **The two pictures of the Gibbs flow, in one statement**
    (Tier T1 — proved): the matrix picture of the Gibbs flow, pulled
    into the eigenbasis, equals the eigenbasis picture (`diagFlow`)
    of the Gibbs weights of the eigenvalues at the negated thermal
    time — the orientation dictionary applied to the span. Together
    with `diagFlow_gibbsWeightsE` (which evaluates the right side as
    `hamiltonianFlow (eigenvalues) (β • (−s))`), this says the two
    corpus pictures of the one Gibbs flow agree exactly, sign
    included. Gibbs states only; general Hermitian `H`; the scalar
    `logZ` is the same free parameter on both sides. -/
theorem gibbs_two_pictures (hH : H.IsHermitian) (β : ℝ) (logZ : ℝ)
    (s : ℝ) (A : Matrix (Fin N) (Fin N) ℂ) :
    star (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ)
        * modularFlow ((β : ℂ) • H + ((logZ : ℂ)) • 1) s A
        * (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ)
      = diagFlow (gibbsWeightsE β hH.eigenvalues logZ) (-s)
          (star (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ) * A
            * (hH.eigenvectorUnitary : Matrix (Fin N) (Fin N) ℂ)) := by
  rw [gibbs_flow_eigenbasis hH β ((logZ : ℂ)) s A,
    diagFlow_gibbsWeightsE β hH.eigenvalues logZ (-s) _,
    show β * (-s) = -(β * s) by ring]

end HermitianTransport

