namespace ThetLogos

/-!
# Resonance spectrum: organisation is the fixed-point set, resonance is the gap set (T1, finite level)

Origin (Jeff, 2026-10-18): "instead of an orbifold we are electro
resonance field operators." The gauntlet was "prove it." This module
is the finite operator content of that sentence, proved at T1 — and
nothing more than that content. The sentence splits into two claims,
and each gets its theorem:

* **Organisation.** An organised charge separation — here, a diagonal
  state: populations on the diagonal, no coherences — is *exactly*
  what the environment's operator cannot erase. Part I assembles the
  corpus's pieces (`DecoherenceToy.pinch_eq_self_iff`,
  `PreCompensation.dephase`) into the named statement: for every
  dephasing level `l ≠ 1`, the fixed points of `dephase l` are
  exactly the diagonal matrices — the eigenvalue-1 space of the
  channel is the organised set, at every nonzero forgetting strength
  at once. (At `l = 1` the channel is the identity, `dephase_one`:
  everything is fixed, the trivial endpoint.)

* **Resonance.** A system's own dynamics, generated by a diagonal
  generator with eigenvalues `lam`, moves each coherence `(i, j)` as
  a pure phase mode whose frequency is the **gap** `lam i − lam j`
  (Part II, the phase law). The set of gaps is the system's
  resonance spectrum. The stationary modes — unchanged at all times —
  are exactly the zero-gap modes. Hence the dynamical mirror of
  Part I: a matrix is fixed by the system's own flow at all times
  iff it is supported on the equal-eigenvalue blocks; and when the
  generator is nondegenerate, iff it is diagonal. Organisation is
  invariance under the environment's channel AND under the system's
  own dynamics — the same set, seen from the two sides.

Part III states the thermal instance in the corpus's own clock
objects: for a `ThermalClock`, the generator is `K = −ln ρ`, the
resonance gaps are the differences of the `-log` weights, and for
Gibbs weights the gaps are `β` times the laboratory (D²) gaps — the
conversion theorem of `ThermalClock` read as a frequency statement:
the thermal resonance spectrum is the laboratory spectrum rescaled
by `β`.

**Fences.** Finite level, finite index types throughout. The proved
core of Part II is the diagonal generator; a general Hermitian
generator reduces to it in its eigenbasis but that reduction is NOT
formalized here (named, not hidden). No continuum field is
constructed. This module is NOT a claim that the finite objects here
are electromagnetism: the EM reading of Jeff's sentence stays T5.
What stands at T1 is the operator content: fixed points = the
organised set; frequencies = the generator's gap set.
-/

-- ============================================================================
-- Part I. Organisation: fixed points of the dephasing family
-- ============================================================================

section Organisation

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **Organisation, channel form (Tier T1 — proved).** For every
dephasing level `l ≠ 1`, the fixed points of `dephase l` are exactly
the diagonal matrices: a matrix is unchanged by the channel iff it
has no off-diagonal entries at all. The organised set is the
eigenvalue-1 space of the environment's operator, at every level
`l ≠ 1` simultaneously — including the full pinching `l = 0`, where
this restates `pinch_eq_self_iff`. -/
theorem dephase_fixed_iff_diagonal {l : ℝ} (hl : l ≠ 1) (A : Matrix ι ι ℂ) :
    dephase l A = A ↔ ∀ i j, i ≠ j → A i j = 0 := by
  constructor
  · intro h i j hij
    have h2 : dephase l A i j = A i j := by rw [h]
    rw [dephase_apply_off l A hij] at h2
    have hl1 : (l : ℂ) ≠ 1 := by exact_mod_cast hl
    have h3 : ((l : ℂ) - 1) * A i j = 0 := by
      rw [sub_mul, one_mul, sub_eq_zero]; exact h2
    rcases mul_eq_zero.mp h3 with h4 | h4
    · exact absurd (eq_of_sub_eq_zero h4) hl1
    · exact h4
  · intro h
    ext i j
    by_cases hij : i = j
    · subst hij; exact dephase_diag l A i
    · rw [dephase_apply_off l A hij, h i j hij, mul_zero]

/-- The dephasing family at any level `l ≠ 1` has the SAME fixed-point
set as the pinching: partial forgetting erases exactly what full
forgetting erases, no more and no less (Tier T1 — proved). -/
theorem dephase_fixed_iff_pinch_fixed {l : ℝ} (hl : l ≠ 1) (A : Matrix ι ι ℂ) :
    dephase l A = A ↔ pinch A = A := by
  rw [dephase_fixed_iff_diagonal hl, pinch_eq_self_iff]

end Organisation

-- ============================================================================
-- Part II. Resonance: the phase law and the gap set
-- ============================================================================

section Resonance

/-- **The resonance spectrum** of a diagonal generator: the set of
eigenvalue gaps `lam i − lam j` over all pairs. Tier T2 (definition). -/
def resonanceSpectrum {ι : Type*} (lam : ι → ℝ) : Set ℝ :=
  Set.range (fun p : ι × ι => lam p.1 - lam p.2)

/-- Every eigenvalue gap is a member of the resonance spectrum
(Tier T1 — proved). -/
theorem gap_mem_resonanceSpectrum {ι : Type*} (lam : ι → ℝ) (i j : ι) :
    lam i - lam j ∈ resonanceSpectrum lam :=
  ⟨(i, j), rfl⟩

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The flow of a diagonal generator with eigenvalue function `lam`:
conjugation by the diagonal phase unitary `exp(−it·diag(lam))`, in the
eigenbasis. This is the general-finite-index form of the corpus's
`hamiltonianFlow` (the bridge is `phaseFlow_eq_hamiltonianFlow`
below). Tier T2 (definition). -/
noncomputable def phaseFlow (lam : ι → ℝ) (t : ℝ) (A : Matrix ι ι ℂ) :
    Matrix ι ι ℂ :=
  diagonal (fun j => Complex.exp (-(Complex.I * (t : ℂ) * (lam j : ℂ)))) * A
    * diagonal (fun j => Complex.exp (Complex.I * (t : ℂ) * (lam j : ℂ)))

/-- The bridge to the corpus: on `Fin N`, `phaseFlow` IS
`ThermalClock`'s `hamiltonianFlow`, definitionally (Tier T1). -/
theorem phaseFlow_eq_hamiltonianFlow {N : ℕ} (lam : Fin N → ℝ) (t : ℝ)
    (A : Matrix (Fin N) (Fin N) ℂ) :
    phaseFlow lam t A = hamiltonianFlow lam t A := rfl

/-- **The phase law (Tier T1 — proved).** Under the flow of a diagonal
generator, every matrix entry is a pure phase mode: the `(i, j)`
coherence is multiplied by `exp(−it(lam i − lam j))`. The diagonal
entries (gap zero) never move; a coherence between distinct levels
rotates at exactly the gap frequency. -/
theorem phaseFlow_apply (lam : ι → ℝ) (t : ℝ) (A : Matrix ι ι ℂ) (i j : ι) :
    phaseFlow lam t A i j
      = Complex.exp (-(Complex.I * (t : ℂ) * ((lam i : ℂ) - (lam j : ℂ)))) * A i j := by
  have hexp : Complex.exp (-(Complex.I * (t : ℂ) * (lam i : ℂ)))
        * Complex.exp (Complex.I * (t : ℂ) * (lam j : ℂ))
      = Complex.exp (-(Complex.I * (t : ℂ) * ((lam i : ℂ) - (lam j : ℂ)))) := by
    rw [← Complex.exp_add]; congr 1; ring
  have hentry : phaseFlow lam t A i j
      = (Complex.exp (-(Complex.I * (t : ℂ) * (lam i : ℂ)))
        * Complex.exp (Complex.I * (t : ℂ) * (lam j : ℂ))) * A i j := by
    unfold phaseFlow
    rw [mul_diagonal, diagonal_mul]
    ring
  rw [hentry, hexp]

/-- **Stationarity, entry form (Tier T1 — proved).** A single entry
`(i, j)` is unmoved by the flow at ALL times iff it is a zero-gap
mode (`lam i = lam j`) or it is zero. If the gap is nonzero, the time
`t = π/(gap)` rotates the entry by the phase `exp(−iπ) = −1`, which
moves every nonzero entry — so no nonzero off-gap coherence can be
stationary. -/
theorem phaseFlow_apply_eq_iff (lam : ι → ℝ) (A : Matrix ι ι ℂ) (i j : ι) :
    (∀ t : ℝ, phaseFlow lam t A i j = A i j) ↔ (lam i = lam j ∨ A i j = 0) := by
  constructor
  · intro h
    by_contra hcon
    push Not at hcon
    obtain ⟨hgap, hA⟩ := hcon
    have hg : lam i - lam j ≠ 0 := sub_ne_zero.mpr hgap
    have ht := h (Real.pi / (lam i - lam j))
    rw [phaseFlow_apply] at ht
    have hexp : Complex.exp (-(Complex.I * ((Real.pi / (lam i - lam j) : ℝ) : ℂ)
          * ((lam i : ℂ) - (lam j : ℂ)))) = -1 := by
      rw [← Complex.ofReal_sub, mul_assoc, ← Complex.ofReal_mul,
        div_mul_cancel₀ Real.pi hg, mul_comm Complex.I (Real.pi : ℂ),
        Complex.exp_neg, Complex.exp_pi_mul_I]
      simp
    rw [hexp, neg_one_mul] at ht
    -- ht : -A i j = A i j, with A i j ≠ 0 — contradiction
    have h2 : (2 : ℂ) * A i j = 0 := by
      have hsum : A i j + A i j = 0 := by
        nth_rewrite 1 [← ht]
        exact neg_add_cancel _
      rw [two_mul]; exact hsum
    rcases mul_eq_zero.mp h2 with h3 | h3
    · norm_num at h3
    · exact hA h3
  · rintro (h | h)
    · intro t
      rw [phaseFlow_apply, h]
      simp
    · intro t
      rw [phaseFlow_apply, h, mul_zero]

/-- **Stationarity (Tier T1 — proved).** A matrix is fixed by the
system's own flow at all times iff every entry between distinct
generator levels vanishes: it is supported on the equal-eigenvalue
blocks. The organised states are exactly the flow's stationary
states — the dynamical mirror of Part I (`dephase_fixed_iff_diagonal`),
where the same set was characterised as the fixed points of the
environment's channel. -/
theorem phaseFlow_stationary_iff (lam : ι → ℝ) (A : Matrix ι ι ℂ) :
    (∀ t : ℝ, phaseFlow lam t A = A)
      ↔ ∀ i j, lam i ≠ lam j → A i j = 0 := by
  constructor
  · intro h i j hij
    have hentry : ∀ t : ℝ, phaseFlow lam t A i j = A i j := fun t => by rw [h t]
    rcases (phaseFlow_apply_eq_iff lam A i j).mp hentry with h1 | h1
    · exact absurd h1 hij
    · exact h1
  · intro h t
    ext i j
    by_cases hij : lam i = lam j
    · exact (phaseFlow_apply_eq_iff lam A i j).mpr (Or.inl hij) t
    · exact (phaseFlow_apply_eq_iff lam A i j).mpr (Or.inr (h i j hij)) t

/-- **Stationarity, nondegenerate case (Tier T1 — proved).** When the
generator's eigenvalues are all distinct, the stationary states of
the flow are exactly the diagonal matrices — word for word the
channel characterisation of Part I (`dephase_fixed_iff_diagonal`).
Degeneracy is the only thing that lets a stationary coherence live
off the diagonal, and it lives inside an equal-eigenvalue block
(`phaseFlow_stationary_iff`). -/
theorem phaseFlow_stationary_iff_diagonal {lam : ι → ℝ}
    (hlam : Function.Injective lam) (A : Matrix ι ι ℂ) :
    (∀ t : ℝ, phaseFlow lam t A = A) ↔ ∀ i j, i ≠ j → A i j = 0 := by
  rw [phaseFlow_stationary_iff]
  constructor
  · intro h i j hij
    exact h i j (fun he => hij (hlam he))
  · intro h i j hne
    exact h i j (fun he => hne (congrArg lam he))

end Resonance

-- ============================================================================
-- Part III. The thermal instance: the clock's resonance spectrum
-- ============================================================================

section Thermal

/-- **Phase law for the corpus's modular flow (Tier T1 — proved).**
For the eigenbasis flow `diagFlow` of a state with weights `w`
(the flow of `ModularTime`/`ThermalClock`), the `(i, j)` entry is a
pure phase mode with exponent `s·(log w_i − log w_j)`: the resonance
frequencies of a state are the differences of the logs of its
weights. -/
theorem diagFlow_phase {N : ℕ} (w : Fin N → ℝ) (s : ℝ)
    (a : Matrix (Fin N) (Fin N) ℂ) (i j : Fin N) :
    diagFlow w s a i j
      = Complex.exp (Complex.I * (s : ℂ)
          * ((Real.log (w i) : ℂ) - (Real.log (w j) : ℂ))) * a i j := by
  have hexp : cpowI (w i) s * cpowI (w j) (-s)
      = Complex.exp (Complex.I * (s : ℂ)
          * ((Real.log (w i) : ℂ) - (Real.log (w j) : ℂ))) := by
    unfold cpowI
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc diagFlow w s a i j
      = cpowI (w i) s * a i j * cpowI (w j) (-s) := diagFlow_apply w s a i j
    _ = (cpowI (w i) s * cpowI (w j) (-s)) * a i j := by ring
    _ = Complex.exp (Complex.I * (s : ℂ)
          * ((Real.log (w i) : ℂ) - (Real.log (w j) : ℂ))) * a i j := by
        rw [hexp]

/-- The corpus's modular flow IS the phase flow of its generator
`K = −ln ρ`, read in the eigenbasis (Tier T1 — proved): `diagFlow w`
is `phaseFlow` at the eigenvalue function `j ↦ −log (w j)`. -/
theorem diagFlow_eq_phaseFlow {N : ℕ} (w : Fin N → ℝ) (s : ℝ)
    (a : Matrix (Fin N) (Fin N) ℂ) :
    diagFlow w s a = phaseFlow (fun j => -Real.log (w j)) s a := by
  ext i j
  rw [diagFlow_phase, phaseFlow_apply]
  congr 1
  · congr 1
    push_cast
    ring

/-- The same identification for a packaged `ThermalClock`
(Tier T1 — proved): the clock's flow is the phase flow of its own
`K = −ln ρ`. -/
theorem thermalClock_flow_eq_phaseFlow {N : ℕ} (C : ThermalClock N) (s : ℝ)
    (a : Matrix (Fin N) (Fin N) ℂ) :
    C.flow s a = phaseFlow (fun j => -Real.log (C.weights j)) s a :=
  diagFlow_eq_phaseFlow C.weights s a

/-- **The thermal phase law (Tier T1 — proved).** Under a thermal
clock's flow, the `(i, j)` coherence rotates at the frequency
`K_i − K_j`, the gap of the clock's generator `K = −ln ρ`:
`(flow s a) i j = exp(−is(K_i − K_j)) · a i j`. The resonance
spectrum of the state ρ is the gap set of `−ln ρ`. -/
theorem thermalClock_phase {N : ℕ} (C : ThermalClock N) (s : ℝ)
    (a : Matrix (Fin N) (Fin N) ℂ) (i j : Fin N) :
    C.flow s a i j
      = Complex.exp (-(Complex.I * (s : ℂ)
          * (((-Real.log (C.weights i) : ℝ) : ℂ)
            - ((-Real.log (C.weights j) : ℝ) : ℂ)))) * a i j := by
  rw [thermalClock_flow_eq_phaseFlow]
  exact phaseFlow_apply _ _ _ _ _

/-- **Thermal stationarity (Tier T1 — proved).** A matrix is fixed by
a thermal clock's flow at all thermal times iff every entry between
levels of distinct weight vanishes. For a clock with all weights
distinct, the stationary states of the clock are exactly the
diagonal matrices — the organised set of Part I, a third time, now
as the fixed points of the state's own clock. -/
theorem thermalClock_stationary_iff {N : ℕ} (C : ThermalClock N)
    (a : Matrix (Fin N) (Fin N) ℂ) :
    (∀ s : ℝ, C.flow s a = a)
      ↔ ∀ i j, C.weights i ≠ C.weights j → a i j = 0 := by
  have hlog : ∀ i j : Fin N,
      (-Real.log (C.weights i)) ≠ (-Real.log (C.weights j))
        ↔ C.weights i ≠ C.weights j := by
    intro i j
    constructor
    · intro h he
      exact h (by rw [he])
    · intro h he
      exact h (Real.log_injOn_pos (Set.mem_Ioi.mpr (C.faithful i))
        (Set.mem_Ioi.mpr (C.faithful j)) (neg_injective he))
  have hiff : (∀ s : ℝ, C.flow s a = a)
      ↔ ∀ i j, (-Real.log (C.weights i)) ≠ (-Real.log (C.weights j))
          → a i j = 0 := by
    rw [← phaseFlow_stationary_iff]
    exact forall_congr' fun s => by rw [thermalClock_flow_eq_phaseFlow]
  rw [hiff]
  constructor
  · intro h i j hij
    exact h i j ((hlog i j).mpr hij)
  · intro h i j hij
    exact h i j ((hlog i j).mp hij)

/-- **The Gibbs resonance law (Tier T1 — proved).** For Gibbs weights
at inverse temperature `β` over a Dirac operator with eigenvalues
`lam`, the `(i, j)` coherence of the thermal flow rotates at the
frequency `β·(lam i² − lam j²)`: the thermal resonance spectrum is
the laboratory (D²) gap set rescaled by `β`. This is the
`ThermalClock` conversion theorem (`gibbs_K_eigenvalue_diff`) read
as a statement about frequencies. -/
theorem gibbs_resonance_phase {N : ℕ} (β : ℝ) (lam : Fin N → ℝ) (logZ : ℝ)
    (s : ℝ) (a : Matrix (Fin N) (Fin N) ℂ) (i j : Fin N) :
    diagFlow (gibbsDiagWeights β lam logZ) s a i j
      = Complex.exp (-(Complex.I * (s : ℂ)
          * ((β : ℂ) * ((lam i : ℂ) ^ 2 - (lam j : ℂ) ^ 2)))) * a i j := by
  rw [diagFlow_phase]
  have hd : (-Real.log (gibbsDiagWeights β lam logZ i))
        - (-Real.log (gibbsDiagWeights β lam logZ j))
      = β * (lam i ^ 2 - lam j ^ 2) := gibbs_K_eigenvalue_diff β lam logZ i j
  have hlog : Real.log (gibbsDiagWeights β lam logZ i)
        - Real.log (gibbsDiagWeights β lam logZ j)
      = -(β * (lam i ^ 2 - lam j ^ 2)) := by linarith
  rw [← Complex.ofReal_sub, hlog]
  congr 1
  · congr 1
    push_cast
    ring

/-- **Gibbs stationarity (Tier T1 — proved).** A matrix is fixed by
a Gibbs clock's flow at all thermal times iff every entry between
levels of distinct `β·lam²` vanishes — stationarity read in the
laboratory generator's own levels. -/
theorem gibbs_stationary_iff {N : ℕ} (β : ℝ) (lam : Fin N → ℝ) (logZ : ℝ)
    (a : Matrix (Fin N) (Fin N) ℂ) :
    (∀ s : ℝ, diagFlow (gibbsDiagWeights β lam logZ) s a = a)
      ↔ ∀ i j, β * lam i ^ 2 ≠ β * lam j ^ 2 → a i j = 0 := by
  have hconv : ∀ i j : Fin N,
      (-Real.log (gibbsDiagWeights β lam logZ i))
        ≠ (-Real.log (gibbsDiagWeights β lam logZ j))
        ↔ β * lam i ^ 2 ≠ β * lam j ^ 2 := by
    intro i j
    have hd := gibbs_K_eigenvalue_diff β lam logZ i j
    rw [← sub_ne_zero, hd, mul_sub]
    exact sub_ne_zero
  have hiff : (∀ s : ℝ, diagFlow (gibbsDiagWeights β lam logZ) s a = a)
      ↔ ∀ i j, (-Real.log (gibbsDiagWeights β lam logZ i))
          ≠ (-Real.log (gibbsDiagWeights β lam logZ j)) → a i j = 0 := by
    rw [← phaseFlow_stationary_iff]
    exact forall_congr' fun s => by rw [diagFlow_eq_phaseFlow]
  rw [hiff]
  constructor
  · intro h i j hij
    exact h i j ((hconv i j).mpr hij)
  · intro h i j hij
    exact h i j ((hconv i j).mp hij)

end Thermal

end ThetLogos
