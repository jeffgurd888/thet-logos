namespace ThetLogos

section ThermalAcoustic

variable {ι : Type*} [Fintype ι]

/-- **The resonance gap set of a diagonal generator**
    (Tier T2 — definition): the set of eigenvalue
    differences `lam i − lam j` — the tone shore's native
    object, in the corpus's own vocabulary ("the gap set
    IS the resonance spectrum", `ResonanceSpectrum`
    Part II). -/
def resonanceGapSet (lam : ι → ℝ) : Set ℝ :=
  Set.range (fun p : ι × ι => lam p.1 - lam p.2)

/-- **TAB-0, the bridge form** (Tier T5 — statement form):
    the thermal instance in one line — the gap set of the
    β-rescaled generator is the β-image of the gap set.
    The content is landed T1 at the diagonal seat
    (`ResonanceSpectrum` Part III, in the corpus's clock
    objects: for Gibbs weights the gaps are β times the
    laboratory gaps); this form registers the shape the
    TAB-1/TAB-2 extensions consume. -/
def TabBridgeForm : Prop :=
  ∀ (lam : ι → ℝ) (β : ℝ),
    resonanceGapSet (fun i => β * lam i)
      = (fun x => β * x) '' resonanceGapSet lam

/-- **TAB-0, the Partner-residue form** (Tier T5 —
    statement form): the thermal reading of a spectral
    coincidence, in gap language — IF two sectors' gap
    sets agree, THEN their β-rescalings agree at every β.
    This is the shape SP-5's tone content would feed a
    thermal reading (the real SP-5 is charpoly-grade,
    with multiplicities — `sp5_charpoly_identity` — and
    the Gibbs clocks on `vertexHam`/`edgeHam` that would
    consume it are TAB-1, unbuilt). -/
def TabPartnerGapForm : Prop :=
  ∀ {κ : Type*} [Fintype κ] (lamV : ι → ℝ) (lamE : κ → ℝ),
    resonanceGapSet lamV = resonanceGapSet lamE →
    ∀ β : ℝ, resonanceGapSet (fun i => β * lamV i)
      = resonanceGapSet (fun j => β * lamE j)

end ThermalAcoustic

end ThetLogos
