/-! ## The wave family: a citation-registration of `evolOp` -/

/-- **The line's wave family (registered
CITATION-REGISTRATION).** For a symmetric operator `T` on
a finite-dimensional complex inner product space `H`,
`waveFamily hT t` IS the landed evolution operator
`evolOp hT t` of `SchrodingerDynamics` - cited, not
rebuilt. The registration's content is exactly: the
family is `evolOp hT` for the named symmetric operator
`hT`. Its group law, isometry, and unitary packaging are
the landed `evolOp_add`, `evolOp_isometry`, and
`evolUnitary`, cited by the read-backs below. Per the
K-GR-SMUG instance (ii) fence on this module's face, no
object counts as this line's wave family without this
`evolOp` weld. -/
noncomputable def waveFamily {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
    {T : H →ₗ[ℂ] H} (hT : T.IsSymmetric) (t : ℝ) :
    H →ₗ[ℂ] H :=
  evolOp hT t

/-- **Read-back.** The wave family is exactly the cited
landed `evolOp`, unfolded. Pin-grade only: this exhibits
the citation; it asserts no new evolution fact. -/
theorem waveFamily_unfold {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
    {T : H →ₗ[ℂ] H} (hT : T.IsSymmetric) (t : ℝ) :
    waveFamily hT t = evolOp hT t :=
  rfl

/-- **Read-back, group law by citation.** The wave family
satisfies the one-parameter group law, by the landed
`evolOp_add` (SchrodingerDynamics line 219). Cited, not
re-proved. -/
theorem waveFamily_add {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
    {T : H →ₗ[ℂ] H} (hT : T.IsSymmetric) (s t : ℝ) :
    waveFamily hT (s + t)
      = (waveFamily hT s).comp (waveFamily hT t) :=
  evolOp_add hT s t

/-- **Read-back, isometry by citation.** The wave family
preserves norms, by the landed `evolOp_isometry`
(SchrodingerDynamics line 250). Cited, not re-proved. -/
theorem waveFamily_isometry {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
    {T : H →ₗ[ℂ] H} (hT : T.IsSymmetric) (t : ℝ) (x : H) :
    ‖waveFamily hT t x‖ = ‖x‖ :=
  evolOp_isometry hT t x

/-- **Read-back, value at time zero by citation.** The
wave family at time `0` is the identity, by the landed
`evolOp_zero`. Cited, not re-proved. -/
theorem waveFamily_zero {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
    {T : H →ₗ[ℂ] H} (hT : T.IsSymmetric) :
    waveFamily hT 0 = LinearMap.id :=
  evolOp_zero hT

/-- **Read-back, unitary packaging by citation.** The
landed unitary packaging `evolUnitary hT t`
(SchrodingerDynamics line 261) applies as the wave
family. Cited, not re-proved. -/
theorem waveFamily_unitary_apply {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [FiniteDimensional ℂ H] {T : H →ₗ[ℂ] H}
    (hT : T.IsSymmetric) (t : ℝ) (x : H) :
    evolUnitary hT t x = waveFamily hT t x :=
  rfl

/-! ## The mode/frequency vocabulary -/

/-- **A mode and its frequency (registered vocabulary).**
`ModeFreq S v omega` registers the pair `(v, omega)` as
a mode of the named operator `S`: `v` is nonzero and
`S v = omega * v` (scalar action), and `omega` is
registered as THE FREQUENCY of that mode. Registered
over an operator/eigenpair pair, for any scalar ring;
the line's uses are the real seat operator `maxwellOp N`
and, after the GR-PROP-1 complexification weld, its
complexification, whose frequencies are the real M5
eigenvalues named on this module's face. Per the
K-GR-SMUG instance (iii) fence: a frequency taken from
any other operator - a transfer operator, a modular
operator, any operator other than the named spatial seat
operator - is not a frequency in this line. No mode is
asserted to exist by this registration. -/
def ModeFreq {𝕜 : Type*} {E : Type*} [Semiring 𝕜]
    [AddCommMonoid E] [Module 𝕜 E] (S : E →ₗ[𝕜] E)
    (v : E) (ω : 𝕜) : Prop :=
  v ≠ 0 ∧ S v = ω • v

/-- **Read-back.** A mode/frequency registration is
exactly its eigenpair statement, unfolded. Pin-grade
only. -/
theorem modeFreq_unfold {𝕜 : Type*} {E : Type*}
    [Semiring 𝕜] [AddCommMonoid E] [Module 𝕜 E]
    (S : E →ₗ[𝕜] E) (v : E) (ω : 𝕜) :
    ModeFreq S v ω ↔ v ≠ 0 ∧ S v = ω • v :=
  Iff.rfl

/-! ## The frequency shift and the line's named perturbation -/

/-- **The frequency shift (registered).** For two named
operators `S` and `S'` on the same seat sharing the named
mode `v`, with `ModeFreq S v omega` and
`ModeFreq S' v omega'`, the frequency shift of that mode
from `S` to `S'` is the real number `omega' - omega`.
The sign is part of the number: a shift registered or
decided with the opposite sign is a different shift
(K-GR-STAB, on this module's face). The definition
records the operators and the mode it is indexed by;
its value is the difference of the two registered
frequencies. -/
def FreqShift {E : Type*} [AddCommGroup E] [Module ℝ E]
    (_S _S' : E →ₗ[ℝ] E) (_v : E) (ω ω' : ℝ) : ℝ :=
  ω' - ω

/-- **Read-back.** The frequency shift is exactly the
difference of the two registered frequencies, unfolded.
Pin-grade only. -/
theorem freqShift_unfold {E : Type*} [AddCommGroup E]
    [Module ℝ E] (S S' : E →ₗ[ℝ] E) (v : E) (ω ω' : ℝ) :
    FreqShift S S' v ω ω' = ω' - ω :=
  rfl

/-- **Pin-grade identity.** The frequency shift of a mode
from an operator to itself, at a single registered
frequency, is `0`. Arithmetic only; no seat fact. -/
theorem freqShift_self {E : Type*} [AddCommGroup E]
    [Module ℝ E] (S : E →ₗ[ℝ] E) (v : E) (ω : ℝ) :
    FreqShift S S v ω ω = 0 :=
  sub_self ω

/-- **The plaquette rank-one term (registered, in the MAX
pin's vocabulary).** For a named plaquette datum
`P0 : PlaqDatum N`, `plaqRankOneOp P0` is the linear map
on link angles whose component at a link `l` is
`plaqSign P0 l * plaqAngle P0 theta`: the rank-one term
built from the single plaquette angle at `P0`, in the
owned vocabulary of `MaxwellQuadPost` (`plaqAngle`,
`plaqSign`). Its quadratic form is the square of the
`P0` plaquette angle, read in coordinates. -/
noncomputable def plaqRankOneOp {N : ℕ} [NeZero N] (P₀ : PlaqDatum N) :
    linkAngle N →ₗ[ℝ] linkAngle N where
  toFun θ ℓ := plaqSign P₀ ℓ * plaqAngle P₀ θ
  map_add' θ η := by
    funext ℓ
    simp only [Pi.add_apply, plaqAngle]
    ring
  map_smul' c θ := by
    funext ℓ
    simp only [RingHom.id_apply, Pi.smul_apply, smul_eq_mul,
      plaqAngle]
    ring

/-- **Read-back.** The plaquette rank-one term applies
componentwise exactly as registered, unfolded.
Pin-grade only. -/
theorem plaqRankOneOp_apply {N : ℕ} [NeZero N]
    (P₀ : PlaqDatum N) (θ : linkAngle N) (ℓ : LayerLink N) :
    plaqRankOneOp P₀ θ ℓ
      = plaqSign P₀ ℓ * plaqAngle P₀ θ :=
  rfl

/-- **THE LINE'S NAMED PERTURBATION (registered and
frozen).** The one-plaquette rank-one defect at the named
plaquette `P0`: the operator `maxwellOp N` plus the
plaquette rank-one term at `P0`,
`onePlaqDefectOp N P0 := maxwellOp N + plaqRankOneOp P0`.
In form vocabulary: its quadratic form is the
`maxwellQuad` form plus the plaquette-angle rank-one
term `(plaqAngle P0 theta)^2` at the named plaquette
`P0` - the `maxwellQuad` form plus the plaquette-angle
rank-one term, in the MAX pin's owned vocabulary
(`MaxwellQuadPost`). This is the perturbation GR-PROP-3
will decide the freq-shadow predicate for, named here
so it cannot drift: no other perturbation may be
substituted under that brick's name. -/
noncomputable def onePlaqDefectOp (N : ℕ) [NeZero N]
    (P₀ : PlaqDatum N) : linkAngle N →ₗ[ℝ] linkAngle N :=
  maxwellOp N + plaqRankOneOp P₀

/-- **Read-back.** The named defect operator applies
componentwise as the unperturbed operator's component
plus the plaquette rank-one term at `P0`, unfolded.
Pin-grade only. -/
theorem onePlaqDefectOp_apply {N : ℕ} [NeZero N]
    (P₀ : PlaqDatum N) (θ : linkAngle N) (ℓ : LayerLink N) :
    onePlaqDefectOp N P₀ θ ℓ
      = (maxwellOp N θ) ℓ + plaqSign P₀ ℓ * plaqAngle P₀ θ :=
  rfl

