def PoseObjBPathShadow (N : ℕ) [NeZero N]
    (Dp : LayerSite N → LayerSite N → ℕ)
    (x y : LayerSite N) (statedLength : ℕ) : Prop :=
  statedLength = Dp x y ∧ geoDist N x y ≤ statedLength

