theorem poseObjBPathShadow_unfold {N : ℕ} [NeZero N]
    (Dp : LayerSite N → LayerSite N → ℕ)
    (x y : LayerSite N) (statedLength : ℕ) :
    PoseObjBPathShadow N Dp x y statedLength
      ↔ statedLength = Dp x y
          ∧ geoDist N x y ≤ statedLength :=
  Iff.rfl

