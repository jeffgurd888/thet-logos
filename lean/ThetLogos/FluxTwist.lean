namespace ThetLogos

variable {n : ℕ}

/-! ## §1. Phases

All phases in this file are written `phaseOf x = exp (x * I)` for a real
angle `x`, so that every phase manipulation reduces to real addition
plus three facts: `exp` adds, `exp (2π * I) = 1`, and conjugation negates
the angle. -/

/-- The unit-modulus phase of a real angle: `phaseOf x = exp (x * I)`. -/
noncomputable def phaseOf (x : ℝ) : ℂ := Complex.exp ((x : ℂ) * Complex.I)

theorem phaseOf_zero : phaseOf 0 = 1 := by
  simp [phaseOf]

theorem phaseOf_add (x y : ℝ) : phaseOf (x + y) = phaseOf x * phaseOf y := by
  rw [phaseOf, phaseOf, phaseOf, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem phaseOf_two_pi_mul_nat (m : ℕ) : phaseOf (2 * Real.pi * m) = 1 := by
  have hbase : phaseOf (2 * Real.pi) = 1 := by
    have hc : Real.cos (2 * Real.pi) = 1 := by
      rw [two_mul, Real.cos_add, Real.sin_pi, Real.cos_pi]
      norm_num
    have hs : Real.sin (2 * Real.pi) = 0 := by
      rw [two_mul, Real.sin_add, Real.sin_pi, Real.cos_pi]
      norm_num
    rw [phaseOf, Complex.exp_ofReal_mul_I, hc, hs]
    simp
  induction m with
  | zero => simp [phaseOf_zero]
  | succ k ih =>
    rw [show (2 : ℝ) * Real.pi * ((k + 1 : ℕ) : ℝ)
        = 2 * Real.pi * (k : ℝ) + 2 * Real.pi by push_cast; ring,
      phaseOf_add, ih, hbase, mul_one]

theorem phaseOf_ne_zero (x : ℝ) : phaseOf x ≠ 0 :=
  Complex.exp_ne_zero _

theorem conj_phaseOf (x : ℝ) : (starRingEnd ℂ) (phaseOf x) = phaseOf (-x) := by
  rw [phaseOf, phaseOf, ← Complex.exp_conj]
  congr 1
  rw [map_mul, Complex.conj_ofReal, Complex.conj_I, Complex.ofReal_neg]
  ring

theorem phaseOf_mul_conj (x : ℝ) : phaseOf x * (starRingEnd ℂ) (phaseOf x) = 1 := by
  rw [conj_phaseOf, ← phaseOf_add]
  simp [phaseOf]

theorem conj_mul_phaseOf (x : ℝ) : (starRingEnd ℂ) (phaseOf x) * phaseOf x = 1 := by
  rw [mul_comm]
  exact phaseOf_mul_conj x

theorem inv_phaseOf (x : ℝ) : (phaseOf x)⁻¹ = (starRingEnd ℂ) (phaseOf x) := by
  have h := eq_inv_of_mul_eq_one_left (phaseOf_mul_conj x)
  nth_rewrite 1 [h]
  exact inv_inv _

theorem phaseOf_re (x : ℝ) : (phaseOf x).re = Real.cos x := by
  rw [phaseOf]
  exact Complex.exp_ofReal_mul_I_re x

/-! ## §2. The cyclic successor

The ring has `n + 1` sites; `cyc` is the one-step rotation
`finRotate (n + 1) : Perm (Fin (n + 1))`. The facts used below: it sends
the last site to `0`, it is injective, and off the last site it raises
the index value by one. -/

/-- The cyclic successor on the ring of `n + 1` sites. -/
def cyc : Equiv.Perm (Fin (n + 1)) := finRotate (n + 1)

theorem cyc_last : cyc (n := n) (Fin.last n) = 0 := finRotate_last

theorem cyc_injective : Function.Injective (cyc (n := n)) := (finRotate (n + 1)).injective

theorem cyc_eq_zero_iff {i : Fin (n + 1)} : cyc (n := n) i = 0 ↔ i = Fin.last n := by
  constructor
  · intro h
    have h2 : cyc (n := n) i = cyc (Fin.last n) := by rw [h, cyc_last]
    exact cyc_injective h2
  · intro h
    rw [h, cyc_last]

theorem coe_cyc_of_ne_last {i : Fin (n + 1)} (hi : i ≠ Fin.last n) :
    ((cyc (n := n) i : Fin (n + 1)) : ℕ) = i.val + 1 :=
  coe_finRotate_of_ne_last hi

/-! ## §3. Weighted permutation matrices

A *weighted permutation matrix* `wpMat s a` has, in row `i`, the single
possibly-nonzero entry `a i` in column `s i`. Both twists are of this
form, so their unitarity is proved once, here, from the two facts
`|a i|² = a i * conj (a i)` and the injectivity of `s`. -/

/-- The weighted permutation matrix of a permutation `s` and a weight
function `a`: entry `(i, j)` is `a i` if `j = s i`, else `0`. -/
def wpMat (s : Equiv.Perm (Fin (n + 1))) (a : Fin (n + 1) → ℂ) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ :=
  Matrix.of fun i j => if j = s i then a i else 0

theorem wpMat_apply (s : Equiv.Perm (Fin (n + 1))) (a : Fin (n + 1) → ℂ)
    (i j : Fin (n + 1)) :
    wpMat s a i j = if j = s i then a i else 0 := rfl

theorem wpMat_mul_conjTranspose (s : Equiv.Perm (Fin (n + 1))) (a : Fin (n + 1) → ℂ) :
    wpMat s a * (wpMat s a)ᴴ = Matrix.diagonal fun i => a i * (starRingEnd ℂ) (a i) := by
  ext i j
  rw [Matrix.mul_apply]
  by_cases h : i = j
  · subst h
    rw [Finset.sum_eq_single (s i)]
    · simp [wpMat_apply, Matrix.conjTranspose_apply, Matrix.diagonal_apply_eq]
    · intro k _ hk
      simp [wpMat_apply, hk]
    · simp
  · rw [Matrix.diagonal_apply_ne _ h]
    rw [Finset.sum_eq_single (s i)]
    · have hne : s i ≠ s j := fun hh => h (s.injective hh)
      rw [Matrix.conjTranspose_apply, wpMat_apply, wpMat_apply, if_pos rfl, if_neg hne]
      simp
    · intro k _ hk
      simp [wpMat_apply, hk]
    · simp

theorem wpMat_conjTranspose_mul (s : Equiv.Perm (Fin (n + 1))) (a : Fin (n + 1) → ℂ) :
    (wpMat s a)ᴴ * wpMat s a =
      Matrix.diagonal fun i => (starRingEnd ℂ) (a (s.symm i)) * a (s.symm i) := by
  ext i j
  rw [Matrix.mul_apply]
  by_cases h : i = j
  · subst h
    rw [Finset.sum_eq_single (s.symm i)]
    · have h1 : s (s.symm i) = i := s.apply_symm_apply i
      simp [wpMat_apply, Matrix.conjTranspose_apply, Matrix.diagonal_apply_eq, h1]
    · intro k _ hk
      have hk2 : i ≠ s k := by
        intro hh
        apply hk
        rw [hh, Equiv.symm_apply_apply]
      simp [wpMat_apply, Matrix.conjTranspose_apply, if_neg hk2]
    · simp
  · rw [Matrix.diagonal_apply_ne _ h]
    rw [Finset.sum_eq_single (s.symm i)]
    · have h1 : s (s.symm i) = i := s.apply_symm_apply i
      rw [Matrix.conjTranspose_apply, wpMat_apply s a (s.symm i) i,
        wpMat_apply s a (s.symm i) j, h1, if_pos rfl, if_neg (Ne.symm h)]
      simp
    · intro k _ hk
      have hk2 : i ≠ s k := by
        intro hh
        apply hk
        rw [hh, Equiv.symm_apply_apply]
      simp [wpMat_apply, Matrix.conjTranspose_apply, if_neg hk2]
    · simp

/-! ## §4. The two twists and their unitarity

`twistedShift θ` is the boundary twist: the weight in row `i` is
`phaseOf θ` on the wrap-around bond (the row of the last site, whose
successor is site `0`) and `1` on every other bond.
`uniformShift θ` spreads the same total flux evenly: every bond
carries `phaseOf (θ / (n + 1))`. -/

/-- The boundary phase: `phaseOf θ` on the wrap-around bond, `1`
elsewhere. -/
noncomputable def boundaryPhase (θ : ℝ) (i : Fin (n + 1)) : ℂ :=
  if i = Fin.last n then phaseOf θ else 1

/-- The boundary-twist shift `S θ`: cyclic shift with the flux
`phaseOf θ` on the wrap-around bond only. -/
noncomputable def twistedShift (θ : ℝ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ :=
  wpMat cyc (boundaryPhase θ)

/-- The uniform-twist shift: cyclic shift with every bond carrying
`phaseOf (θ / (n + 1))`. -/
noncomputable def uniformShift (θ : ℝ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ :=
  wpMat cyc (fun _ => phaseOf (θ / ((n : ℝ) + 1)))

theorem twistedShift_apply (θ : ℝ) (i j : Fin (n + 1)) :
    twistedShift θ i j = if j = cyc i then boundaryPhase θ i else 0 := rfl

theorem uniformShift_apply (θ : ℝ) (i j : Fin (n + 1)) :
    uniformShift θ i j = if j = cyc i then phaseOf (θ / ((n : ℝ) + 1)) else 0 := rfl

/-- A weighted permutation matrix whose weights all have unit modulus
is unitary (both products). -/
theorem wpMat_unitary {s : Equiv.Perm (Fin (n + 1))} {a : Fin (n + 1) → ℂ}
    (ha : ∀ i, a i * (starRingEnd ℂ) (a i) = 1) :
    wpMat s a * (wpMat s a)ᴴ = 1 ∧ (wpMat s a)ᴴ * wpMat s a = 1 := by
  constructor
  · rw [wpMat_mul_conjTranspose]
    ext i j
    by_cases h : i = j
    · subst h
      rw [Matrix.diagonal_apply_eq, Matrix.one_apply_eq]
      exact ha i
    · rw [Matrix.diagonal_apply_ne _ h, Matrix.one_apply_ne h]
  · rw [wpMat_conjTranspose_mul]
    ext i j
    by_cases h : i = j
    · subst h
      rw [Matrix.diagonal_apply_eq, Matrix.one_apply_eq, mul_comm]
      exact ha (s.symm i)
    · rw [Matrix.diagonal_apply_ne _ h, Matrix.one_apply_ne h]

/-- **Flux twist is unitary (T1):** `S θ * S θ* = 1` and
`S θ* * S θ = 1`. -/
theorem twistedShift_unitary (θ : ℝ) :
    twistedShift (n := n) θ * (twistedShift (n := n) θ)ᴴ = 1
      ∧ (twistedShift (n := n) θ)ᴴ * twistedShift (n := n) θ = 1 :=
  wpMat_unitary (fun i => by
    by_cases hi : i = Fin.last n <;> simp [boundaryPhase, hi, phaseOf_mul_conj])

/-- The uniform twist is unitary (T1). -/
theorem uniformShift_unitary (θ : ℝ) :
    uniformShift (n := n) θ * (uniformShift (n := n) θ)ᴴ = 1
      ∧ (uniformShift (n := n) θ)ᴴ * uniformShift (n := n) θ = 1 :=
  wpMat_unitary (fun _ => phaseOf_mul_conj _)

/-- `S θ` is a member of the unitary group of matrices (T1). -/
theorem twistedShift_mem_unitary (θ : ℝ) :
    twistedShift θ ∈ unitary (Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) := by
  rw [Unitary.mem_iff, Matrix.star_eq_conjTranspose]
  exact ⟨(twistedShift_unitary θ).2, (twistedShift_unitary θ).1⟩

/-! ## §5. Flux periodicity

Shifting the flux by `2π` does not change the boundary twist: the only
entry that sees `θ` is the wrap-around phase, and
`phaseOf (θ + 2π) = phaseOf θ`. -/

theorem phaseOf_add_two_pi (θ : ℝ) : phaseOf (θ + 2 * Real.pi) = phaseOf θ := by
  have h1 : phaseOf (2 * Real.pi * ((1 : ℕ) : ℝ)) = 1 := phaseOf_two_pi_mul_nat 1
  rw [Nat.cast_one, mul_one] at h1
  rw [phaseOf_add, h1, mul_one]

/-- **Flux periodicity (T1):** `S (θ + 2π) = S θ`. -/
theorem twistedShift_add_two_pi (θ : ℝ) :
    twistedShift (n := n) (θ + 2 * Real.pi) = twistedShift (n := n) θ := by
  unfold twistedShift
  congr 1
  funext i
  by_cases hi : i = Fin.last n
  · simp only [boundaryPhase, if_pos hi]
    exact phaseOf_add_two_pi θ
  · simp [boundaryPhase, hi]

/-! ## §6. Gauge redistribution

The diagonal unitary `gaugeMatrix θ` — site `k` carries the phase
`phaseOf (θ * k / (n + 1))` — intertwines the two twists:
`S θ * G = G * Sᵘ θ`. Read on functions, this says the boundary twist
conjugated by the gauge phases is the uniform twist: the flux may sit
on one bond or be spread evenly over all of them; the two pictures
differ only by a diagonal change of basis. -/

theorem star_phaseOf (x : ℝ) : star (phaseOf x) = phaseOf (-x) := conj_phaseOf x

/-- The diagonal gauge matrix: site `k` carries
`phaseOf (θ * k / (n + 1))`. -/
noncomputable def gaugeMatrix (θ : ℝ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ :=
  Matrix.diagonal fun k => phaseOf (θ * (k.val : ℝ) / ((n : ℝ) + 1))

theorem gaugeMatrix_apply_diag (θ : ℝ) (k : Fin (n + 1)) :
    gaugeMatrix θ k k = phaseOf (θ * (k.val : ℝ) / ((n : ℝ) + 1)) :=
  Matrix.diagonal_apply_eq _ _

theorem gaugeMatrix_apply_ne (θ : ℝ) {i k : Fin (n + 1)} (h : i ≠ k) :
    gaugeMatrix θ i k = 0 :=
  Matrix.diagonal_apply_ne _ h

/-- The gauge matrix is unitary (T1), first product. -/
theorem gaugeMatrix_mul_conjTranspose (θ : ℝ) :
    gaugeMatrix (n := n) θ * (gaugeMatrix (n := n) θ)ᴴ = 1 := by
  unfold gaugeMatrix
  rw [Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal]
  ext i j
  by_cases h : i = j
  · subst h
    rw [Matrix.diagonal_apply_eq, Matrix.one_apply_eq]
    simp only [Pi.star_apply, star_phaseOf, ← phaseOf_add, add_neg_cancel]
    exact phaseOf_zero
  · rw [Matrix.diagonal_apply_ne _ h, Matrix.one_apply_ne h]

/-- The gauge matrix is unitary (T1), second product. -/
theorem gaugeMatrix_conjTranspose_mul (θ : ℝ) :
    (gaugeMatrix (n := n) θ)ᴴ * gaugeMatrix (n := n) θ = 1 := by
  unfold gaugeMatrix
  rw [Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal]
  ext i j
  by_cases h : i = j
  · subst h
    rw [Matrix.diagonal_apply_eq, Matrix.one_apply_eq]
    simp only [Pi.star_apply, star_phaseOf, ← phaseOf_add, neg_add_cancel]
    exact phaseOf_zero
  · rw [Matrix.diagonal_apply_ne _ h, Matrix.one_apply_ne h]

/-- **Gauge redistribution (T1):** `S θ * G = G * Sᵘ θ` — the boundary
twist and the uniform twist are intertwined by the diagonal gauge
matrix. -/
theorem twistedShift_mul_gaugeMatrix (θ : ℝ) :
    twistedShift (n := n) θ * gaugeMatrix (n := n) θ
      = gaugeMatrix (n := n) θ * uniformShift (n := n) θ := by
  have hN : ((n : ℝ) + 1) ≠ 0 := by positivity
  ext i j
  have hL : ∀ k ∈ Finset.univ, k ≠ j →
      twistedShift θ i k * gaugeMatrix θ k j = 0 := by
    intro k _ hk
    rw [gaugeMatrix_apply_ne θ hk, mul_zero]
  have hR : ∀ k ∈ Finset.univ, k ≠ i →
      gaugeMatrix θ i k * uniformShift θ k j = 0 := by
    intro k _ hk
    rw [gaugeMatrix_apply_ne θ (Ne.symm hk), zero_mul]
  rw [Matrix.mul_apply, Matrix.mul_apply,
    Finset.sum_eq_single j hL (by simp), Finset.sum_eq_single i hR (by simp)]
  by_cases hj : j = cyc i
  · subst hj
    rw [twistedShift_apply, uniformShift_apply, if_pos rfl, if_pos rfl,
      gaugeMatrix_apply_diag, gaugeMatrix_apply_diag]
    by_cases hi : i = Fin.last n
    · subst hi
      rw [show boundaryPhase θ (Fin.last n) = phaseOf θ from if_pos rfl, cyc_last]
      simp only [Fin.val_zero, Nat.cast_zero, mul_zero, zero_div, phaseOf_zero, mul_one]
      rw [Fin.val_last, ← phaseOf_add]
      congr 1
      field_simp
    · rw [show boundaryPhase θ i = 1 from if_neg hi, coe_cyc_of_ne_last hi,
        Nat.cast_add, Nat.cast_one, one_mul, ← phaseOf_add]
      congr 1
      ring
  · rw [twistedShift_apply, uniformShift_apply, if_neg hj, if_neg hj]
    simp

/-! ## §7. The ring hears the flux: eigenvectors

A weighted permutation matrix acts on a vector by pulling the value
from the successor site and multiplying by the row's weight. The
Fourier vectors diagonalize the uniform twist. For the boundary
twist, plain Fourier vectors are *not* eigenvectors — at the
wrap-around bond their eigenphase equation fails by exactly the flux
phase `phaseOf θ` (checked by hand: the boundary bond compares
`ζ^m = exp (2πi m/(n+1))` against `exp (iθ) ζ^m`). The correct
eigenvectors of the boundary twist are the *flux-carrying* Fourier
vectors `twistedFourierVec θ m`, whose `k`-th component is
`phaseOf ((θ + 2πm) k / (n + 1))`. Both twists share the eigenphase
formula `(θ + 2πm) / (n + 1)` — consistently with §6, since unitarily
equivalent operators have the same eigenvalues. -/

theorem wpMat_mulVec_apply (s : Equiv.Perm (Fin (n + 1))) (a : Fin (n + 1) → ℂ)
    (v : Fin (n + 1) → ℂ) (i : Fin (n + 1)) :
    (wpMat s a *ᵥ v) i = a i * v (s i) := by
  rw [Matrix.mulVec_apply_eq_sum, Finset.sum_eq_single (s i)]
  · rw [wpMat_apply, if_pos rfl]
  · intro k _ hk
    rw [wpMat_apply, if_neg hk, zero_mul]
  · simp

theorem twistedShift_mulVec_apply (θ : ℝ) (v : Fin (n + 1) → ℂ) (i : Fin (n + 1)) :
    (twistedShift θ *ᵥ v) i = boundaryPhase θ i * v (cyc i) :=
  wpMat_mulVec_apply cyc _ v i

theorem uniformShift_mulVec_apply (θ : ℝ) (v : Fin (n + 1) → ℂ) (i : Fin (n + 1)) :
    (uniformShift θ *ᵥ v) i = phaseOf (θ / ((n : ℝ) + 1)) * v (cyc i) :=
  wpMat_mulVec_apply cyc _ v i

/-- The `m`-th Fourier vector: components `phaseOf (2π m k / (n + 1))`. -/
noncomputable def fourierVec (m : Fin (n + 1)) : Fin (n + 1) → ℂ :=
  fun k => phaseOf (2 * Real.pi * (m.val : ℝ) * (k.val : ℝ) / ((n : ℝ) + 1))

/-- The flux-carrying Fourier vector: components
`phaseOf ((θ + 2πm) k / (n + 1))`. -/
noncomputable def twistedFourierVec (θ : ℝ) (m : Fin (n + 1)) : Fin (n + 1) → ℂ :=
  fun k => phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) * (k.val : ℝ) / ((n : ℝ) + 1))

/-- **The ring hears the flux, uniform twist (T1):** the Fourier vector
`v m` is an eigenvector of the uniform twist with eigenphase
`phaseOf ((θ + 2πm) / (n + 1))`. -/
theorem uniformShift_mulVec_fourierVec (θ : ℝ) (m : Fin (n + 1)) :
    uniformShift (n := n) θ *ᵥ fourierVec m
      = phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)) • fourierVec m := by
  have hN : ((n : ℝ) + 1) ≠ 0 := by positivity
  funext i
  rw [uniformShift_mulVec_apply, Pi.smul_apply, smul_eq_mul]
  by_cases hi : i = Fin.last n
  · subst hi
    have h0 : fourierVec m (0 : Fin (n + 1)) = 1 := by
      show phaseOf (2 * Real.pi * (m.val : ℝ) * ((0 : Fin (n + 1)).val : ℝ)
        / ((n : ℝ) + 1)) = 1
      simp [phaseOf_zero]
    have hlast : fourierVec m (Fin.last n)
        = phaseOf (2 * Real.pi * (m.val : ℝ) * (n : ℝ) / ((n : ℝ) + 1)) := by
      show phaseOf (2 * Real.pi * (m.val : ℝ) * ((Fin.last n).val : ℝ)
        / ((n : ℝ) + 1)) = _
      rw [Fin.val_last]
    have hid : (θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)
        + 2 * Real.pi * (m.val : ℝ) * (n : ℝ) / ((n : ℝ) + 1)
        = θ / ((n : ℝ) + 1) + 2 * Real.pi * (m.val : ℝ) := by
      field_simp
      ring
    rw [cyc_last, h0, mul_one, hlast, ← phaseOf_add, hid, phaseOf_add,
      phaseOf_two_pi_mul_nat, mul_one]
  · have hcyc : fourierVec m (cyc i)
        = phaseOf (2 * Real.pi * (m.val : ℝ) / ((n : ℝ) + 1)) * fourierVec m i := by
      show phaseOf (2 * Real.pi * (m.val : ℝ) * ((cyc i).val : ℝ) / ((n : ℝ) + 1))
          = phaseOf (2 * Real.pi * (m.val : ℝ) / ((n : ℝ) + 1))
            * phaseOf (2 * Real.pi * (m.val : ℝ) * (i.val : ℝ) / ((n : ℝ) + 1))
      rw [coe_cyc_of_ne_last hi, Nat.cast_add, Nat.cast_one, ← phaseOf_add]
      congr 1
      ring
    have hid : θ / ((n : ℝ) + 1) + 2 * Real.pi * (m.val : ℝ) / ((n : ℝ) + 1)
        = (θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1) := by ring
    rw [hcyc, ← mul_assoc, ← phaseOf_add, hid]

/-- **The ring hears the flux, boundary twist (T1):** the
flux-carrying Fourier vector is an eigenvector of the boundary twist
with the same eigenphase `phaseOf ((θ + 2πm) / (n + 1))`. -/
theorem twistedShift_mulVec_twistedFourierVec (θ : ℝ) (m : Fin (n + 1)) :
    twistedShift (n := n) θ *ᵥ twistedFourierVec θ m
      = phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1))
        • twistedFourierVec θ m := by
  have hN : ((n : ℝ) + 1) ≠ 0 := by positivity
  funext i
  rw [twistedShift_mulVec_apply, Pi.smul_apply, smul_eq_mul]
  by_cases hi : i = Fin.last n
  · subst hi
    have h0 : twistedFourierVec θ m (0 : Fin (n + 1)) = 1 := by
      show phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) * ((0 : Fin (n + 1)).val : ℝ)
        / ((n : ℝ) + 1)) = 1
      simp [phaseOf_zero]
    have hlast : twistedFourierVec θ m (Fin.last n)
        = phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) * (n : ℝ) / ((n : ℝ) + 1)) := by
      show phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) * ((Fin.last n).val : ℝ)
        / ((n : ℝ) + 1)) = _
      rw [Fin.val_last]
    have hid : (θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)
        + (θ + 2 * Real.pi * (m.val : ℝ)) * (n : ℝ) / ((n : ℝ) + 1)
        = θ + 2 * Real.pi * (m.val : ℝ) := by
      field_simp
      ring
    rw [show boundaryPhase θ (Fin.last n) = phaseOf θ from if_pos rfl, cyc_last,
      h0, mul_one, hlast, ← phaseOf_add, hid, phaseOf_add, phaseOf_two_pi_mul_nat,
      mul_one]
  · have hcyc : twistedFourierVec θ m (cyc i)
        = phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1))
          * twistedFourierVec θ m i := by
      show phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) * ((cyc i).val : ℝ)
            / ((n : ℝ) + 1))
          = phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1))
            * phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) * (i.val : ℝ)
              / ((n : ℝ) + 1))
      rw [coe_cyc_of_ne_last hi, Nat.cast_add, Nat.cast_one, ← phaseOf_add]
      congr 1
      ring
    rw [show boundaryPhase θ i = 1 from if_neg hi, one_mul, hcyc]

/-! ## §8. The hopping Hamiltonian (stretch target)

`hopping θ = -(S θ + S θ*) / 2`, the symmetrized shift: the
nearest-neighbor hopping Hamiltonian of the ring, in units where the
hopping amplitude is `1/2`. It is Hermitian, and the flux-carrying
Fourier vectors diagonalize it with eigenvalues
`-cos ((θ + 2πm) / (n + 1))` — the familiar cosine band of a ring,
shifted by the flux: the ring hears the flux in its spectrum too.

The Gibbs-state modular-flow statement remains PRICED (see the
header): it is not formalized here. -/

/-- The hopping Hamiltonian `-(S θ + S θ*) / 2`. -/
noncomputable def hopping (θ : ℝ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ :=
  (-(2 : ℂ)⁻¹) • (twistedShift θ + (twistedShift θ)ᴴ)

/-- **The hopping Hamiltonian is Hermitian (T1).** -/
theorem hopping_isHermitian (θ : ℝ) : (hopping (n := n) θ).IsHermitian := by
  rw [Matrix.IsHermitian, hopping, Matrix.conjTranspose_smul,
    Matrix.conjTranspose_add, Matrix.conjTranspose_conjTranspose,
    add_comm (twistedShift (n := n) θ) ((twistedShift (n := n) θ)ᴴ)]
  congr 1
  simp

/-- The adjoint shift acts on the flux-carrying Fourier vectors by the
conjugate eigenphase (T1), via unitarity. -/
theorem twistedShift_conjTranspose_mulVec_twistedFourierVec (θ : ℝ) (m : Fin (n + 1)) :
    (twistedShift (n := n) θ)ᴴ *ᵥ twistedFourierVec θ m
      = (starRingEnd ℂ) (phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)))
        • twistedFourierVec θ m := by
  have hU : (twistedShift (n := n) θ)ᴴ * twistedShift (n := n) θ = 1 :=
    (twistedShift_unitary θ).2
  have heig := twistedShift_mulVec_twistedFourierVec θ m
  have hlam : phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)) ≠ 0 :=
    phaseOf_ne_zero _
  have key : phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1))
        • ((twistedShift (n := n) θ)ᴴ *ᵥ twistedFourierVec θ m)
      = phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1))
        • ((phaseOf ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)))⁻¹
          • twistedFourierVec θ m) := by
    rw [smul_smul, mul_inv_cancel₀ hlam, one_smul, ← Matrix.mulVec_smul, ← heig,
      Matrix.mulVec_mulVec, hU, Matrix.one_mulVec]
  have h2 := MulAction.injective₀ hlam key
  rwa [inv_phaseOf] at h2

/-- **Hopping spectrum (T1):** the flux-carrying Fourier vector is an
eigenvector of `hopping θ` with eigenvalue
`-cos ((θ + 2πm) / (n + 1))`. -/
theorem hopping_mulVec_twistedFourierVec (θ : ℝ) (m : Fin (n + 1)) :
    hopping (n := n) θ *ᵥ twistedFourierVec θ m
      = (-(Real.cos ((θ + 2 * Real.pi * (m.val : ℝ)) / ((n : ℝ) + 1)) : ℂ))
        • twistedFourierVec θ m := by
  have heig := twistedShift_mulVec_twistedFourierVec θ m
  have hadj := twistedShift_conjTranspose_mulVec_twistedFourierVec θ m
  rw [hopping, Matrix.smul_mulVec, Matrix.add_mulVec, heig, hadj,
    ← add_smul, smul_smul]
  congr 1
  rw [Complex.add_conj, phaseOf_re]
  have key : ∀ c : ℝ, (-(2 : ℂ)⁻¹) * ((2 * c : ℝ) : ℂ) = -((c : ℝ) : ℂ) := by
    intro c
    rw [Complex.ofReal_mul, Complex.ofReal_ofNat, ← mul_assoc,
      show (-(2 : ℂ)⁻¹) * 2 = -1 by norm_num]
    ring
  exact key _

end ThetLogos
