import ThetLogos.SemigroupGeneration
import ThetLogos.PerronFrobenius
import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Analysis.Normed.Order.Lattice

namespace ThetLogos

open Filter Set
open scoped Topology NNReal Matrix

variable {K : Type*} [Fintype K] [DecidableEq K] [Nonempty K]

/-! ## 1. The finite C(K) seat and its positivity -/

/-- Pointwise positivity on the finite C(K) seat
`E = K -> R`: `f` is positive if every value is. -/
def Pos (f : K → ℝ) : Prop := ∀ i, 0 ≤ f i

/-- An operator on the seat is positive if it maps
positive functions to positive functions. -/
def PosOp (T : (K → ℝ) →L[ℝ] (K → ℝ)) : Prop :=
  ∀ f, Pos f → Pos (T f)

/-- The `(i, j)` entry of a seat operator: the `i`-th
value of the image of the `j`-th basis function. -/
def entry (A : (K → ℝ) →L[ℝ] (K → ℝ)) (i j : K) : ℝ :=
  A (Pi.single j 1) i

/-- Quasi-positivity (the Metzler condition): some
nonnegative scalar shift of `A` is a positive
operator. -/
def QuasiPos (A : (K → ℝ) →L[ℝ] (K → ℝ)) : Prop :=
  ∃ c : ℝ, 0 ≤ c ∧ PosOp (A + c • 1)

/-- Resolvent positivity at all large parameters, in
SHELF-1a's `ResolventSpec` dialect relative to
`expSemigroup A`: some threshold `Lam` above which
every resolvent is a positive operator. -/
def ResPosLarge (A : (K → ℝ) →L[ℝ] (K → ℝ)) : Prop :=
  ∃ Lam : ℝ, ∀ lam : ℝ, Lam < lam →
    ∀ R : (K → ℝ) →L[ℝ] (K → ℝ),
      ResolventSpec (expSemigroup A) lam R → PosOp R

/-- The generated semigroup is positive:
`expSemigroup A` maps positive functions to positive
functions at every `t >= 0`. -/
def SGPos (A : (K → ℝ) →L[ℝ] (K → ℝ)) : Prop :=
  ∀ t : ℝ, 0 ≤ t → PosOp ((expSemigroup A).toFun t)

/-- The generated semigroup is contractive. -/
def SGContr (A : (K → ℝ) →L[ℝ] (K → ℝ)) : Prop :=
  ∀ t : ℝ, 0 ≤ t → ‖(expSemigroup A).toFun t‖ ≤ 1

/-- Dissipativity in SHELF-1b's resolvent-bound form,
stated for a bounded operator on the whole space:
`lam * ||x|| <= ||lam * x - A x||` for all `lam > 0`.
This is `DissBound` at the top submodule; the
identification is `dissBoundSeat_iff` below. -/
def DissBoundSeat (A : (K → ℝ) →L[ℝ] (K → ℝ)) : Prop :=
  ∀ lam : ℝ, 0 < lam → ∀ x : K → ℝ,
    lam * ‖x‖ ≤ ‖lam • x - A x‖

/-! ## 2. Positive operators: algebra and the closed cone -/

theorem pos_zero : Pos (0 : K → ℝ) := fun i => le_rfl

theorem posOp_zero : PosOp (0 : (K → ℝ) →L[ℝ] (K → ℝ)) :=
  fun f _ => pos_zero

theorem posOp_one : PosOp (1 : (K → ℝ) →L[ℝ] (K → ℝ)) :=
  fun f hf => hf

theorem posOp_add {S T : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hS : PosOp S) (hT : PosOp T) : PosOp (S + T) := by
  intro f hf i
  have h1 := hS f hf i
  have h2 := hT f hf i
  simp only [ContinuousLinearMap.add_apply, Pi.add_apply]
  exact add_nonneg h1 h2

theorem posOp_smul {T : (K → ℝ) →L[ℝ] (K → ℝ)} {c : ℝ}
    (hc : 0 ≤ c) (hT : PosOp T) : PosOp (c • T) := by
  intro f hf i
  have h1 := hT f hf i
  simp only [ContinuousLinearMap.smul_apply, Pi.smul_apply,
    smul_eq_mul]
  exact mul_nonneg hc h1

theorem posOp_mul {S T : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hS : PosOp S) (hT : PosOp T) : PosOp (S * T) := by
  intro f hf
  rw [ContinuousLinearMap.mul_apply]
  exact hS _ (hT f hf)

theorem posOp_pow (T : (K → ℝ) →L[ℝ] (K → ℝ))
    (hT : PosOp T) (n : ℕ) : PosOp (T ^ n) := by
  induction n with
  | zero => simpa using posOp_one (K := K)
  | succ m ih => rw [pow_succ]; exact posOp_mul ih hT

theorem clm_sum_apply {ι : Type*} [DecidableEq ι]
    (s : Finset ι)
    (T : ι → (K → ℝ) →L[ℝ] (K → ℝ)) (f : K → ℝ) :
    (∑ i ∈ s, T i) f = ∑ i ∈ s, T i f := by
  induction s using Finset.induction with
  | empty => simp
  | insert a s has ih =>
    rw [Finset.sum_insert has, Finset.sum_insert has,
      ContinuousLinearMap.add_apply, ih]

theorem posOp_sum {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (T : ι → (K → ℝ) →L[ℝ] (K → ℝ))
    (hT : ∀ i ∈ s, PosOp (T i)) : PosOp (∑ i ∈ s, T i) := by
  intro f hf
  rw [clm_sum_apply]
  intro i
  rw [Finset.sum_apply]
  exact Finset.sum_nonneg (fun j hj => hT j hj f hf i)

/-- The positive cone of the seat is closed: a pointwise
limit of positive functions is positive. (At a general
seat this is one of the missing-API items of the seam;
here it is the Pi norm estimate.) -/
theorem pos_of_tendsto {u : ℕ → (K → ℝ)} {f : K → ℝ}
    (hlim : Tendsto u atTop (𝓝 f)) (hu : ∀ n, Pos (u n)) :
    Pos f := by
  intro i
  have hpt : Tendsto (fun n => u n i) atTop (𝓝 (f i)) := by
    have hsub : Tendsto (fun n => u n i - f i) atTop (𝓝 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      refine squeeze_zero_norm (a := fun n => ‖u n - f‖)
        (fun n => ?_) ?_
      · have hle : ‖(u n - f) i‖ ≤ ‖u n - f‖ :=
          (pi_norm_le_iff_of_nonneg (norm_nonneg _)).mp le_rfl i
        rw [Pi.sub_apply] at hle
        rwa [norm_norm]
      · simpa using
          (hlim.sub (tendsto_const_nhds (x := f))).norm
    have := hsub.add (tendsto_const_nhds (x := f i))
    simpa using this
  exact ge_of_tendsto hpt
    (by filter_upwards with n; exact hu n i)

theorem posOp_of_tendsto_apply {T : (K → ℝ) →L[ℝ] (K → ℝ)}
    {Tₙ : ℕ → (K → ℝ) →L[ℝ] (K → ℝ)}
    (hT : ∀ n, PosOp (Tₙ n))
    (hlim : ∀ f, Tendsto (fun n => Tₙ n f) atTop (𝓝 (T f))) :
    PosOp T :=
  fun f hf => pos_of_tendsto (hlim f) (fun n => hT n f hf)

/-- A summable series of positive operators is positive. -/
theorem posOp_tsum {u : ℕ → (K → ℝ) →L[ℝ] (K → ℝ)}
    (hs : Summable u) (hu : ∀ n, PosOp (u n)) :
    PosOp (∑' n, u n) := by
  apply posOp_of_tendsto_apply (Tₙ := fun N =>
    ∑ n ∈ Finset.range N, u n)
  · intro N
    exact posOp_sum _ _ (fun i _ => hu i)
  · intro f
    have h := (hs.hasSum.mapL
      ((ContinuousLinearMap.apply ℝ (K → ℝ)) f)).tendsto_sum_nat
    apply h.congr
    intro N
    simp only [ContinuousLinearMap.apply_apply, clm_sum_apply]

/-! ## 3. Entries -/

theorem single_smul_one (f : K → ℝ) (j : K) :
    Pi.single j (f j) = f j • Pi.single j (1 : ℝ) := by
  funext i
  by_cases h : i = j
  · subst h; simp [Pi.single_eq_same, Pi.smul_apply]
  · simp [Pi.single_apply, h, Pi.smul_apply]

theorem sum_single_eq (f : K → ℝ) :
    (∑ j, Pi.single j (f j)) = f := by
  funext i
  rw [Finset.sum_apply, Finset.sum_pi_single]
  simp

theorem clm_apply_sum {ι : Type*} [DecidableEq ι]
    (T : (K → ℝ) →L[ℝ] (K → ℝ))
    (s : Finset ι) (g : ι → (K → ℝ)) :
    T (∑ i ∈ s, g i) = ∑ i ∈ s, T (g i) := by
  induction s using Finset.induction with
  | empty => simp
  | insert a s has ih =>
    rw [Finset.sum_insert has, Finset.sum_insert has,
      map_add, ih]

/-- The entry formula: the `i`-th value of `A f` is the
entry-weighted sum of the values of `f`. -/
theorem apply_eq_sum_entry (A : (K → ℝ) →L[ℝ] (K → ℝ))
    (f : K → ℝ) (i : K) :
    (A f) i = ∑ j, entry A i j * f j := by
  conv_lhs => rw [← sum_single_eq f, clm_apply_sum]
  rw [Finset.sum_apply]
  apply Finset.sum_congr rfl
  intro j _
  rw [single_smul_one, map_smul, Pi.smul_apply, smul_eq_mul,
    mul_comm]
  rfl

theorem entry_nonneg_of_posOp {B : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hB : PosOp B) (i j : K) : 0 ≤ entry B i j := by
  apply hB _ _ i
  intro k
  by_cases h : k = j
  · subst h; simp [Pi.single_eq_same]
  · simp [Pi.single_apply, h]

theorem posOp_of_entry_nonneg {B : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hB : ∀ i j, 0 ≤ entry B i j) : PosOp B := by
  intro f hf i
  rw [apply_eq_sum_entry]
  exact Finset.sum_nonneg
    (fun j _ => mul_nonneg (hB i j) (hf j))

theorem entry_add_smul_one (A : (K → ℝ) →L[ℝ] (K → ℝ))
    (c : ℝ) (i j : K) :
    entry (A + c • 1) i j
      = entry A i j + (if i = j then c else 0) := by
  by_cases h : i = j
  · subst h
    simp [entry, Pi.single_eq_same]
  · simp [entry, Pi.single_eq_of_ne (Ne.symm h), h]

/-! ## 4. The exponential of a positive operator -/

/-- The applied exponential series: for a bounded
operator `X`, `exp X` applied is the sum of the applied
series terms. -/
theorem hasSum_exp_apply (X : (K → ℝ) →L[ℝ] (K → ℝ))
    (f : K → ℝ) :
    HasSum (fun n => (((Nat.factorial n : ℝ))⁻¹ • X ^ n) f)
      (NormedSpace.exp X f) := by
  have hs : HasSum
      (fun n => ((Nat.factorial n : ℝ))⁻¹ • X ^ n)
      (NormedSpace.exp X) :=
    NormedSpace.exp_series_hasSum_exp' X
  exact hs.mapL ((ContinuousLinearMap.apply ℝ (K → ℝ)) f)

/-- The exponential of a nonnegative multiple of a
positive operator is positive: every series term is
positive, and the cone is closed. -/
theorem posOp_exp {B : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hB : PosOp B) {t : ℝ} (ht : 0 ≤ t) :
    PosOp (NormedSpace.exp (t • B)) := by
  apply posOp_of_tendsto_apply
    (Tₙ := fun N => ∑ n ∈ Finset.range N,
      ((Nat.factorial n : ℝ))⁻¹ • (t • B) ^ n)
  · intro N
    apply posOp_sum
    intro n _
    apply posOp_smul _ (posOp_pow _ _ n)
    · positivity
    · exact posOp_smul ht hB
  · intro f
    have h := (hasSum_exp_apply (t • B) f).tendsto_sum_nat
    apply h.congr
    intro N
    rw [clm_sum_apply]

theorem posOp_expSemigroup {B : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hB : PosOp B) : SGPos B := by
  intro t ht
  rw [expSemigroup_toFun]
  exact posOp_exp hB ht

/-! ## 5. The Neumann resolvent and the algebraic
`ResolventSpec` form -/

theorem genVal_expSemigroup (A : (K → ℝ) →L[ℝ] (K → ℝ))
    {x : K → ℝ} (hx : x ∈ (expSemigroup A).genDom) :
    (expSemigroup A).genVal hx = A x := by
  rw [← C0Semigroup.generator_apply]
  exact expSemigroup_generator_apply A x hx

/-- SHELF-1a's `ResolventSpec` for a bounded generator,
in purely algebraic form: the domain is everything
(`expSemigroup_genDom`) and the generator value is
`A x` (`genVal_expSemigroup`). -/
theorem resolventSpec_expSemigroup_iff
    (A : (K → ℝ) →L[ℝ] (K → ℝ)) (lam : ℝ)
    (R : (K → ℝ) →L[ℝ] (K → ℝ)) :
    ResolventSpec (expSemigroup A) lam R ↔
      (∀ x, R (lam • x - A x) = x) ∧
        (∀ y, lam • R y - A (R y) = y) := by
  constructor
  · intro hR
    have hmem : ∀ x : K → ℝ, x ∈ (expSemigroup A).genDom :=
      fun x => by
        rw [expSemigroup_genDom]; exact Submodule.mem_top
    refine ⟨fun x => ?_, fun y => ?_⟩
    · have h := hR.1 x (hmem x)
      rwa [genVal_expSemigroup] at h
    · obtain ⟨h, hh⟩ := hR.2 y
      rwa [genVal_expSemigroup] at hh
  · intro hR
    refine ⟨fun x hx => ?_, fun y => ?_⟩
    · rw [genVal_expSemigroup]; exact hR.1 x
    · exact ⟨by
        rw [expSemigroup_genDom]; exact Submodule.mem_top,
        by rw [genVal_expSemigroup]; exact hR.2 y⟩

/-- The Neumann-series resolvent of a bounded operator:
`lam^-1 * sum_n (lam^-1 A)^n`. For `lam > ||A||` this
is the resolvent of `expSemigroup A` at `lam`
(`neumannResolvent_spec`); at other parameters the
series is junk and nothing is claimed. -/
noncomputable def neumannResolvent
    (A : (K → ℝ) →L[ℝ] (K → ℝ)) (lam : ℝ) :
    (K → ℝ) →L[ℝ] (K → ℝ) :=
  lam⁻¹ • ∑' n : ℕ, (lam⁻¹ • A) ^ n

theorem neumannResolvent_spec {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    {lam : ℝ} (hlam : ‖A‖ < lam) :
    ResolventSpec (expSemigroup A) lam
      (neumannResolvent A lam) := by
  have hlam0 : 0 < lam := lt_of_le_of_lt (norm_nonneg A) hlam
  have hX : ‖lam⁻¹ • A‖ < 1 := by
    rw [norm_smul, Real.norm_of_nonneg
      (inv_nonneg.mpr hlam0.le), mul_comm]
    exact (div_lt_one hlam0).mpr hlam
  have hG1 : (∑' n : ℕ, (lam⁻¹ • A) ^ n) * (1 - lam⁻¹ • A)
      = 1 := geom_series_mul_neg _ hX
  have hG2 : (1 - lam⁻¹ • A)
      * (∑' n : ℕ, (lam⁻¹ • A) ^ n) = 1 :=
    mul_neg_geom_series _ hX
  have key : ∀ x : K → ℝ, lam • x - A x
      = lam • ((1 - lam⁻¹ • A) x) := by
    intro x
    rw [ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.one_apply,
      ContinuousLinearMap.smul_apply, smul_sub, smul_smul,
      mul_inv_cancel₀ hlam0.ne', one_smul]
  have happ : ∀ z : K → ℝ, neumannResolvent A lam z
      = lam⁻¹ • ((∑' n : ℕ, (lam⁻¹ • A) ^ n) z) := by
    intro z
    simp only [neumannResolvent, ContinuousLinearMap.smul_apply]
  rw [resolventSpec_expSemigroup_iff]
  refine ⟨fun x => ?_, fun y => ?_⟩
  · calc neumannResolvent A lam (lam • x - A x)
        = (∑' n : ℕ, (lam⁻¹ • A) ^ n) ((1 - lam⁻¹ • A) x) := by
          rw [key x, happ, map_smul, smul_smul,
            inv_mul_cancel₀ hlam0.ne', one_smul]
      _ = ((∑' n : ℕ, (lam⁻¹ • A) ^ n) * (1 - lam⁻¹ • A)) x :=
          (ContinuousLinearMap.mul_apply _ _ _).symm
      _ = x := by rw [hG1]; rfl
  · have e3 : (lam • (1 : (K → ℝ) →L[ℝ] (K → ℝ)) - A)
        * neumannResolvent A lam = 1 := by
      have hdecomp : lam • (1 : (K → ℝ) →L[ℝ] (K → ℝ)) - A
          = lam • (1 - lam⁻¹ • A) := by
        apply ContinuousLinearMap.ext
        intro z
        show lam • z - A z = lam • ((1 - lam⁻¹ • A) z)
        exact key z
      rw [hdecomp]
      calc (lam • (1 - lam⁻¹ • A)) * neumannResolvent A lam
          = (lam • (1 - lam⁻¹ • A))
              * (lam⁻¹ • ∑' n : ℕ, (lam⁻¹ • A) ^ n) := by
            simp only [neumannResolvent]
        _ = lam • ((1 - lam⁻¹ • A)
              * (lam⁻¹ • ∑' n : ℕ, (lam⁻¹ • A) ^ n)) :=
            Algebra.smul_mul_assoc _ _ _
        _ = lam • (lam⁻¹ • ((1 - lam⁻¹ • A)
              * ∑' n : ℕ, (lam⁻¹ • A) ^ n)) := by
            rw [Algebra.mul_smul_comm]
        _ = (lam * lam⁻¹) • ((1 - lam⁻¹ • A)
              * ∑' n : ℕ, (lam⁻¹ • A) ^ n) := by
            rw [smul_smul]
        _ = 1 := by
            rw [mul_inv_cancel₀ hlam0.ne', one_smul, hG2]
    calc lam • neumannResolvent A lam y
          - A (neumannResolvent A lam y)
        = ((lam • (1 : (K → ℝ) →L[ℝ] (K → ℝ)) - A)
            * neumannResolvent A lam) y := by
          rw [ContinuousLinearMap.mul_apply,
            ContinuousLinearMap.sub_apply,
            ContinuousLinearMap.smul_apply,
            ContinuousLinearMap.one_apply]
      _ = y := by rw [e3]; rfl

theorem neumannResolvent_eq_of_spec
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} {lam : ℝ}
    (hlam : ‖A‖ < lam) {R : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hR : ResolventSpec (expSemigroup A) lam R) :
    R = neumannResolvent A lam :=
  resolvent_unique (expSemigroup A) lam hR
    (neumannResolvent_spec hlam)

/-- The plain Neumann bound: `||R(lam)|| <= (lam -
||A||)^-1` for `lam > ||A||`, from the triangle
inequality lower bound for `lam - A`. -/
theorem neumannResolvent_opNorm_le
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} {lam : ℝ}
    (hlam : ‖A‖ < lam) :
    ‖neumannResolvent A lam‖ ≤ (lam - ‖A‖)⁻¹ := by
  have hlam0 : 0 < lam := lt_of_le_of_lt (norm_nonneg A) hlam
  obtain ⟨h1, h2⟩ := (resolventSpec_expSemigroup_iff A lam
    (neumannResolvent A lam)).mp (neumannResolvent_spec hlam)
  have hlower : ∀ z : K → ℝ,
      (lam - ‖A‖) * ‖z‖ ≤ ‖lam • z - A z‖ := by
    intro z
    have hle : lam * ‖z‖
        ≤ ‖lam • z - A z‖ + ‖A‖ * ‖z‖ := by
      calc lam * ‖z‖ = ‖lam • z‖ := by
            rw [norm_smul, Real.norm_of_nonneg hlam0.le]
        _ = ‖(lam • z - A z) + A z‖ := by
            rw [sub_add_cancel]
        _ ≤ ‖lam • z - A z‖ + ‖A z‖ := norm_add_le _ _
        _ ≤ ‖lam • z - A z‖ + ‖A‖ * ‖z‖ := by
            have h := A.le_opNorm z
            linarith
    have hsub : lam * ‖z‖ - ‖A‖ * ‖z‖
        ≤ ‖lam • z - A z‖ := sub_le_iff_le_add.mpr hle
    rwa [← sub_mul] at hsub
  apply ContinuousLinearMap.opNorm_le_bound
  · exact inv_nonneg.mpr (sub_nonneg.mpr hlam.le)
  · intro y
    have h := hlower (neumannResolvent A lam y)
    rw [h2 y] at h
    calc ‖neumannResolvent A lam y‖
        = (lam - ‖A‖)⁻¹ * ((lam - ‖A‖)
            * ‖neumannResolvent A lam y‖) := by
          rw [← mul_assoc, inv_mul_cancel₀
            (sub_pos.mpr hlam).ne', one_mul]
      _ ≤ (lam - ‖A‖)⁻¹ * ‖y‖ :=
          mul_le_mul_of_nonneg_left h
            (inv_nonneg.mpr (sub_nonneg.mpr hlam.le))

/-- Under `DissBoundSeat`, the Neumann resolvent has
the contraction bound `||R(lam)|| <= lam^-1`. -/
theorem neumannResolvent_opNorm_le_of_dissBound
    {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hdiss : DissBoundSeat A) {lam : ℝ} (hlam : 0 < lam)
    (hlamA : ‖A‖ < lam) :
    ‖neumannResolvent A lam‖ ≤ lam⁻¹ := by
  obtain ⟨h1, h2⟩ := (resolventSpec_expSemigroup_iff A lam
    (neumannResolvent A lam)).mp (neumannResolvent_spec hlamA)
  apply ContinuousLinearMap.opNorm_le_bound
  · exact inv_nonneg.mpr hlam.le
  · intro y
    have h := hdiss lam hlam (neumannResolvent A lam y)
    rw [h2 y] at h
    calc ‖neumannResolvent A lam y‖
        = lam⁻¹ * (lam * ‖neumannResolvent A lam y‖) := by
          rw [← mul_assoc, inv_mul_cancel₀ hlam.ne', one_mul]
      _ ≤ lam⁻¹ * ‖y‖ :=
          mul_le_mul_of_nonneg_left h
            (inv_nonneg.mpr hlam.le)

/-- The resolvent applied to a generator value:
`R(lam) (A z) = lam * R(lam) z - z` at a Neumann
parameter. -/
theorem neumannResolvent_apply_gen
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} {lam : ℝ}
    (hlam : ‖A‖ < lam) (z : K → ℝ) :
    neumannResolvent A lam (A z)
      = lam • neumannResolvent A lam z - z := by
  obtain ⟨h1, _h2⟩ := (resolventSpec_expSemigroup_iff A lam
    (neumannResolvent A lam)).mp (neumannResolvent_spec hlam)
  have h := h1 z
  rw [map_sub, map_smul] at h
  rw [sub_eq_iff_eq_add] at h
  rw [eq_sub_iff_add_eq, add_comm]
  exact h.symm

/-- The Yosida identity at a Neumann parameter:
`lam * (lam * R(lam) - 1) - A = R(lam) * A * A` as
operators. -/
theorem yosida_neumann_eq {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    {lam : ℝ} (hlam : ‖A‖ < lam) :
    lam • (lam • neumannResolvent A lam - 1) - A
      = neumannResolvent A lam * A * A := by
  ext y
  simp only [ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.one_apply,
    ContinuousLinearMap.mul_apply]
  rw [neumannResolvent_apply_gen hlam (A y),
    neumannResolvent_apply_gen hlam y]

/-- Operator-norm convergence of the Yosida
approximants built from the Neumann resolvent, under
any resolvent bound `b` with `b lam * ||A||^2 -> 0`. -/
theorem tendsto_yosida_neumann
    (A : (K → ℝ) →L[ℝ] (K → ℝ)) {b : ℝ → ℝ}
    (hb : ∀ lam : ℝ, ‖A‖ < lam →
      ‖neumannResolvent A lam‖ ≤ b lam)
    (hb0 : Tendsto (fun lam => b lam * ‖A‖ ^ 2) atTop
      (𝓝 0)) :
    Tendsto (fun lam =>
      lam • (lam • neumannResolvent A lam - 1)) atTop
      (𝓝 A) := by
  have hnorm : Tendsto (fun lam =>
      lam • (lam • neumannResolvent A lam - 1) - A) atTop
      (𝓝 0) := by
    refine squeeze_zero_norm' ?_ hb0
    filter_upwards [eventually_gt_atTop ‖A‖] with lam hlam
    rw [yosida_neumann_eq hlam]
    calc ‖neumannResolvent A lam * A * A‖
        ≤ ‖neumannResolvent A lam‖ * ‖A‖ * ‖A‖ :=
          le_trans (norm_mul_le _ _)
            (mul_le_mul_of_nonneg_right (norm_mul_le _ _)
              (norm_nonneg A))
      _ ≤ b lam * ‖A‖ * ‖A‖ :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (hb lam hlam)
              (norm_nonneg A)) (norm_nonneg A)
      _ = b lam * ‖A‖ ^ 2 := by rw [pow_two]; ring
  have h2 := hnorm.add (tendsto_const_nhds (x := A))
  have h3 := h2.congr (fun lam => sub_add_cancel _ _)
  simpa only [zero_add] using h3

/-! ## 6. Quasi-positivity: the bridge -/

/-- Off-diagonal entries nonnegative implies
quasi-positive: shift by the sum of the absolute
diagonal entries. -/
theorem quasiPos_of_entry {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hA : ∀ i j, i ≠ j → 0 ≤ entry A i j) : QuasiPos A := by
  refine ⟨∑ i, |entry A i i|, Finset.sum_nonneg
    (fun i _ => abs_nonneg _), ?_⟩
  apply posOp_of_entry_nonneg
  intro i j
  rw [entry_add_smul_one]
  by_cases h : i = j
  · rw [if_pos h]
    have hle : |entry A i i| ≤ ∑ k, |entry A k k| :=
      Finset.single_le_sum (f := fun k => |entry A k k|)
        (fun k _ => abs_nonneg _) (Finset.mem_univ i)
    have hij : entry A i j = entry A i i := by rw [h]
    rw [hij]
    linarith [neg_le_abs (entry A i i)]
  · rw [if_neg h]
    simpa using hA i j h

/-- Semigroup positivity forces the off-diagonal
entries to be nonnegative: at a basis vector `e_j`,
the orbit slope at `i != j` is the entry, and the
orbit stays positive. -/
theorem entry_offdiag_of_sgPos {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hSG : SGPos A) {i j : K} (hij : i ≠ j) :
    0 ≤ entry A i j := by
  have hf : Pos (Pi.single j (1 : ℝ)) := by
    intro k
    by_cases h : k = j
    · subst h; simp [Pi.single_eq_same]
    · simp [Pi.single_apply, h]
  have hgen := expSemigroup_hasGen A
    (Pi.single j (1 : ℝ) : K → ℝ)
  have hlim : Tendsto
      (fun h : ℝ => h⁻¹ * (((expSemigroup A).toFun h
        (Pi.single j (1 : ℝ))) i))
      (𝓝[>] 0) (𝓝 (entry A i j)) := by
    have hcomp := ((ContinuousLinearMap.proj (R := ℝ) i).continuous.tendsto _).comp hgen
    apply hcomp.congr'
    filter_upwards [self_mem_nhdsWithin] with h hh
    have hfi : (Pi.single j (1 : ℝ) : K → ℝ) i = 0 := by
      rw [Pi.single_apply, if_neg hij]
    simp [ContinuousLinearMap.proj_apply,
      Pi.smul_apply, Pi.sub_apply, hfi, smul_eq_mul, entry]
  apply ge_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with h hh
  have hh0 : 0 < h := hh
  have hpos := hSG h hh0.le (Pi.single j (1 : ℝ)) hf i
  exact mul_nonneg (inv_nonneg.mpr hh0.le) hpos

theorem quasiPos_of_sgPos {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hSG : SGPos A) : QuasiPos A :=
  quasiPos_of_entry (fun i j hij =>
    entry_offdiag_of_sgPos hSG hij)

/-- Resolvent positivity at large parameters forces
the off-diagonal entries to be nonnegative: the
operators `lam * (lam * R(lam) - 1)` converge to `A`
in operator norm (`tendsto_yosida_neumann`), their
`(i, j)` entries are `lam^2 * (R(lam))_{ij} >= 0`,
and entries are continuous in the operator. -/
theorem entry_offdiag_of_resPosLarge
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} (hR : ResPosLarge A)
    {i j : K} (hij : i ≠ j) : 0 ≤ entry A i j := by
  obtain ⟨Lam, hLam⟩ := hR
  have hY : Tendsto (fun lam =>
      lam • (lam • neumannResolvent A lam - 1)) atTop
      (𝓝 A) := by
    apply tendsto_yosida_neumann A
      (b := fun lam => (lam - ‖A‖)⁻¹)
    · intro lam hlam
      exact neumannResolvent_opNorm_le hlam
    · have hinv : Tendsto (fun lam : ℝ => (lam - ‖A‖)⁻¹)
          atTop (𝓝 0) := by
        apply tendsto_inv_atTop_zero.comp
        have htop : Tendsto (fun lam : ℝ => lam - ‖A‖)
            atTop atTop := by
          have h := tendsto_atTop_add_const_right atTop
            (-‖A‖) tendsto_id
          simp only [sub_eq_add_neg]
          exact h
        exact htop
      have := hinv.mul (tendsto_const_nhds
        (x := ‖A‖ ^ 2))
      simpa using this
  have hlim : Tendsto (fun lam =>
      entry (lam • (lam • neumannResolvent A lam - 1)) i j)
      atTop (𝓝 (entry A i j)) := by
    have h1 : Tendsto (fun lam =>
        (lam • (lam • neumannResolvent A lam - 1))
          (Pi.single j (1 : ℝ))) atTop
        (𝓝 (A (Pi.single j (1 : ℝ)))) := by
      apply Filter.Tendsto.congr' _
        (((ContinuousLinearMap.apply ℝ (K → ℝ)
          (Pi.single j (1 : ℝ))).continuous.tendsto _).comp hY)
      filter_upwards with lam
      simp only [Function.comp_apply,
        ContinuousLinearMap.apply_apply]
    apply Filter.Tendsto.congr' _
      (((ContinuousLinearMap.proj (R := ℝ) i).continuous.tendsto _).comp h1)
    filter_upwards with lam
    simp only [Function.comp_apply,
      ContinuousLinearMap.proj_apply, entry]
  apply ge_of_tendsto hlim
  filter_upwards [eventually_gt_atTop (max Lam ‖A‖)] with
    lam hlam
  have hlamA : ‖A‖ < lam := lt_of_le_of_lt
    (le_max_right Lam ‖A‖) hlam
  have hlam0 : 0 < lam := lt_of_le_of_lt (norm_nonneg A)
    hlamA
  have hpos : PosOp (neumannResolvent A lam) :=
    hLam lam (lt_of_le_of_lt (le_max_left Lam ‖A‖) hlam)
      _ (neumannResolvent_spec hlamA)
  have hentry : 0 ≤ entry (neumannResolvent A lam) i j :=
    entry_nonneg_of_posOp hpos i j
  have heq : entry
      (lam • (lam • neumannResolvent A lam - 1)) i j
      = lam * (lam * entry (neumannResolvent A lam) i j) := by
    have h1 : (Pi.single j (1 : ℝ) : K → ℝ) i = 0 := by
      rw [Pi.single_apply, if_neg hij]
    simp only [entry, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.one_apply, Pi.smul_apply,
      Pi.sub_apply, smul_eq_mul, h1, sub_zero]
  rw [heq]
  exact mul_nonneg hlam0.le
    (mul_nonneg hlam0.le hentry)

theorem quasiPos_of_resPosLarge
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} (hR : ResPosLarge A) :
    QuasiPos A :=
  quasiPos_of_entry (fun i j hij =>
    entry_offdiag_of_resPosLarge hR hij)

/-- The resolvent of the shifted generator is the
resolvent of the original: shifting the generator by
`c` shifts the resolvent parameter by `c`. -/
theorem resolventSpec_shift
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} {c lam : ℝ}
    {R : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hR : ResolventSpec (expSemigroup (A + c • 1))
      (lam + c) R) :
    ResolventSpec (expSemigroup A) lam R := by
  rw [resolventSpec_expSemigroup_iff] at hR ⊢
  have hv : ∀ x : K → ℝ, (lam + c) • x - (A + c • 1) x
      = lam • x - A x := by
    intro x
    simp only [ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.one_apply, add_smul]
    abel
  have hv2 : ∀ y : K → ℝ,
      (lam + c) • R y - (A + c • 1) (R y)
        = lam • R y - A (R y) := by
    intro y
    simp only [ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.one_apply, add_smul]
    abel
  exact ⟨fun x => by rw [← hv x]; exact hR.1 x,
    fun y => by rw [← hv2 y]; exact hR.2 y⟩

/-- The Neumann resolvent of a positive operator is
positive (Neumann series of positive terms). -/
theorem posOp_neumannResolvent
    {B : (K → ℝ) →L[ℝ] (K → ℝ)} (hB : PosOp B)
    {mu : ℝ} (hmu : ‖B‖ < mu) :
    PosOp (neumannResolvent B mu) := by
  have hmu0 : 0 < mu := lt_of_le_of_lt (norm_nonneg B) hmu
  have hnorm : ‖mu⁻¹ • B‖ < 1 := by
    rw [norm_smul, Real.norm_of_nonneg
      (inv_nonneg.mpr hmu0.le), mul_comm]
    exact (div_lt_one hmu0).mpr hmu
  have hS : PosOp (∑' n : ℕ, (mu⁻¹ • B) ^ n) :=
    posOp_tsum (summable_geometric_of_norm_lt_one hnorm)
      (fun n => posOp_pow _ (posOp_smul
        (inv_nonneg.mpr hmu0.le) hB) n)
  exact posOp_smul (inv_nonneg.mpr hmu0.le) hS

/-- Quasi-positivity implies resolvent positivity at
all large parameters: the given resolvent equals the
Neumann resolvent of the shifted generator, which is
positive. -/
theorem resPosLarge_of_quasiPos
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} (hA : QuasiPos A) :
    ResPosLarge A := by
  obtain ⟨c, hc, hB⟩ := hA
  refine ⟨‖A‖ + ‖A + c • 1‖, fun lam hlam R hR => ?_⟩
  have hlamA : ‖A‖ < lam := lt_of_le_of_lt
    (le_add_of_nonneg_right (norm_nonneg _)) hlam
  have hmu : ‖A + c • 1‖ < lam + c :=
    (lt_of_le_of_lt
      (le_add_of_nonneg_left (norm_nonneg A)) hlam).trans_le
      (le_add_of_nonneg_right hc)
  have hS : ResolventSpec (expSemigroup A) lam
      (neumannResolvent (A + c • 1) (lam + c)) :=
    resolventSpec_shift (neumannResolvent_spec hmu)
  have hReq : R = neumannResolvent (A + c • 1) (lam + c) :=
    resolvent_unique (expSemigroup A) lam hR hS
  rw [hReq]
  exact posOp_neumannResolvent hB hmu

/-- Quasi-positivity implies semigroup positivity:
write the generator as the positive shifted generator
minus a scalar, and use the exponential series for
the positive part. -/
theorem sgPos_of_quasiPos {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hA : QuasiPos A) : SGPos A := by
  obtain ⟨c, hc, hB⟩ := hA
  intro t ht
  have hAeq : A = (A + c • 1) - c • 1 :=
    (add_sub_cancel_right A (c • (1 :
      (K → ℝ) →L[ℝ] (K → ℝ)))).symm
  have hdecomp : t • A
      = t • (A + c • 1) + (-(t * c)) • 1 := by
    conv_lhs => rw [hAeq]
    module
  rw [expSemigroup_toFun, hdecomp]
  have hcomm : Commute (t • (A + c • 1))
      ((-(t * c)) • (1 : (K → ℝ) →L[ℝ] (K → ℝ))) :=
    ((Commute.one_right _).smul_left t).smul_right _
  have hexp : NormedSpace.exp
      (t • (A + c • 1) + (-(t * c)) • 1)
      = NormedSpace.exp (t • (A + c • 1))
        * NormedSpace.exp ((-(t * c)) • 1) := by
    letI : NormedAlgebra ℚ ((K → ℝ) →L[ℝ] (K → ℝ)) :=
      NormedAlgebra.restrictScalars ℚ ℝ _
    exact NormedSpace.exp_add_of_commute hcomm
  rw [hexp, exp_smul_one]
  exact posOp_mul (posOp_exp hB ht)
    (posOp_smul (Real.exp_nonneg _) posOp_one)

/-- **Positivity duality at the finite C(K) seat,
resolvent direction:** semigroup positivity implies
resolvent positivity at all large parameters. -/
theorem sgPos_resPosLarge {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hSG : SGPos A) : ResPosLarge A :=
  resPosLarge_of_quasiPos (quasiPos_of_sgPos hSG)

/-- **Positivity duality at the finite C(K) seat,
semigroup direction:** resolvent positivity at all
large parameters implies semigroup positivity. -/
theorem resPosLarge_sgPos {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hR : ResPosLarge A) : SGPos A :=
  sgPos_of_quasiPos (quasiPos_of_resPosLarge hR)

/-- **Positivity duality at the finite C(K) seat
(headline):** the generated semigroup is positive if
and only if the resolvent is positive at all large
parameters. -/
theorem sgPos_iff_resPosLarge
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} :
    SGPos A ↔ ResPosLarge A :=
  ⟨sgPos_resPosLarge, resPosLarge_sgPos⟩

/-! ## 7. Contraction duality -/

/-- `DissBoundSeat` is SHELF-1b's `DissBound` at the
top submodule, for the linear map underlying `A`. -/
theorem dissBoundSeat_iff
    (A : (K → ℝ) →L[ℝ] (K → ℝ)) :
    DissBoundSeat A ↔ DissBound ⊤
      (A.toLinearMap.comp (⊤ : Submodule ℝ (K → ℝ)).subtype) := by
  constructor
  · intro h lam hlam x
    exact h lam hlam (x : K → ℝ)
  · intro h lam hlam x
    exact h lam hlam ⟨x, Submodule.mem_top⟩

/-- Contraction of the generated semigroup implies
`DissBoundSeat`: this is SHELF-1b's `gen_diss_bound`
applied to `expSemigroup A`, whose generator value at
`x` is `A x` (SHELF-1a's `expSemigroup_hasGen`). -/
theorem dissBound_of_sgContr {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hSG : SGContr A) : DissBoundSeat A :=
  fun lam hlam x =>
    gen_diss_bound (expSemigroup A) hSG
      (expSemigroup_hasGen A x) hlam

/-- The resolvent contraction bound, at every
parameter where a `ResolventSpec` holds, from
`DissBoundSeat`: for `x = R y`, `lam * ||x|| <=
||lam * x - A x|| = ||y||`. -/
theorem resolvent_opNorm_le_of_dissBound
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} (hdiss : DissBoundSeat A)
    {lam : ℝ} (hlam : 0 < lam)
    {R : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hR : ResolventSpec (expSemigroup A) lam R) :
    ‖R‖ ≤ lam⁻¹ := by
  obtain ⟨h1, h2⟩ := (resolventSpec_expSemigroup_iff A lam
    R).mp hR
  apply ContinuousLinearMap.opNorm_le_bound
  · exact inv_nonneg.mpr hlam.le
  · intro y
    have h := hdiss lam hlam (R y)
    rw [h2 y] at h
    calc ‖R y‖ = lam⁻¹ * (lam * ‖R y‖) := by
          rw [← mul_assoc, inv_mul_cancel₀ hlam.ne',
            one_mul]
      _ ≤ lam⁻¹ * ‖y‖ :=
          mul_le_mul_of_nonneg_left h
            (inv_nonneg.mpr hlam.le)

/-- `DissBoundSeat` implies contraction of the
generated semigroup. Proof by the Yosida
approximants: at every Neumann parameter the
approximant `A_lam = lam * (lam * R(lam) - 1)` is
the Yosida approximant of a resolvent family with
the contraction bound, so `exp (t A_lam)` is a
contraction by SHELF-1b's `exp_yosidaA_opNorm_le`;
and `A_lam -> A` in operator norm
(`tendsto_yosida_neumann` with the contraction
bound), so `exp (t A_lam) x -> exp (t A) x` and the
bound passes to the limit. -/
theorem dissBound_sgContr {A : (K → ℝ) →L[ℝ] (K → ℝ)}
    (hdiss : DissBoundSeat A) : SGContr A := by
  -- The resolvent family: Neumann resolvent above the
  -- threshold, zero below it (the bound `||R mu|| <=
  -- mu^-1` holds for the zero operator too).
  set Rfam : ℝ → (K → ℝ) →L[ℝ] (K → ℝ) := fun mu =>
    if ‖A‖ < mu then neumannResolvent A mu else 0 with hRfam
  have hbd : ∀ mu : ℝ, 0 < mu → ‖Rfam mu‖ ≤ mu⁻¹ := by
    intro mu hmu
    by_cases h : ‖A‖ < mu
    · rw [hRfam]; simp only [h, if_true]
      exact neumannResolvent_opNorm_le_of_dissBound
        hdiss hmu h
    · rw [hRfam]; simp only [h, if_false]
      simp [inv_nonneg.mpr hmu.le]
  have hY : Tendsto (fun lam => yosidaA Rfam lam) atTop
      (𝓝 A) := by
    have hcong : (fun lam => yosidaA Rfam lam)
        =ᶠ[atTop] (fun lam =>
          lam • (lam • neumannResolvent A lam - 1)) := by
      filter_upwards [eventually_gt_atTop ‖A‖] with lam hlam
      have hRlam : Rfam lam = neumannResolvent A lam := by
        rw [hRfam]
        exact if_pos hlam
      show lam • (lam • Rfam lam - 1)
        = lam • (lam • neumannResolvent A lam - 1)
      rw [hRlam]
    apply (tendsto_congr' hcong.symm).mp
    apply tendsto_yosida_neumann A
      (b := fun lam => lam⁻¹)
    · intro lam hlam
      exact neumannResolvent_opNorm_le_of_dissBound
        hdiss (lt_of_le_of_lt (norm_nonneg A) hlam) hlam
    · have := tendsto_inv_atTop_zero.mul
        (tendsto_const_nhds (x := ‖A‖ ^ 2))
      simpa using this
  intro t ht
  rw [expSemigroup_toFun]
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro x
  have hlim : Tendsto (fun lam =>
      NormedSpace.exp (t • yosidaA Rfam lam) x) atTop
      (𝓝 (NormedSpace.exp (t • A) x)) := by
    have h1 : Tendsto (fun lam => t • yosidaA Rfam lam)
        atTop (𝓝 (t • A)) := hY.const_smul t
    letI : NormedAlgebra ℚ ((K → ℝ) →L[ℝ] (K → ℝ)) :=
      NormedAlgebra.restrictScalars ℚ ℝ _
    have h2 := (NormedSpace.exp_continuous.tendsto _).comp h1
    have h3 := ((ContinuousLinearMap.apply ℝ (K → ℝ)
      x).continuous.tendsto _).comp h2
    exact h3
  have hnorm : Tendsto (fun lam =>
      ‖NormedSpace.exp (t • yosidaA Rfam lam) x‖) atTop
      (𝓝 ‖NormedSpace.exp (t • A) x‖) := hlim.norm
  have hle : ‖NormedSpace.exp (t • A) x‖ ≤ ‖x‖ := by
    refine le_of_tendsto_of_tendsto hnorm
      tendsto_const_nhds ?_
    filter_upwards [eventually_gt_atTop ‖A‖] with lam hlam
    have hlam0 : 0 < lam :=
      lt_of_le_of_lt (norm_nonneg A) hlam
    calc ‖NormedSpace.exp (t • yosidaA Rfam lam) x‖
        ≤ ‖NormedSpace.exp (t • yosidaA Rfam lam)‖ * ‖x‖ :=
          ContinuousLinearMap.le_opNorm _ _
      _ ≤ 1 * ‖x‖ := mul_le_mul_of_nonneg_right
            (exp_yosidaA_opNorm_le Rfam hbd hlam0 ht)
            (norm_nonneg x)
      _ = ‖x‖ := one_mul _
  simpa using hle

/-- **Contraction duality at the finite C(K) seat
(headline):** the generated semigroup is contractive
if and only if the generator is dissipative in
SHELF-1b's resolvent-bound form. -/
theorem sgContr_iff_dissBound
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} :
    SGContr A ↔ DissBoundSeat A :=
  ⟨dissBound_of_sgContr, dissBound_sgContr⟩

/-- **Combined duality at the finite C(K) seat
(headline):** the generated semigroup is a positive
contraction semigroup if and only if the resolvent
is positive at all large parameters and the
generator is dissipative (`DissBoundSeat`). The
resolvent contraction bound
`resolvent_opNorm_le_of_dissBound` is the
contraction half on the resolvent side. -/
theorem sgPosContr_iff_resPosDiss
    {A : (K → ℝ) →L[ℝ] (K → ℝ)} :
    (SGPos A ∧ SGContr A)
      ↔ (ResPosLarge A ∧ DissBoundSeat A) := by
  constructor
  · intro h
    exact ⟨sgPos_resPosLarge h.1,
      dissBound_of_sgContr h.2⟩
  · intro h
    exact ⟨resPosLarge_sgPos h.1,
      dissBound_sgContr h.2⟩

/-! ## 8. SHELF-5 read-backs -/

/-- A real matrix as a continuous linear map on the
seat, via `LinearMap.mkContinuous` with the explicit
entry-sum bound. -/
noncomputable def matCLM (M : Matrix K K ℝ) :
    (K → ℝ) →L[ℝ] (K → ℝ) :=
  (Matrix.toLin' M).mkContinuous (∑ i, ∑ j, |M i j|) (by
    intro f
    rw [Matrix.toLin'_apply]
    have hC : 0 ≤ (∑ i, ∑ j, |M i j|) * ‖f‖ :=
      mul_nonneg (Finset.sum_nonneg
        (fun i _ => Finset.sum_nonneg
          (fun j _ => abs_nonneg _))) (norm_nonneg f)
    rw [pi_norm_le_iff_of_nonneg hC]
    intro i
    calc ‖(M *ᵥ f) i‖
        = ‖∑ j, M i j * f j‖ := by
          rw [Matrix.mulVec_apply_eq_sum]
      _ ≤ (∑ j, |M i j|) * ‖f‖ := by
          rw [Finset.sum_mul]
          refine le_trans (norm_sum_le _ _)
            (Finset.sum_le_sum (fun j _ => ?_))
          rw [norm_mul, Real.norm_eq_abs]
          exact mul_le_mul_of_nonneg_left
            ((pi_norm_le_iff_of_nonneg
              (norm_nonneg f)).mp le_rfl j) (abs_nonneg _)
      _ ≤ (∑ i, ∑ j, |M i j|) * ‖f‖ := by
          apply mul_le_mul_of_nonneg_right _ (norm_nonneg f)
          exact Finset.single_le_sum
            (f := fun i => ∑ j, |M i j|)
            (fun k _ => Finset.sum_nonneg
              (fun j _ => abs_nonneg _)) (Finset.mem_univ i))

theorem matCLM_apply (M : Matrix K K ℝ) (f : K → ℝ) :
    matCLM M f = M *ᵥ f := by
  simp [matCLM, Matrix.toLin'_apply]

/-- A strictly positive matrix (SHELF-5's hypothesis)
induces a positive operator on the seat. -/
theorem pf_posOp {M : Matrix K K ℝ}
    (hM : ∀ i j, 0 < M i j) : PosOp (matCLM M) := by
  intro f hf i
  rw [matCLM_apply]
  have hsum : (M *ᵥ f) i = ∑ j, M i j * f j :=
    Matrix.mulVec_apply_eq_sum M f i
  rw [hsum]
  exact Finset.sum_nonneg
    (fun j _ => mul_nonneg (hM i j).le (hf j))

/-- SHELF-5 read-back 1: the exponential semigroup of
a strictly positive matrix is positive. -/
theorem pf_posOp_exp {M : Matrix K K ℝ}
    (hM : ∀ i j, 0 < M i j) : SGPos (matCLM M) :=
  posOp_expSemigroup (pf_posOp hM)

/-- If `X x = 0`, then `exp X x = x`: every series
term past the constant vanishes. -/
theorem exp_apply_of_apply_eq_zero
    {X : (K → ℝ) →L[ℝ] (K → ℝ)} {x : K → ℝ}
    (hX : X x = 0) : NormedSpace.exp X x = x := by
  have hsum := hasSum_exp_apply X x
  have hterm : ∀ n : ℕ,
      (((Nat.factorial n : ℝ))⁻¹ • X ^ n) x
        = if n = 0 then x else 0 := by
    intro n
    cases n with
    | zero => simp
    | succ m =>
      rw [if_neg (Nat.succ_ne_zero m)]
      have hpow : (X ^ (m + 1)) x = 0 := by
        rw [pow_succ]
        simp [ContinuousLinearMap.mul_apply, hX]
      rw [ContinuousLinearMap.smul_apply, hpow]
      simp
  have hsumm : Summable
      (fun n => (((Nat.factorial n : ℝ))⁻¹ • X ^ n) x) :=
    hsum.summable
  calc NormedSpace.exp X x
      = ∑' n, (((Nat.factorial n : ℝ))⁻¹ • X ^ n) x :=
        hsum.tsum_eq.symm
    _ = (((Nat.factorial 0 : ℝ))⁻¹ • X ^ 0) x := by
        apply tsum_eq_single 0
        intro b hb
        rw [hterm b, if_neg hb]
    _ = x := by simp

/-- SHELF-5 read-back 2: the Perron vector supplied
by `perronFrobenius` is a stationary vector of the
positive contraction-shifted semigroup generated by
`M - lam * 1`, and that shifted semigroup is
positive (quasi-positivity with shift `lam`, through
the duality of section 6). -/
theorem pf_stationary {M : Matrix K K ℝ}
    (hM : ∀ i j, 0 < M i j) :
    ∃ (lam : ℝ) (x : K → ℝ), 0 < lam ∧ (∀ i, 0 < x i)
      ∧ (∀ t : ℝ, 0 ≤ t →
          (expSemigroup (matCLM M - lam • 1)).toFun t x
            = x)
      ∧ SGPos (matCLM M - lam • 1) := by
  obtain ⟨lam, x, hlam, hxpos, hAx, _hspec⟩ :=
    perronFrobenius hM
  refine ⟨lam, x, hlam, hxpos, fun t ht => ?_,
    sgPos_of_quasiPos ⟨lam, hlam.le, ?_⟩⟩
  · rw [expSemigroup_toFun]
    have hgen : (matCLM M - lam • 1) x = 0 := by
      rw [ContinuousLinearMap.sub_apply, matCLM_apply,
        ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.one_apply, hAx]
      simp
    have hX : (t • (matCLM M - lam • 1)) x = 0 := by
      rw [ContinuousLinearMap.smul_apply, hgen]
      simp
    exact exp_apply_of_apply_eq_zero hX
  · have heq : (matCLM M - lam • 1) + lam • 1
        = matCLM M := sub_add_cancel _ _
    rw [heq]
    exact pf_posOp hM

end ThetLogos
