/-! ## The discriminant and the elliptic instance -/

/-- The discriminant of `y² + y = x³ − x² − 10x − 20` is `-161051`
(`= -11⁵`). -/
theorem E3_delta : E3.Δ = -161051 := by
  norm_num [E3, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
    WeierstrassCurve.b₆, WeierstrassCurve.b₈]

instance : E3.IsElliptic :=
  ⟨by rw [E3_delta]; exact isUnit_iff_ne_zero.mpr (by norm_num)⟩

/-! ## The candidate enumeration over `ℤ` -/

/-- The candidate enumeration: an integer whose square divides
`161051 = 11⁵` is one of `±1, ±11, ±121`. From `m² ∣ 11⁵` one gets
`|m| ∣ |m|² ∣ 11⁵`, so `|m| = 11ᵏ` with `k ≤ 5` by
`Nat.dvd_prime_pow`; then `|m|² = 11²ᵏ ∣ 11⁵` forces `2k ≤ 5`,
hence `k ≤ 2` and `|m| ∈ {1, 11, 121}`. -/
theorem eq_of_sq_dvd_161051 (m : ℤ) (h : m ^ 2 ∣ 161051) :
    m = 1 ∨ m = -1 ∨ m = 11 ∨ m = -11 ∨ m = 121 ∨ m = -121 := by
  have hnat : m.natAbs ^ 2 ∣ 11 ^ 5 := by
    have h1 : (m ^ 2).natAbs ∣ (161051 : ℤ).natAbs :=
      Int.natAbs_dvd_natAbs.mpr h
    rw [Int.natAbs_pow] at h1
    have h2 : (161051 : ℤ).natAbs = 11 ^ 5 := by
      have e : (161051 : ℤ) = ((11 ^ 5 : ℕ) : ℤ) := by norm_num
      rw [e, Int.natAbs_natCast]
    rwa [h2] at h1
  obtain ⟨k, hk5, hak⟩ := (Nat.dvd_prime_pow (by norm_num : Nat.Prime 11)).mp
    (dvd_trans (dvd_pow_self m.natAbs (by norm_num : (2 : ℕ) ≠ 0)) hnat)
  have h2k : 2 * k ≤ 5 := by
    have hdvd : (11 : ℕ) ^ (2 * k) ∣ 11 ^ 5 := by
      have e : m.natAbs ^ 2 = (11 : ℕ) ^ (2 * k) := by
        rw [hak, ← pow_mul, Nat.mul_comm k 2]
      rwa [e] at hnat
    exact (Nat.pow_dvd_pow_iff_le_right (by norm_num : (1 : ℕ) < 11)).mp hdvd
  have hk2 : k ≤ 2 := by omega
  interval_cases k <;>
    rcases (Int.natAbs_eq_iff).mp hak with hm | hm <;>
    norm_num at hm <;> omega

/-- **The sweep's arithmetic core, closed.** An integer point of
`y² + y = x³ − x² − 10x − 20` whose ordinate satisfies the
corrected Nagell–Lutz alternative (`2·yi + 1 = 0` or
`(2·yi + 1)² ∣ 161051`) is one of `(5, 5)`, `(5, -6)`, `(16, 60)`,
`(16, -61)`. The first alternative is impossible (`2·yi + 1` is
odd). The enumeration lemma gives `yi ∈ {0, -1, 5, -6, 60, -61}`;
in each case `0 ≤ yi² + yi ≤ 3660`, while the right side is at
least `4434` for `xi ≥ 17` and at most `-26` for `xi ≤ -3`, so
`-2 ≤ xi ≤ 16`, and the remaining `6 × 19` pairs are checked one
by one. The enumeration closes; it is not a sample. -/
theorem e3_int_point_cases {xi yi : ℤ}
    (heq : yi ^ 2 + yi = xi ^ 3 - xi ^ 2 - 10 * xi - 20)
    (hy : 2 * yi + 1 = 0 ∨ (2 * yi + 1) ^ 2 ∣ 161051) :
    (xi = 5 ∧ yi = 5) ∨ (xi = 5 ∧ yi = -6) ∨ (xi = 16 ∧ yi = 60) ∨
    (xi = 16 ∧ yi = -61) := by
  have hyi : yi = 0 ∨ yi = -1 ∨ yi = 5 ∨ yi = -6 ∨ yi = 60 ∨ yi = -61 := by
    rcases hy with h0 | hdvd
    · omega
    · rcases eq_of_sq_dvd_161051 (2 * yi + 1) hdvd with
        h | h | h | h | h | h <;> omega
  have hnn : 0 ≤ yi ^ 2 + yi := by
    have hrw : yi ^ 2 + yi = yi * (yi + 1) := by ring
    rw [hrw]
    by_cases h0 : 0 ≤ yi
    · exact mul_nonneg h0 (by omega)
    · exact mul_nonneg_of_nonpos_of_nonpos (by omega) (by omega)
  have hle : yi ^ 2 + yi ≤ 3660 := by
    rcases hyi with rfl | rfl | rfl | rfl | rfl | rfl <;> norm_num
  have hxi16 : xi ≤ 16 := by
    by_contra hcon
    have h17 : (17 : ℤ) ≤ xi := by omega
    have hbig : (4434 : ℤ) ≤ xi ^ 3 - xi ^ 2 - 10 * xi - 20 := by
      nlinarith [sq_nonneg (xi - 17),
        mul_nonneg (show (0 : ℤ) ≤ xi - 17 by omega) (sq_nonneg (xi - 17)),
        show (0 : ℤ) ≤ xi - 17 by omega]
    omega
  have hxilo : -2 ≤ xi := by
    by_contra hcon
    have h3 : xi ≤ -3 := by omega
    have hsmall : xi ^ 3 - xi ^ 2 - 10 * xi - 20 ≤ -26 := by
      nlinarith [sq_nonneg (-xi - 3),
        mul_nonneg (show (0 : ℤ) ≤ -xi - 3 by omega) (sq_nonneg (-xi - 3)),
        show (0 : ℤ) ≤ -xi - 3 by omega]
    omega
  rcases hyi with rfl | rfl | rfl | rfl | rfl | rfl <;>
    interval_cases xi <;> revert heq <;> decide

/-! ## The four affine torsion points -/

/-- The point `(5, 5)` on `E3` — the generator of the torsion
subgroup. -/
def E3P55 : E3.toAffine.Point :=
  WeierstrassCurve.Affine.Point.some 5 5 (by
    apply WeierstrassCurve.Affine.equation_iff_nonsingular.mp
    rw [WeierstrassCurve.Affine.equation_iff]; norm_num [E3])

/-- The point `(5, -6)` on `E3` — `4P = -P`. -/
def E3P5m6 : E3.toAffine.Point :=
  WeierstrassCurve.Affine.Point.some 5 (-6) (by
    apply WeierstrassCurve.Affine.equation_iff_nonsingular.mp
    rw [WeierstrassCurve.Affine.equation_iff]; norm_num [E3])

/-- The point `(16, 60)` on `E3` — `3P`. -/
def E3P1660 : E3.toAffine.Point :=
  WeierstrassCurve.Affine.Point.some 16 60 (by
    apply WeierstrassCurve.Affine.equation_iff_nonsingular.mp
    rw [WeierstrassCurve.Affine.equation_iff]; norm_num [E3])

/-- The point `(16, -61)` on `E3` — `2P`. -/
def E3P16m61 : E3.toAffine.Point :=
  WeierstrassCurve.Affine.Point.some 16 (-61) (by
    apply WeierstrassCurve.Affine.equation_iff_nonsingular.mp
    rw [WeierstrassCurve.Affine.equation_iff]; norm_num [E3])

/-- Negation sends `(5, 5)` to `(5, -6)`: the negation formula
sends `y` to `-y - a₁x - a₃ = -y - 1` for `E3`. -/
theorem E3_neg_P55 : -E3P55 = E3P5m6 := by
  rw [E3P55, E3P5m6, WeierstrassCurve.Affine.Point.neg_some]
  congr 1
  norm_num [WeierstrassCurve.Affine.negY, E3]

/-- Negation sends `(16, 60)` to `(16, -61)`. -/
theorem E3_neg_P1660 : -E3P1660 = E3P16m61 := by
  rw [E3P1660, E3P16m61, WeierstrassCurve.Affine.Point.neg_some]
  congr 1
  norm_num [WeierstrassCurve.Affine.negY, E3]

/-! ## Point arithmetic: `(5, 5)` has exact order `5` -/

/-- `2 • (5, 5) = (16, -61)`: doubling at slope
`(3·25 - 2·5 - 10) / (2·5 + 1) = 55 / 11 = 5`. -/
theorem E3_two_nsmul_P55 : (2 : ℕ) • E3P55 = E3P16m61 := by
  rw [two_nsmul, E3P55, E3P16m61,
    WeierstrassCurve.Affine.Point.add_some (by
      norm_num [WeierstrassCurve.Affine.negY, E3])]
  congr 1
  · norm_num [E3, WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.slope,
      WeierstrassCurve.Affine.negY]
  · norm_num [E3, WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      WeierstrassCurve.Affine.slope, WeierstrassCurve.Affine.negY]

/-- `2 • (16, -61) = (5, -6)`: doubling at slope
`(3·256 - 2·16 - 10) / (2·(-61) + 1) = 726 / (-121) = -6`. -/
theorem E3_two_nsmul_P16m61 : (2 : ℕ) • E3P16m61 = E3P5m6 := by
  rw [two_nsmul, E3P16m61, E3P5m6,
    WeierstrassCurve.Affine.Point.add_some (by
      norm_num [WeierstrassCurve.Affine.negY, E3])]
  congr 1
  · norm_num [E3, WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.slope,
      WeierstrassCurve.Affine.negY]
  · norm_num [E3, WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      WeierstrassCurve.Affine.slope, WeierstrassCurve.Affine.negY]

/-- `3 • (5, 5) = (16, 60)`: `2P + P = (16, -61) + (5, 5)` at
secant slope `(-61 - 5) / (16 - 5) = -6`. -/
theorem E3_three_nsmul_P55 : (3 : ℕ) • E3P55 = E3P1660 := by
  have h3 : (3 : ℕ) • E3P55 = E3P16m61 + E3P55 := by
    rw [show (3 : ℕ) = 2 + 1 from rfl, add_nsmul, one_nsmul,
      E3_two_nsmul_P55]
  rw [h3, E3P16m61, E3P55, E3P1660,
    WeierstrassCurve.Affine.Point.add_some (by
      norm_num [WeierstrassCurve.Affine.negY, E3])]
  congr 1
  · norm_num [E3, WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.slope,
      WeierstrassCurve.Affine.negY]
  · norm_num [E3, WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      WeierstrassCurve.Affine.slope, WeierstrassCurve.Affine.negY]

/-- `4 • (5, 5) = (5, -6)`: `2 • (2 • (5, 5)) = 2 • (16, -61)`. -/
theorem E3_four_nsmul_P55 : (4 : ℕ) • E3P55 = E3P5m6 := by
  calc (4 : ℕ) • E3P55 = (2 : ℕ) • ((2 : ℕ) • E3P55) :=
        (mul_nsmul E3P55 2 2).symm
    _ = (2 : ℕ) • E3P16m61 := by rw [E3_two_nsmul_P55]
    _ = E3P5m6 := E3_two_nsmul_P16m61

/-- `5 • (5, 5) = O`: `4P + P = (5, -6) + (5, 5) = -P + P`. -/
theorem E3_five_nsmul_P55 : (5 : ℕ) • E3P55 = 0 := by
  have h5 : (5 : ℕ) • E3P55 = E3P5m6 + E3P55 := by
    rw [show (5 : ℕ) = 4 + 1 from rfl, add_nsmul, one_nsmul,
      E3_four_nsmul_P55]
  rw [h5, ← E3_neg_P55]
  exact neg_add_cancel _

/-! ## Torsion membership of the four affine points -/

/-- Auxiliary: any point of the form `k • (5, 5)` is torsion,
since `5 • (k • (5, 5)) = k • (5 • (5, 5)) = 0`. -/
theorem E3_point_mem_torsion_of {k : ℕ} {Q : E3.toAffine.Point}
    (hQ : Q = k • E3P55) :
    Q ∈ AddCommGroup.torsion E3.toAffine.Point :=
  (AddCommGroup.mem_torsion _).mpr
    (isOfFinAddOrder_iff_nsmul_eq_zero.mpr
      ⟨5, by norm_num, by
        rw [hQ, ← mul_nsmul, Nat.mul_comm k 5, mul_nsmul,
          E3_five_nsmul_P55]
        simp⟩)

/-- `(5, 5)` is torsion (order `5`). -/
theorem E3P55_mem_torsion :
    E3P55 ∈ AddCommGroup.torsion E3.toAffine.Point :=
  E3_point_mem_torsion_of (k := 1) (by rw [one_nsmul])

/-- `(5, -6) = 4 • (5, 5)` is torsion. -/
theorem E3P5m6_mem_torsion :
    E3P5m6 ∈ AddCommGroup.torsion E3.toAffine.Point :=
  E3_point_mem_torsion_of (k := 4) E3_four_nsmul_P55.symm

/-- `(16, 60) = 3 • (5, 5)` is torsion. -/
theorem E3P1660_mem_torsion :
    E3P1660 ∈ AddCommGroup.torsion E3.toAffine.Point :=
  E3_point_mem_torsion_of (k := 3) E3_three_nsmul_P55.symm

/-- `(16, -61) = 2 • (5, 5)` is torsion. -/
theorem E3P16m61_mem_torsion :
    E3P16m61 ∈ AddCommGroup.torsion E3.toAffine.Point :=
  E3_point_mem_torsion_of (k := 2) E3_two_nsmul_P55.symm

/-! ## The classification and the card -/

/-- **The sweep's conclusion at the level of points**, conditional
on the corrected seam: under `NagellLutzCriterionE3R` (stated
strength only — **K-BSD3-2R-c does not fire**), every torsion
point of `E3(ℚ)` — torsion in the criterion's own form,
`∃ n : ℤ, n ≠ 0 ∧ n • P = 0` — is one of `O`, `(5, 5)`, `(5, -6)`,
`(16, 60)`, `(16, -61)`. The affine case is decided by
`e3_int_point_cases`: the criterion gives integer coordinates on
`y² + y = x³ − x² − 10x − 20` with `2·yi + 1 = 0` or
`(2·yi + 1)² ∣ 161051`, and the closed enumeration leaves exactly
the four affine points. -/
theorem E3_point_eq_of_torsion (hNL : NagellLutzCriterionE3R)
    (P : E3.toAffine.Point) (htors : ∃ n : ℤ, n ≠ 0 ∧ n • P = 0) :
    P = 0 ∨ P = E3P55 ∨ P = E3P5m6 ∨ P = E3P1660 ∨ P = E3P16m61 := by
  cases P with
  | zero => exact Or.inl rfl
  | some x y h =>
    obtain ⟨xi, yi, hx, hy, hy0⟩ := hNL x y h htors
    have heq : y ^ 2 + y = x ^ 3 - x ^ 2 - 10 * x - 20 := by
      have heq0 := h.1
      rw [WeierstrassCurve.Affine.equation_iff] at heq0
      simp only [E3] at heq0
      linarith [heq0]
    rw [hx, hy] at heq
    have hZ : yi ^ 2 + yi = xi ^ 3 - xi ^ 2 - 10 * xi - 20 := by
      exact_mod_cast heq
    subst hx
    subst hy
    rcases e3_int_point_cases hZ hy0 with ⟨hxi, hyi⟩ | ⟨hxi, hyi⟩ |
      ⟨hxi, hyi⟩ | ⟨hxi, hyi⟩
    · subst hxi; subst hyi
      exact Or.inr (Or.inl (by simp [E3P55]))
    · subst hxi; subst hyi
      exact Or.inr (Or.inr (Or.inl (by simp [E3P5m6])))
    · subst hxi; subst hyi
      exact Or.inr (Or.inr (Or.inr (Or.inl (by simp [E3P1660]))))
    · subst hxi; subst hyi
      exact Or.inr (Or.inr (Or.inr (Or.inr (by simp [E3P16m61]))))

/-- The torsion membership characterization, conditional on the
corrected seam: `P ∈ E3(ℚ)_tors` iff `P` is one of `O`, `(5, 5)`,
`(5, -6)`, `(16, 60)`, `(16, -61)`. The forward direction is the
sweep (`E3_point_eq_of_torsion`, with Mathlib's natural-multiple
form of finite order converted to the criterion's integer-multiple
form, as in B2-1); the backward direction is the order-`5` fact at
the four affine points, and `0 ∈ tors` since the torsion subgroup
is a subgroup. -/
theorem e3_mem_torsion_iff (hNL : NagellLutzCriterionE3R)
    (P : E3.toAffine.Point) :
    P ∈ AddCommGroup.torsion E3.toAffine.Point ↔
      P = 0 ∨ P = E3P55 ∨ P = E3P5m6 ∨ P = E3P1660 ∨ P = E3P16m61 := by
  constructor
  · intro hP
    rw [AddCommGroup.mem_torsion, isOfFinAddOrder_iff_nsmul_eq_zero] at hP
    obtain ⟨n, hn, hns⟩ := hP
    apply E3_point_eq_of_torsion hNL P
    refine ⟨(n : ℤ), by exact_mod_cast hn.ne', ?_⟩
    simpa using hns
  · rintro (rfl | rfl | rfl | rfl | rfl)
    · exact AddSubgroup.zero_mem _
    · exact E3P55_mem_torsion
    · exact E3P5m6_mem_torsion
    · exact E3P1660_mem_torsion
    · exact E3P16m61_mem_torsion

/-- **BSD3-2R's sweep headline: the re-pin's `E3TorsionCardSeam`,
discharged conditional on the corrected seam**
`NagellLutzCriterionE3R`, at its stated strength only
(K-BSD3-2R-c does not fire). The torsion subgroup of `E3(ℚ)` is
exactly `{O, (5, 5), (5, -6), (16, 60), (16, -61)}` — cyclic of
order `5` generated by `(5, 5)`, the five points pairwise
distinct — hence `#tors = 5`. This is the `#tors = 5` the E3
re-pin consumes; it is conditional on the seam, and it closes
zero parts of the official BSD statement. -/
theorem e3TorsionCard_of_nagellLutzR (hNL : NagellLutzCriterionE3R) :
    E3TorsionCardSeam := by
  have hiff : ∀ P : E3.toAffine.Point,
      P ∈ AddCommGroup.torsion E3.toAffine.Point ↔
        P ∈ ({0, E3P55, E3P5m6, E3P1660, E3P16m61} :
          Finset E3.toAffine.Point) := by
    intro P
    constructor
    · intro hP
      rcases (e3_mem_torsion_iff hNL P).mp hP with rfl | rfl | rfl |
        rfl | rfl <;> simp
    · intro hP
      rw [Finset.mem_insert, Finset.mem_insert, Finset.mem_insert,
        Finset.mem_insert, Finset.mem_singleton] at hP
      exact (e3_mem_torsion_iff hNL P).mpr hP
  have hpropeq : (fun P : E3.toAffine.Point =>
        P ∈ AddCommGroup.torsion E3.toAffine.Point) =
      (fun P : E3.toAffine.Point =>
        P ∈ ({0, E3P55, E3P5m6, E3P1660, E3P16m61} :
          Finset E3.toAffine.Point)) :=
    funext fun P => propext (hiff P)
  have hcardS : ({0, E3P55, E3P5m6, E3P1660, E3P16m61} :
      Finset E3.toAffine.Point).card = 5 := by
    have d0a : (0 : E3.toAffine.Point) ≠ E3P55 :=
      fun h => (WeierstrassCurve.Affine.Point.some_ne_zero
        (W' := E3.toAffine) (x := 5) (y := 5) _) h.symm
    have d0b : (0 : E3.toAffine.Point) ≠ E3P5m6 :=
      fun h => (WeierstrassCurve.Affine.Point.some_ne_zero
        (W' := E3.toAffine) (x := 5) (y := -6) _) h.symm
    have d0c : (0 : E3.toAffine.Point) ≠ E3P1660 :=
      fun h => (WeierstrassCurve.Affine.Point.some_ne_zero
        (W' := E3.toAffine) (x := 16) (y := 60) _) h.symm
    have d0d : (0 : E3.toAffine.Point) ≠ E3P16m61 :=
      fun h => (WeierstrassCurve.Affine.Point.some_ne_zero
        (W' := E3.toAffine) (x := 16) (y := -61) _) h.symm
    have dab : E3P55 ≠ E3P5m6 := by
      intro h
      simp only [E3P55, E3P5m6,
        WeierstrassCurve.Affine.Point.some.injEq] at h
      norm_num at h
    have dac : E3P55 ≠ E3P1660 := by
      intro h
      simp only [E3P55, E3P1660,
        WeierstrassCurve.Affine.Point.some.injEq] at h
      norm_num at h
    have dad : E3P55 ≠ E3P16m61 := by
      intro h
      simp only [E3P55, E3P16m61,
