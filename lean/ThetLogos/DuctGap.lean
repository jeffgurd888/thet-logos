namespace ThetLogos

variable {V : Type*} [Fintype V] [DecidableEq V]

/-! ## §1. Attainment: the Fiedler infimum is a minimum, hence positive -/

/-- The energy (quadratic form) of the bridge Laplacian:
`energyForm w F = ∑ i, F i * (L F) i`. -/
def energyForm (w : V → V → ℝ) (F : V → ℝ) : ℝ :=
  ∑ i, F i * laplacianOp w F i

/-- The energy is continuous in the potential (it is a
polynomial in the coordinates). -/
theorem energyForm_continuous (w : V → V → ℝ) : Continuous (energyForm w) := by
  have h : (energyForm w)
      = fun F : V → ℝ => ∑ i, F i * (∑ j, w i j * (F i - F j)) := by
    funext F
    show (∑ i, F i * laplacianOp w F i)
        = ∑ i, F i * (∑ j, w i j * (F i - F j))
    exact Finset.sum_congr rfl fun i _ => by rw [laplacianOp_apply]
  rw [h]
  refine continuous_finsetSum _ fun i _ => ?_
  refine Continuous.mul (continuous_apply i) ?_
  refine continuous_finsetSum _ fun j _ => ?_
  exact continuous_const.mul ((continuous_apply i).sub (continuous_apply j))

omit [DecidableEq V] in
/-- A coordinate of a unit-norm potential is at most `1`
in absolute value (one term of a sum of squares is at
most the total). -/
theorem abs_apply_le_one_of_sum_sq_eq_one {F : V → ℝ}
    (hF : ∑ i, F i ^ 2 = 1) (i : V) : |F i| ≤ 1 := by
  have h := Finset.single_le_sum (fun j _ => sq_nonneg (F j)) (Finset.mem_univ i)
  rw [hF] at h
  exact (sq_le_one_iff_abs_le_one (F i)).mp h

omit [Fintype V] [DecidableEq V] in
/-- A closed set of potentials whose coordinates are all
bounded by `1` is compact: it is a closed subset of the
compact pi-box `∏ i, [-1, 1]`. -/
theorem isCompact_of_mem_Icc_pi {s : Set (V → ℝ)}
    (hs : ∀ F ∈ s, ∀ i, |F i| ≤ 1) (hclosed : IsClosed s) : IsCompact s := by
  have hbox : IsCompact (Set.pi Set.univ (fun _ : V => Set.Icc (-1 : ℝ) 1)) :=
    isCompact_univ_pi fun _ => isCompact_Icc
  refine IsCompact.of_isClosed_subset hbox hclosed ?_
  intro F hF
  simp only [Set.mem_univ_pi, Set.mem_Icc]
  exact fun i => abs_le.mp (hs F hF i)

/-- The admissible set of the Fiedler variational
problem: mean-zero, unit-norm potentials. -/
def ductFiedlerAdmissible (V : Type*) [Fintype V] : Set (V → ℝ) :=
  {F | (∑ i, F i = 0) ∧ (∑ i, F i ^ 2 = 1)}

omit [DecidableEq V] in
theorem fiedlerAdmissible_isClosed : IsClosed (ductFiedlerAdmissible V) := by
  have h1 : Continuous fun F : V → ℝ => ∑ i, F i :=
    continuous_finsetSum _ fun i _ => continuous_apply i
  have h2 : Continuous fun F : V → ℝ => ∑ i, F i ^ 2 :=
    continuous_finsetSum _ fun i _ => (continuous_apply i).pow 2
  have hset : ductFiedlerAdmissible V
      = (fun F : V → ℝ => ∑ i, F i) ⁻¹' {0}
        ∩ (fun F : V → ℝ => ∑ i, F i ^ 2) ⁻¹' {1} := by
    ext F
    simp [ductFiedlerAdmissible]
  rw [hset]
  exact (isClosed_singleton.preimage h1).inter (isClosed_singleton.preimage h2)

/-- The admissible set is inhabited as soon as two
distinct vertices exist (the witness is
`BridgeLaplacian`'s normalized delta difference). -/
theorem fiedlerAdmissible_nonempty_of_exists_ne (w : V → V → ℝ) {a b : V}
    (hab : a ≠ b) : (ductFiedlerAdmissible V).Nonempty := by
  obtain ⟨x, F, hF0, hF1, -⟩ := fiedlerSet_nonempty_of_exists_ne w hab
  exact ⟨F, hF0, hF1⟩

omit [DecidableEq V] in
/-- The Laplacian is linear (scaling): `L (c • F) = c • L F`,
pointwise in function form. -/
theorem laplacianOp_smul_duct (w : V → V → ℝ) (c : ℝ) (F : V → ℝ) :
    laplacianOp w (fun k => c * F k) = fun i => c * laplacianOp w F i := by
  funext i
  show (∑ j, w i j * (c * F i - c * F j)) = c * ∑ j, w i j * (F i - F j)
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

omit [DecidableEq V] in
/-- The energy is quadratic: `energy (c • F) = c² · energy F`. -/
theorem energyForm_smul (w : V → V → ℝ) (c : ℝ) (F : V → ℝ) :
    energyForm w (fun k => c * F k) = c ^ 2 * energyForm w F := by
  have hpt : ∀ i, (c * F i) * laplacianOp w (fun k => c * F k) i
      = c ^ 2 * (F i * laplacianOp w F i) := by
    intro i
    have h := congrFun (laplacianOp_smul_duct w c F) i
    rw [h]
    ring
  show (∑ i, (c * F i) * laplacianOp w (fun k => c * F k) i)
      = c ^ 2 * ∑ i, F i * laplacianOp w F i
  rw [Finset.sum_congr rfl (fun i _ => hpt i), ← Finset.mul_sum]

/-- **Attainment.** When two distinct vertices exist, the
Fiedler infimum is attained: some mean-zero unit
potential has energy exactly `fiedler w`. This is the
attainment statement `BridgeLaplacian`'s header carries
as not-claimed; it is proved here by finite-dimensional
compactness of the admissible set. -/
theorem fiedler_attained (w : V → V → ℝ) (hw : ∀ i j, w i j = w j i)
    (hw0 : ∀ i j, 0 ≤ w i j) {a b : V} (hab : a ≠ b) :
    ∃ F : V → ℝ, (∑ i, F i = 0) ∧ (∑ i, F i ^ 2 = 1) ∧
      energyForm w F = fiedler w := by
  have hcomp : IsCompact (ductFiedlerAdmissible V) :=
    isCompact_of_mem_Icc_pi (fun _F hF i => abs_apply_le_one_of_sum_sq_eq_one hF.2 i)
      fiedlerAdmissible_isClosed
  have hne := fiedlerAdmissible_nonempty_of_exists_ne w hab
  obtain ⟨F, hF, hmin⟩ := hcomp.exists_isMinOn hne (energyForm_continuous w).continuousOn
  have hmem : energyForm w F ∈ fiedlerSet w := ⟨F, hF.1, hF.2, rfl⟩
  have hbdd : BddBelow (fiedlerSet w) :=
    ⟨0, fun y hy => by
      obtain ⟨G, -, -, rfl⟩ := hy
      exact energy_nonneg w hw hw0 G⟩
  refine ⟨F, hF.1, hF.2, le_antisymm ?_ ?_⟩
  · exact le_csInf ⟨energyForm w F, hmem⟩ fun y hy => by
      obtain ⟨G, hG0, hG1, rfl⟩ := hy
      exact (isMinOn_iff.mp hmin) G ⟨hG0, hG1⟩
  · rw [fiedler_def]
    exact csInf_le hbdd hmem

/-- **D1, layered form (the Fiedler floor).** For
symmetric nonneg weights with every off-diagonal weight
strictly positive, the Fiedler value is strictly
positive: the connected weighted section has a spectral
floor. The positivity hypothesis is the one K-DUCT-1
guards — without it the statement is false (a severed
section has a second zero mode). -/
theorem fiedler_pos (w : V → V → ℝ) (hw : ∀ i j, w i j = w j i)
    (hw0 : ∀ i j, 0 ≤ w i j) (hpos : ∀ i j, i ≠ j → 0 < w i j)
    {a b : V} (hab : a ≠ b) : 0 < fiedler w := by
  obtain ⟨F, hF0, hF1, hFE⟩ := fiedler_attained w hw hw0 hab
  have hnn := fiedler_nonneg w hw hw0
  refine lt_of_le_of_ne hnn ?_
  intro hf0
  have hE : (∑ i, F i * laplacianOp w F i) = 0 := by
    have h : energyForm w F = 0 := by rw [hFE, hf0]
    exact h
  have hconst := eq_const_of_energy_eq_zero w hw hw0 hpos F hE
  have hsum : (∑ i, F i) = (Fintype.card V : ℝ) * F a := by
    rw [Finset.sum_congr rfl (fun i _ => hconst i a), Finset.sum_const,
      Finset.card_univ, nsmul_eq_mul]
  rw [hF0] at hsum
  have hcard : (Fintype.card V : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Fintype.card_pos_iff.mpr ⟨a⟩).ne'
  have hFa : F a = 0 := by
    rcases mul_eq_zero.mp hsum.symm with h | h
    · exact absurd h hcard
    · exact h
  have hFz : ∀ i, F i = 0 := fun i => (hconst i a).trans hFa
  have hsq : (∑ i, F i ^ 2) = 0 :=
    Finset.sum_eq_zero fun i _ => by rw [hFz i]; norm_num
  rw [hsq] at hF1
  exact one_ne_zero hF1.symm

/-! ## §2. The Dirichlet path: the discrete duct's cutoff -/

/-- The start (left end) of the path on `Fin n`. -/
def pathStart (n : ℕ) (hn : 0 < n) : Fin n := ⟨0, hn⟩

/-- The end (right end) of the path on `Fin n`. -/
def pathEnd (n : ℕ) (hn : 0 < n) : Fin n := ⟨n - 1, by omega⟩

theorem pathStart_val (hn : 0 < n) : (pathStart n hn).val = 0 := rfl

theorem pathEnd_val (hn : 0 < n) : (pathEnd n hn).val = n - 1 := rfl

/-- Path-graph weights on `Fin n`: `1` between consecutive
vertices, `0` else. The transverse section of the finite
duct. -/
def pathWeight (n : ℕ) : Fin n → Fin n → ℝ :=
  fun i j => if i.val + 1 = j.val ∨ j.val + 1 = i.val then 1 else 0

theorem pathWeight_symm (n : ℕ) : ∀ i j, pathWeight n i j = pathWeight n j i := by
  intro i j
  by_cases h1 : i.val + 1 = j.val <;> by_cases h2 : j.val + 1 = i.val <;>
    simp [pathWeight, h1, h2]

theorem pathWeight_nonneg (n : ℕ) : ∀ i j, 0 ≤ pathWeight n i j := by
  intro i j
  by_cases h : i.val + 1 = j.val ∨ j.val + 1 = i.val <;>
    simp [pathWeight, h]

/-- Zero path-energy forces constancy along the path:
the energy vanishes only if every adjacent drop
vanishes, and adjacent steps chain from the start to
every vertex. -/
theorem path_eq_start_of_energy_eq_zero {n : ℕ} (hn : 0 < n) (F : Fin n → ℝ)
    (hE : energyForm (pathWeight n) F = 0) : ∀ i, F i = F (pathStart n hn) := by
  have hE' : (∑ i, F i * laplacianOp (pathWeight n) F i) = 0 := hE
  have hiff := (energy_eq_zero_iff (pathWeight n) (pathWeight_symm n)
    (pathWeight_nonneg n) F).mp hE'
  have step : ∀ k : ℕ, (hk : k + 1 < n) →
      F ⟨k, by omega⟩ = F ⟨k + 1, hk⟩ := by
    intro k hk
    have hw1 : pathWeight n ⟨k, by omega⟩ ⟨k + 1, hk⟩ = 1 :=
      ite_eq_left (Or.inl rfl)
    have h := hiff ⟨k, by omega⟩ ⟨k + 1, hk⟩
    rw [hw1, one_mul] at h
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp h)
  have claim : ∀ k : ℕ, (hk : k < n) → F ⟨k, hk⟩ = F (pathStart n hn) := by
    intro k
    induction k with
    | zero => intro _; rfl
    | succ k ih =>
      intro hk
      have h1 := step k hk
      have h2 := ih (by omega)
      exact h1.symm.trans h2
  intro i
  have hi : i = ⟨i.val, i.isLt⟩ := Fin.ext rfl
  rw [hi]
  exact claim i.val i.isLt

/-- **Trivial kernel, energy form.** A boundary-vanishing
potential of zero path-energy is zero. -/
theorem path_eq_zero_of_energy_eq_zero {n : ℕ} (hn : 0 < n) (F : Fin n → ℝ)
    (hE : energyForm (pathWeight n) F = 0) (hF : F (pathStart n hn) = 0) :
    F = 0 := by
  funext i
  show F i = 0
  rw [path_eq_start_of_energy_eq_zero hn F hE i, hF]

/-- **Trivial kernel.** The path Laplacian restricted to
boundary-vanishing potentials is injective: if
`L F = 0` and `F` vanishes at the start, then `F = 0`. -/
theorem path_eq_zero_of_laplacian_eq_zero {n : ℕ} (hn : 0 < n) (F : Fin n → ℝ)
    (hL : laplacianOp (pathWeight n) F = 0) (hF : F (pathStart n hn) = 0) :
    F = 0 := by
  apply path_eq_zero_of_energy_eq_zero hn F _ hF
  show (∑ i, F i * laplacianOp (pathWeight n) F i) = 0
  rw [hL]
  simp

/-- The Dirichlet admissible set: potentials vanishing
at both ends of the path, of unit norm. -/
def dirichletAdmissible (n : ℕ) (hn : 0 < n) : Set (Fin n → ℝ) :=
  {F | F (pathStart n hn) = 0 ∧ F (pathEnd n hn) = 0 ∧ (∑ i, F i ^ 2 = 1)}

theorem dirichletAdmissible_isClosed (n : ℕ) (hn : 0 < n) :
    IsClosed (dirichletAdmissible n hn) := by
  have h1 : Continuous fun F : Fin n → ℝ => F (pathStart n hn) :=
    continuous_apply _
  have h2 : Continuous fun F : Fin n → ℝ => F (pathEnd n hn) :=
    continuous_apply _
  have h3 : Continuous fun F : Fin n → ℝ => ∑ i, F i ^ 2 :=
    continuous_finsetSum _ fun i _ => (continuous_apply i).pow 2
  have hset : dirichletAdmissible n hn
      = (fun F : Fin n → ℝ => F (pathStart n hn)) ⁻¹' {0}
        ∩ ((fun F : Fin n → ℝ => F (pathEnd n hn)) ⁻¹' {0}
          ∩ (fun F : Fin n → ℝ => ∑ i, F i ^ 2) ⁻¹' {1}) := by
    ext F
    simp [dirichletAdmissible]
  rw [hset]
  exact (isClosed_singleton.preimage h1).inter
    ((isClosed_singleton.preimage h2).inter (isClosed_singleton.preimage h3))

theorem dirichletAdmissible_isCompact (n : ℕ) (hn : 0 < n) :
    IsCompact (dirichletAdmissible n hn) :=
  isCompact_of_mem_Icc_pi (fun _F hF i => abs_apply_le_one_of_sum_sq_eq_one hF.2.2 i)
    (dirichletAdmissible_isClosed n hn)

/-- For `n ≥ 3` the Dirichlet admissible set is
inhabited: the unit spike at vertex `1` vanishes at both
ends. (For `n ≤ 2` there is no interior vertex and the
set is empty — a zero-length duct carries no mode.) -/
theorem dirichletAdmissible_nonempty_of_three_le {n : ℕ} (hn : 0 < n)
    (hn3 : 3 ≤ n) : (dirichletAdmissible n hn).Nonempty := by
  classical
  have h1n : (1 : ℕ) < n := by omega
  refine ⟨fun i => if i = ⟨1, h1n⟩ then (1 : ℝ) else 0, ?_, ?_, ?_⟩
  · have hne : pathStart n hn ≠ ⟨1, h1n⟩ := by
      intro h
      have hv := congrArg Fin.val h
      rw [pathStart_val] at hv
      exact one_ne_zero hv.symm
    simp [hne]
  · have hne : pathEnd n hn ≠ ⟨1, h1n⟩ := by
      intro h
      have hv : (pathEnd n hn).val = 1 := congrArg Fin.val h
      rw [pathEnd_val] at hv
      omega
    simp [hne]
  · have hsum : ∀ i : Fin n, (if i = ⟨1, h1n⟩ then (1 : ℝ) else 0) ^ 2
        = if i = ⟨1, h1n⟩ then (1 : ℝ) else 0 := by
      intro i
      by_cases hi : i = ⟨1, h1n⟩ <;> simp [hi]
    rw [Finset.sum_congr rfl (fun i _ => hsum i), Finset.sum_ite_eq']
    simp

/-- **Attainment for the Dirichlet path.** For `n ≥ 3`
the cutoff is attained by an actual mode: a
boundary-vanishing unit potential whose path-energy is
minimal among all such potentials. -/
theorem dirichlet_minimizer_exists {n : ℕ} (hn : 0 < n) (hn3 : 3 ≤ n) :
    ∃ F : Fin n → ℝ, F ∈ dirichletAdmissible n hn ∧
      ∀ G ∈ dirichletAdmissible n hn,
        energyForm (pathWeight n) F ≤ energyForm (pathWeight n) G := by
  obtain ⟨F, hF, hmin⟩ := (dirichletAdmissible_isCompact n hn).exists_isMinOn
    (dirichletAdmissible_nonempty_of_three_le hn hn3)
    (energyForm_continuous _).continuousOn
  exact ⟨F, hF, fun G hG => (isMinOn_iff.mp hmin) G hG⟩

/-- **D1, Dirichlet form (existence of the cutoff).** For
every `n ≥ 1` there is a `λ > 0` bounding the Rayleigh
quotient of every boundary-vanishing potential. For
`n ≥ 3` the `λ` is the attained minimum energy; for
`n ≤ 2` the Dirichlet subspace is `{0}` and any `λ`
works vacuously — the case split is the proof's own,
stated here so the vacuity is on the record. -/
theorem path_dirichlet_floor_exists (n : ℕ) (hn : 0 < n) :
    ∃ lam : ℝ, 0 < lam ∧ ∀ F : Fin n → ℝ,
      F (pathStart n hn) = 0 → F (pathEnd n hn) = 0 →
      lam * (∑ i, F i ^ 2) ≤ energyForm (pathWeight n) F := by
  by_cases hn3 : 3 ≤ n
  · obtain ⟨F₀, hF₀, hmin⟩ := dirichlet_minimizer_exists hn hn3
    refine ⟨energyForm (pathWeight n) F₀, ?_, ?_⟩
    · have hnn : 0 ≤ energyForm (pathWeight n) F₀ :=
        energy_nonneg _ (pathWeight_symm n) (pathWeight_nonneg n) F₀
      refine lt_of_le_of_ne hnn ?_
      intro h0E
      have hE : energyForm (pathWeight n) F₀ = 0 := h0E.symm
      have hFz := path_eq_zero_of_energy_eq_zero hn F₀ hE hF₀.1
      have hsq : (∑ i, F₀ i ^ 2) = 0 := by
        rw [hFz]
        simp
      rw [hF₀.2.2] at hsq
      exact one_ne_zero hsq
    · intro F hFs hFe
      by_cases hFz : F = 0
      · subst hFz
        simp [energyForm, laplacianOp_apply]
      · have hSpos : 0 < ∑ i, F i ^ 2 := by
          apply Finset.sum_pos' (fun i _ => sq_nonneg (F i))
          obtain ⟨i, hi⟩ : ∃ i, F i ≠ 0 := by
            by_contra hcon
            push Not at hcon
            exact hFz (funext hcon)
          exact ⟨i, Finset.mem_univ i,
            (sq_nonneg (F i)).lt_of_ne (Ne.symm (pow_ne_zero 2 hi))⟩
        have hGmem : (fun i => (Real.sqrt (∑ i, F i ^ 2))⁻¹ * F i)
            ∈ dirichletAdmissible n hn := by
          refine ⟨?_, ?_, ?_⟩
          · show (Real.sqrt (∑ i, F i ^ 2))⁻¹ * F (pathStart n hn) = 0
            rw [hFs, mul_zero]
          · show (Real.sqrt (∑ i, F i ^ 2))⁻¹ * F (pathEnd n hn) = 0
            rw [hFe, mul_zero]
          · have hterm : ∀ i : Fin n,
                ((Real.sqrt (∑ i, F i ^ 2))⁻¹ * F i) ^ 2
                  = (Real.sqrt (∑ i, F i ^ 2))⁻¹ ^ 2 * (F i ^ 2) :=
              fun i => by ring
            rw [Finset.sum_congr rfl (fun i _ => hterm i), ← Finset.mul_sum,
              inv_pow, Real.sq_sqrt hSpos.le, inv_mul_cancel₀ (ne_of_gt hSpos)]
        have hle := hmin _ hGmem
        rw [energyForm_smul, inv_pow, Real.sq_sqrt hSpos.le] at hle
        have hfin : energyForm (pathWeight n) F₀ * (∑ i, F i ^ 2)
            ≤ energyForm (pathWeight n) F := by
          have h2 : energyForm (pathWeight n) F₀ * (∑ i, F i ^ 2)
              ≤ ((∑ i, F i ^ 2)⁻¹ * energyForm (pathWeight n) F)
                * (∑ i, F i ^ 2) :=
            mul_le_mul_of_nonneg_right hle hSpos.le
          rwa [mul_right_comm, inv_mul_cancel₀ (ne_of_gt hSpos), one_mul] at h2
        exact hfin
  · have hn2 : n ≤ 2 := by omega
    refine ⟨1, one_pos, ?_⟩
    intro F hFs hFe
    have hFz : F = 0 := by
      funext i
      have hi : i = pathStart n hn ∨ i = pathEnd n hn := by
        have hval : i.val = 0 ∨ i.val = n - 1 := by
          have hi2 := i.isLt
          omega
        rcases hval with h | h
        · exact Or.inl (Fin.ext (h.trans (pathStart_val hn).symm))
        · exact Or.inr (Fin.ext (h.trans (pathEnd_val hn).symm))
      rcases hi with rfl | rfl
      · exact hFs
      · exact hFe
    rw [hFz]
    simp [energyForm, laplacianOp_apply]

/-- The discrete duct's cutoff: the exhibited floor of
the Dirichlet path's Rayleigh quotient. -/
noncomputable def ductFloor (n : ℕ) (hn : 0 < n) : ℝ :=
  (path_dirichlet_floor_exists n hn).choose

/-- The cutoff is strictly positive. -/
theorem ductFloor_pos (n : ℕ) (hn : 0 < n) : 0 < ductFloor n hn :=
  (path_dirichlet_floor_exists n hn).choose_spec.1

/-- **D1 headline, Rayleigh form.** Every
boundary-vanishing potential on the path has energy at
least `ductFloor n hn` times its squared norm: the
transverse section has a spectral floor, and this is
it. -/
theorem ductFloor_le_energy (n : ℕ) (hn : 0 < n) (F : Fin n → ℝ)
    (hFs : F (pathStart n hn) = 0) (hFe : F (pathEnd n hn) = 0) :
    ductFloor n hn * (∑ i, F i ^ 2) ≤ energyForm (pathWeight n) F :=
  (path_dirichlet_floor_exists n hn).choose_spec.2 F hFs hFe

/-! ## §3. The product duct: the finite dispersion split -/

/-- A separated (tensor) function on a product grid:
`u` on the transverse section, `v` along the guide. -/
def tensorFun {A B : Type*} (u : A → ℝ) (v : B → ℝ) : A × B → ℝ :=
  fun p => u p.1 * v p.2

/-- The transverse part of the product Laplacian: the
section Laplacian acting on the first coordinate, the
second coordinate held fixed. -/
def lapFst {A B : Type*} [Fintype A] (wA : A → A → ℝ) (F : A × B → ℝ)
    (p : A × B) : ℝ :=
  ∑ j, wA p.1 j * (F p - F (j, p.2))

/-- The longitudinal part: the guide Laplacian acting on
the second coordinate, the first held fixed. -/
def lapSnd {A B : Type*} [Fintype B] (wB : B → B → ℝ) (F : A × B → ℝ)
    (p : A × B) : ℝ :=
  ∑ j, wB p.2 j * (F p - F (p.1, j))

/-- The product (duct) Laplacian `L = L_⊥ + L_∥`: the
`lapSum` pattern of `MirrorTwentyOneOrthogonalSpectral`,
generalized from its `Fin 21 × Fin 21` grid to a section
times a longitudinal factor, both seats being
`BridgeLaplacian` Laplacians acting coordinatewise. -/
def prodLap {A B : Type*} [Fintype A] [Fintype B] (wA : A → A → ℝ)
    (wB : B → B → ℝ) (F : A × B → ℝ) (p : A × B) : ℝ :=
  lapFst wA F p + lapSnd wB F p

theorem prodLap_apply {A B : Type*} [Fintype A] [Fintype B] (wA : A → A → ℝ)
    (wB : B → B → ℝ) (F : A × B → ℝ) (p : A × B) :
    prodLap wA wB F p = lapFst wA F p + lapSnd wB F p := rfl

/-- The transverse part acts on a separated function as
the section Laplacian on `u`, carried along by `v`. -/
theorem lapFst_tensor {A B : Type*} [Fintype A] (wA : A → A → ℝ)
    (u : A → ℝ) (v : B → ℝ) (p : A × B) :
    lapFst wA (tensorFun u v) p = v p.2 * laplacianOp wA u p.1 := by
  show (∑ j, wA p.1 j * (u p.1 * v p.2 - u j * v p.2))
      = v p.2 * ∑ j, wA p.1 j * (u p.1 - u j)
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The longitudinal part acts on a separated function
as the guide Laplacian on `v`, carried along by `u`. -/
theorem lapSnd_tensor {A B : Type*} [Fintype B] (wB : B → B → ℝ)
    (u : A → ℝ) (v : B → ℝ) (p : A × B) :
    lapSnd wB (tensorFun u v) p = u p.1 * laplacianOp wB v p.2 := by
  show (∑ j, wB p.2 j * (u p.1 * v p.2 - u p.1 * v j))
      = u p.1 * ∑ j, wB p.2 j * (v p.2 - v j)
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- **D2 headline (the finite dispersion split).** A
separated eigenfunction of the product Laplacian has
eigenvalue the *sum* of the two factor eigenvalues:
`L (u ⊗ v) = (λ + μ) · (u ⊗ v)`, pointwise, as an
algebraic identity on the finite model. The additive
split is what survives of `ω² = ω_c² + c²k_z²`; the
squares and constants do not, and are not claimed. -/
theorem prodLap_tensor_eig {A B : Type*} [Fintype A] [Fintype B]
    (wA : A → A → ℝ) (wB : B → B → ℝ) (u : A → ℝ) (v : B → ℝ)
    {lam mu : ℝ} (hu : ∀ i, laplacianOp wA u i = lam * u i)
    (hv : ∀ j, laplacianOp wB v j = mu * v j) (p : A × B) :
    prodLap wA wB (tensorFun u v) p = (lam + mu) * tensorFun u v p := by
  show lapFst wA (tensorFun u v) p + lapSnd wB (tensorFun u v) p
      = (lam + mu) * (u p.1 * v p.2)
  rw [lapFst_tensor, lapSnd_tensor, hu, hv]
  ring

/-- The energy form of the split: a separated mode's
total energy is `(λ + μ)` times its squared norm. -/
theorem prodLap_energy_tensor {A B : Type*} [Fintype A] [Fintype B]
    (wA : A → A → ℝ) (wB : B → B → ℝ) (u : A → ℝ) (v : B → ℝ)
    {lam mu : ℝ} (hu : ∀ i, laplacianOp wA u i = lam * u i)
    (hv : ∀ j, laplacianOp wB v j = mu * v j) :
    (∑ p, tensorFun u v p * prodLap wA wB (tensorFun u v) p)
      = (lam + mu) * ∑ p, (tensorFun u v p) ^ 2 := by
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p _
  rw [prodLap_tensor_eig wA wB u v hu hv p]
  ring

/-- **D2 floor corollary.** Take the transverse section
to be the Dirichlet path (D1) and the longitudinal seat
any symmetric nonneg weights. A separated mode with
nonzero boundary-vanishing transverse part `u` and
nonzero longitudinal part `v` has total eigenvalue at
least the duct cutoff: `ductFloor n hn ≤ λ + μ`. The
transverse floor is a floor under the *total* mode
energy — D1's cutoff doing exactly the work `ω_c` does
in the continuum guide. -/
theorem prodLap_eig_floor {B : Type*} [Fintype B] [DecidableEq B] {n : ℕ}
    (hn : 0 < n)
    (wB : B → B → ℝ) (hwB : ∀ i j, wB i j = wB j i)
    (hwB0 : ∀ i j, 0 ≤ wB i j)
    (u : Fin n → ℝ) (v : B → ℝ) {lam mu : ℝ}
    (hu : ∀ i, laplacianOp (pathWeight n) u i = lam * u i)
    (hv : ∀ j, laplacianOp wB v j = mu * v j)
    (hu0 : u (pathStart n hn) = 0) (hu1 : u (pathEnd n hn) = 0)
    (hu_ne : u ≠ 0) (hv_ne : v ≠ 0) :
    ductFloor n hn ≤ lam + mu := by
  have hSu : 0 < ∑ i, u i ^ 2 := by
    apply Finset.sum_pos' (fun i _ => sq_nonneg (u i))
    obtain ⟨i, hi⟩ : ∃ i, u i ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hu_ne (funext hcon)
    exact ⟨i, Finset.mem_univ i,
      (sq_nonneg (u i)).lt_of_ne (Ne.symm (pow_ne_zero 2 hi))⟩
  have hSv : 0 < ∑ j, v j ^ 2 := by
    apply Finset.sum_pos' (fun j _ => sq_nonneg (v j))
    obtain ⟨j, hj⟩ : ∃ j, v j ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hv_ne (funext hcon)
    exact ⟨j, Finset.mem_univ j,
      (sq_nonneg (v j)).lt_of_ne (Ne.symm (pow_ne_zero 2 hj))⟩
  have hlam : ductFloor n hn ≤ lam := by
    have h := ductFloor_le_energy n hn u hu0 hu1
    have hE : energyForm (pathWeight n) u = lam * ∑ i, u i ^ 2 := by
      show (∑ i, u i * laplacianOp (pathWeight n) u i)
          = lam * ∑ i, u i ^ 2
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [hu i, pow_two]
      ring
    rw [hE] at h
    exact le_of_mul_le_mul_right h hSu
  have hmu : 0 ≤ mu := by
    have hnn : 0 ≤ energyForm wB v := energy_nonneg wB hwB hwB0 v
    have hE : energyForm wB v = mu * ∑ j, v j ^ 2 := by
      show (∑ j, v j * laplacianOp wB v j) = mu * ∑ j, v j ^ 2
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [hv j, pow_two]
      ring
    rw [hE] at hnn
    by_contra hneg
    push Not at hneg
    have hlt := mul_neg_of_neg_of_pos hneg hSv
    linarith
  exact le_trans hlam (by linarith)

/-- **Zero longitudinal momentum.** If the longitudinal
factor sits in its zero mode (`L_∥ v = 0` — for instance
`v` constant, by `laplacianOp_const`), the transverse
eigenvalue alone already clears the duct floor:
`ductFloor n hn ≤ λ`. This is the finite shadow of
"even at `k_z = 0`, `ω ≥ ω_c`". -/
theorem prodLap_floor_at_zero_momentum {B : Type*} [Fintype B]
    [DecidableEq B] {n : ℕ}
    (hn : 0 < n) (wB : B → B → ℝ) (hwB : ∀ i j, wB i j = wB j i)
    (hwB0 : ∀ i j, 0 ≤ wB i j)
    (u : Fin n → ℝ) (v : B → ℝ) {lam : ℝ}
    (hu : ∀ i, laplacianOp (pathWeight n) u i = lam * u i)
    (hv0 : ∀ j, laplacianOp wB v j = 0)
    (hu0 : u (pathStart n hn) = 0) (hu1 : u (pathEnd n hn) = 0)
    (hu_ne : u ≠ 0) (hv_ne : v ≠ 0) :
    ductFloor n hn ≤ lam := by
  have h := prodLap_eig_floor hn wB hwB hwB0 u v hu
    (show ∀ j, laplacianOp wB v j = (0 : ℝ) * v j from
      fun j => by rw [hv0 j, zero_mul])
    hu0 hu1 hu_ne hv_ne
  simpa using h

end ThetLogos
